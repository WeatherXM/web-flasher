---
---

<div id="post-flash-section" class="hidden max-w-4xl mx-auto px-4 sm:px-6 mb-12">
  <div class="rounded-card border border-wxm-live/30 bg-wxm-storm/30 backdrop-blur-md p-6 sm:p-8 shadow-card">
    <div class="flex items-center space-x-3 mb-6">
      <div class="w-12 h-12 rounded-control bg-wxm-live/15 border border-wxm-live/30 flex items-center justify-center text-wxm-live">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold text-white">Firmware Switch Successful!</h3>
        <p class="text-xs text-wxm-mist" id="post-flash-subtitle">Your gateway has been safely flashed and rebooted.</p>
      </div>
    </div>

    <!-- WeatherXM Next Steps -->
    <div id="instructions-wxm" class="hidden space-y-4 pt-2 border-t border-wxm-cloud/15">
      <h4 class="text-sm font-semibold text-white">Next Steps for WeatherXM Gateway</h4>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-control bg-wxm-midnight/60 border border-wxm-cloud/10">
          <span class="w-5 h-5 rounded-full bg-wxm-beacon/15 text-wxm-zenith font-bold flex items-center justify-center text-xs mb-2">1</span>
          <strong class="text-white block mb-1">Check Status LEDs</strong>
          <p class="text-wxm-mist leading-relaxed">The gateway is booting into WeatherXM. The LEDs will initialize as it connects to local sensors.</p>
        </div>
        <div class="p-4 rounded-control bg-wxm-midnight/60 border border-wxm-cloud/10">
          <span class="w-5 h-5 rounded-full bg-wxm-beacon/15 text-wxm-zenith font-bold flex items-center justify-center text-xs mb-2">2</span>
          <strong class="text-white block mb-1">Setup WiFi if Needed</strong>
          <p class="text-wxm-mist leading-relaxed">If credentials are reset, connect to the <code class="text-wxm-zenith font-mono">WXM_WG1200_...</code> hotspot or use the mobile app.</p>
        </div>
        <div class="p-4 rounded-control bg-wxm-midnight/60 border border-wxm-cloud/10">
          <span class="w-5 h-5 rounded-full bg-wxm-beacon/15 text-wxm-zenith font-bold flex items-center justify-center text-xs mb-2">3</span>
          <strong class="text-white block mb-1">Station Rewards Active</strong>
          <p class="text-wxm-mist leading-relaxed">Your cloud identity was preserved. Telemetry will automatically attach to your station wallet.</p>
        </div>
      </div>
    </div>

    <!-- Meshtastic Next Steps -->
    <div id="instructions-mesh" class="hidden space-y-4 pt-2 border-t border-wxm-cloud/15">
      <h4 class="text-sm font-semibold text-white">Next Steps for Meshtastic Mesh Node</h4>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-control bg-wxm-midnight/60 border border-wxm-cloud/10">
          <span class="w-5 h-5 rounded-full bg-wxm-live/15 text-wxm-live font-bold flex items-center justify-center text-xs mb-2">1</span>
          <strong class="text-white block mb-1">Open Meshtastic Client</strong>
          <p class="text-wxm-mist leading-relaxed">
            Open the <a href="https://client.meshtastic.org" target="_blank" rel="noopener noreferrer" class="text-wxm-live underline underline-offset-2 hover:text-white">Meshtastic Web Client</a> or the iOS/Android app.
          </p>
        </div>
        <div class="p-4 rounded-control bg-wxm-midnight/60 border border-wxm-cloud/10">
          <span class="w-5 h-5 rounded-full bg-wxm-live/15 text-wxm-live font-bold flex items-center justify-center text-xs mb-2">2</span>
          <strong class="text-white block mb-1">Configure LoRa Region</strong>
          <p class="text-wxm-mist leading-relaxed">Select your regulatory frequency region (e.g. EU_868 or US_915) to enable the LoRa SX1262 radio.</p>
        </div>
        <div class="p-4 rounded-control bg-wxm-midnight/60 border border-wxm-cloud/10">
          <span class="w-5 h-5 rounded-full bg-wxm-live/15 text-wxm-live font-bold flex items-center justify-center text-xs mb-2">3</span>
          <strong class="text-white block mb-1">Switch Back Anytime</strong>
          <p class="text-wxm-mist leading-relaxed">Your WeatherXM credentials remain intact in protected flash. You can return to WeatherXM at any time.</p>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-5 border-t border-wxm-cloud/15 flex items-center justify-between">
      <span class="text-xs text-wxm-mist">Switch back or flash another device at any time.</span>
      <button
        id="btn-post-flash-done"
        type="button"
        class="px-5 py-2.5 rounded-control text-xs font-bold text-white bg-wxm-beacon hover:bg-wxm-horizon shadow-card shadow-wxm-beacon/25 transition-all cursor-pointer"
      >
        Done & Reconnect
      </button>
    </div>
  </div>
</div>
