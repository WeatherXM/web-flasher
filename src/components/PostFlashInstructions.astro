---
---

<div id="post-flash-section" class="hidden max-w-4xl mx-auto px-4 sm:px-6 mb-12">
  <div class="rounded-2xl border border-emerald-500/40 bg-gradient-to-b from-emerald-950/30 to-wxm-card/90 backdrop-blur-md p-6 sm:p-8 shadow-2xl">
    <div class="flex items-center space-x-3 mb-6">
      <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold text-white">Firmware Switch Successful!</h3>
        <p class="text-xs text-wxm-muted" id="post-flash-subtitle">Your gateway has been safely flashed and rebooted.</p>
      </div>
    </div>

    <!-- WeatherXM Next Steps -->
    <div id="instructions-wxm" class="hidden space-y-4 pt-2 border-t border-wxm-border/60">
      <h4 class="text-sm font-semibold text-white">Next Steps for WeatherXM Gateway</h4>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-wxm-surface/60 border border-wxm-border/60">
          <span class="w-5 h-5 rounded-full bg-sky-500/20 text-sky-400 font-bold flex items-center justify-center text-xs mb-2">1</span>
          <strong class="text-white block mb-1">Check Status LEDs</strong>
          <p class="text-wxm-muted leading-relaxed">The gateway is booting into WeatherXM. The LEDs will initialize as it connects to local sensors.</p>
        </div>
        <div class="p-4 rounded-xl bg-wxm-surface/60 border border-wxm-border/60">
          <span class="w-5 h-5 rounded-full bg-sky-500/20 text-sky-400 font-bold flex items-center justify-center text-xs mb-2">2</span>
          <strong class="text-white block mb-1">Setup WiFi if Needed</strong>
          <p class="text-wxm-muted leading-relaxed">If credentials are reset, connect to the <code class="text-sky-300">WXM_WG1200_...</code> hotspot or use the mobile app.</p>
        </div>
        <div class="p-4 rounded-xl bg-wxm-surface/60 border border-wxm-border/60">
          <span class="w-5 h-5 rounded-full bg-sky-500/20 text-sky-400 font-bold flex items-center justify-center text-xs mb-2">3</span>
          <strong class="text-white block mb-1">Station Rewards Active</strong>
          <p class="text-wxm-muted leading-relaxed">Your cloud identity was preserved. Telemetry will automatically attach to your station wallet.</p>
        </div>
      </div>
    </div>

    <!-- Meshtastic Next Steps -->
    <div id="instructions-mesh" class="hidden space-y-4 pt-2 border-t border-wxm-border/60">
      <h4 class="text-sm font-semibold text-white">Next Steps for Meshtastic Mesh Node</h4>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-wxm-surface/60 border border-wxm-border/60">
          <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-xs mb-2">1</span>
          <strong class="text-white block mb-1">Open Meshtastic Client</strong>
          <p class="text-wxm-muted leading-relaxed">
            Open the <a href="https://client.meshtastic.org" target="_blank" rel="noopener noreferrer" class="text-emerald-400 underline underline-offset-2">Meshtastic Web Client</a> or the iOS/Android app.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-wxm-surface/60 border border-wxm-border/60">
          <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-xs mb-2">2</span>
          <strong class="text-white block mb-1">Configure LoRa Region</strong>
          <p class="text-wxm-muted leading-relaxed">Select your regulatory frequency region (e.g. EU_868 or US_915) to enable the LoRa SX1262 radio.</p>
        </div>
        <div class="p-4 rounded-xl bg-wxm-surface/60 border border-wxm-border/60">
          <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-xs mb-2">3</span>
          <strong class="text-white block mb-1">Switch Back Anytime</strong>
          <p class="text-wxm-muted leading-relaxed">Your WeatherXM credentials remain intact in protected flash. You can return to WeatherXM at any time.</p>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-5 border-t border-wxm-border/60 flex items-center justify-between">
      <span class="text-xs text-wxm-muted">Switch back or flash another device at any time.</span>
      <button
        id="btn-post-flash-done"
        type="button"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-wxm-border transition-colors cursor-pointer"
      >
        Done & Reconnect
      </button>
    </div>
  </div>
</div>
