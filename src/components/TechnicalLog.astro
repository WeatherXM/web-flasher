---
---

<div id="technical-log-section" class="max-w-4xl mx-auto px-4 sm:px-6 mb-12">
  <div class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/25 backdrop-blur-md overflow-hidden shadow-card">
    <div class="px-5 py-3.5 bg-wxm-midnight/60 border-b border-wxm-cloud/15 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <!-- Left: Collapsible Console Title & Event Counter -->
      <div class="flex items-center space-x-3 select-none">
        <button
          id="btn-toggle-log"
          type="button"
          class="flex items-center space-x-2 text-xs font-bold text-white hover:text-wxm-zenith transition-colors cursor-pointer"
        >
          <svg id="log-chevron" class="w-4 h-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          <span>Technical Serial & Flasher Console</span>
        </button>
        <!-- Non-button text counter (Plain information) -->
        <span class="text-xs text-wxm-mist font-mono select-none">
          (<span id="log-count">0</span> events)
        </span>
      </div>

      <!-- Right: Explicit Action Buttons -->
      <div class="flex items-center space-x-2.5">
        <button
          id="btn-clear-log"
          type="button"
          class="px-3 py-1.5 rounded-control text-xs font-bold text-wxm-mist hover:text-white border border-wxm-cloud/20 bg-wxm-storm/40 hover:bg-wxm-storm/80 transition-all flex items-center space-x-1.5 cursor-pointer active:scale-95 shadow-sm"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          <span>Clear Log</span>
        </button>

        <button
          id="btn-download-log"
          type="button"
          class="px-3.5 py-1.5 rounded-control text-xs font-bold text-white border border-wxm-beacon/40 bg-wxm-beacon hover:bg-wxm-horizon transition-all flex items-center space-x-1.5 cursor-pointer shadow-card active:scale-95"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>Download Log (.txt)</span>
        </button>
      </div>
    </div>

    <div id="log-content-wrapper" class="p-4 bg-wxm-abyss/90">
      <div
        id="log-terminal"
        class="h-48 overflow-y-auto font-mono text-[11px] leading-relaxed text-wxm-cloud space-y-1 selection:bg-wxm-beacon selection:text-white"
      >
        <div class="text-wxm-mist">[Ready] WG1200 Web Flasher initialized. Waiting for device connection...</div>
      </div>
    </div>
  </div>
</div>
