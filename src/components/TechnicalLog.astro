---
---

<div id="technical-log-section" class="max-w-4xl mx-auto px-4 sm:px-6 mb-12">
  <div class="rounded-2xl border border-wxm-border bg-wxm-card/90 overflow-hidden shadow-xl">
    <div class="px-5 py-3.5 bg-wxm-surface/60 border-b border-wxm-border flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <button
          id="btn-toggle-log"
          type="button"
          class="flex items-center space-x-2 text-xs font-semibold text-slate-300 hover:text-white transition-colors cursor-pointer"
        >
          <svg id="log-chevron" class="w-4 h-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          <span>Technical Flasher Log</span>
        </button>
        <span id="log-count" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-wxm-muted font-mono">0 events</span>
      </div>

      <div class="flex items-center space-x-2">
        <button
          id="btn-clear-log"
          type="button"
          class="px-2.5 py-1 rounded text-[11px] text-wxm-muted hover:text-white transition-colors cursor-pointer"
        >
          Clear
        </button>
        <button
          id="btn-download-log"
          type="button"
          class="px-3 py-1 rounded-lg text-xs font-medium text-wxm-muted hover:text-white border border-wxm-border bg-wxm-card hover:bg-wxm-surface transition-colors flex items-center space-x-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>Download Log (.txt)</span>
        </button>
      </div>
    </div>

    <div id="log-content-wrapper" class="p-4 bg-black/75">
      <div
        id="log-terminal"
        class="h-48 overflow-y-auto font-mono text-[11px] leading-relaxed text-slate-300 space-y-1 selection:bg-wxm-primary selection:text-white"
      >
        <div class="text-wxm-muted">[Ready] WG1200 Web Flasher initialized. Waiting for device connection...</div>
      </div>
    </div>
  </div>
</div>
