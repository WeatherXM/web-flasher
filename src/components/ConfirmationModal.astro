---
---

<div id="modal-confirm" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
  <div class="max-w-lg w-full rounded-2xl border border-wxm-border bg-wxm-card p-6 shadow-2xl relative text-left">
    <div class="flex items-center space-x-3 mb-4">
      <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white">Confirm Firmware Switch</h3>
        <p class="text-xs text-wxm-muted">Verify target details before flashing</p>
      </div>
    </div>

    <div class="space-y-3 py-3 border-y border-wxm-border/60 text-xs">
      <div class="flex justify-between items-center py-1">
        <span class="text-wxm-muted">Target Firmware:</span>
        <span id="modal-fw-name" class="font-bold text-white">WeatherXM Gateway</span>
      </div>
      <div class="flex justify-between items-center py-1">
        <span class="text-wxm-muted">Firmware Version:</span>
        <span id="modal-fw-version" class="font-mono text-white">v0.8.25</span>
      </div>
      <div class="flex justify-between items-center py-1">
        <span class="text-wxm-muted">Destination Flash Slot:</span>
        <span id="modal-target-slot" class="font-mono text-wxm-accent">OTA_0 (0x420000)</span>
      </div>
      <div class="flex justify-between items-center py-1">
        <span class="text-wxm-muted">Factory Partition (0x020000):</span>
        <span class="font-semibold text-emerald-400">Untouched & Safe</span>
      </div>
      <div class="flex justify-between items-center py-1">
        <span class="text-wxm-muted">WeatherXM Device Credentials:</span>
        <span class="font-semibold text-emerald-400">Protected & Untouched</span>
      </div>
    </div>

    <p class="text-xs text-wxm-muted mt-4 leading-relaxed">
      Please keep your WG1200 connected and do not unplug the USB cable during the flashing process.
    </p>

    <div class="mt-6 flex space-x-3 justify-end">
      <button
        id="btn-modal-cancel"
        type="button"
        class="px-4 py-2.5 rounded-xl text-xs font-semibold text-wxm-muted hover:text-white border border-wxm-border bg-wxm-surface hover:bg-slate-700 transition-colors cursor-pointer"
      >
        Cancel
      </button>
      <button
        id="btn-modal-confirm"
        type="button"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-sky-600 hover:bg-sky-500 shadow-lg shadow-sky-600/30 border border-sky-400/40 transition-all cursor-pointer"
      >
        Confirm and Flash
      </button>
    </div>
  </div>
</div>
