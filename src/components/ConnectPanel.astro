---
---

<div id="panel-connect" class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
  <div class="text-center space-y-4">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-wxm-accent/10 border border-wxm-accent/20 text-wxm-accent text-xs font-medium">
      <span class="w-2 h-2 rounded-full bg-wxm-accent animate-pulse"></span>
      <span>Official WeatherXM Gateway Switcher</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Switch your WG1200 Gateway Between <br class="hidden sm:inline"/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-wxm-accent via-sky-400 to-blue-500">
        WeatherXM
      </span>
      and
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">
        Meshtastic
      </span>
    </h1>

    <p class="text-base text-wxm-muted max-w-2xl mx-auto leading-relaxed">
      Easily swap firmware over USB in your browser. Your WeatherXM hardware identity, cloud credentials, and factory recovery slot remain completely intact. You can switch back at any time.
    </p>

    <!-- Connect Action -->
    <div class="pt-6 pb-2 flex flex-col items-center space-y-3">
      <button
        id="btn-connect"
        type="button"
        class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-white bg-gradient-to-r from-wxm-primary to-sky-600 hover:from-sky-500 hover:to-wxm-primary shadow-lg shadow-wxm-primary/25 border border-sky-400/30 transition-all flex items-center justify-center space-x-3 text-base active:scale-98 cursor-pointer"
      >
        <svg class="w-5 h-5 text-wxm-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Connect WG1200 Gateway</span>
      </button>

      <button
        id="btn-connect-manual"
        type="button"
        class="text-xs text-wxm-muted hover:text-white underline underline-offset-4 decoration-wxm-border hover:decoration-white transition-colors cursor-pointer"
      >
        Device not shown? Select serial port manually
      </button>
    </div>

    <!-- Requirements & Safety Badges -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-8 text-left">
      <div class="p-4 rounded-xl border border-wxm-border/60 bg-wxm-card/40 backdrop-blur-sm">
        <div class="w-8 h-8 rounded-lg bg-wxm-accent/10 border border-wxm-accent/20 flex items-center justify-center text-wxm-accent mb-3">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white">Credentials Protected</h4>
        <p class="text-xs text-wxm-muted mt-1 leading-relaxed">
          Factory keys and certificates in <code class="text-wxm-accent font-mono text-[11px]">esp_secure_cert</code> are never erased or modified.
        </p>
      </div>

      <div class="p-4 rounded-xl border border-wxm-border/60 bg-wxm-card/40 backdrop-blur-sm">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-3">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white">Hardware Guarded</h4>
        <p class="text-xs text-wxm-muted mt-1 leading-relaxed">
          Full chip erase is disabled. Strict partition address bounds enforce writing solely to OTA app slots.
        </p>
      </div>

      <div class="p-4 rounded-xl border border-wxm-border/60 bg-wxm-card/40 backdrop-blur-sm">
        <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-3">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white">Switch Back Anytime</h4>
        <p class="text-xs text-wxm-muted mt-1 leading-relaxed">
          Dual-partition architecture allows you to easily switch between WeatherXM and Meshtastic whenever you like.
        </p>
      </div>
    </div>
  </div>
</div>
