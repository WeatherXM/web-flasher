---
// Compact sticky utility bar: safety guarantees + shortcuts to secondary tools.
---

<div id="safety-protections-section" class="sticky bottom-0 z-30 border-t border-wxm-cloud/15 bg-wxm-abyss/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-2.5 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-wxm-cloud select-none">
    <span class="flex items-center gap-1.5" title="Factory keys and certificates in esp_secure_cert are never erased or modified.">
      <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      Credentials protected
    </span>
    <span class="flex items-center gap-1.5" title="Full chip erase is disabled. Strict partition address bounds enforce writing solely to OTA app slots.">
      <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      Hardware-guarded writes
    </span>
    <span class="flex items-center gap-1.5" title="Dual-partition architecture lets you switch between WeatherXM and Meshtastic whenever you like.">
      <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      Switch back anytime
    </span>

    <div class="ml-auto flex items-center gap-2">
      <button id="btn-bar-tools" type="button" class="px-3 py-1.5 rounded-control font-bold text-wxm-cloud hover:text-white border border-wxm-cloud/20 bg-wxm-storm/40 hover:bg-wxm-storm/80 transition-all flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 16v-2m6-6h2M4 12h2m10.24-4.24l1.42-1.42M6.34 17.66l1.42-1.42m0-8.48L6.34 6.34m11.32 11.32l-1.42-1.42M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Advanced tools
      </button>
      <button id="btn-bar-console" type="button" class="px-3 py-1.5 rounded-control font-bold text-wxm-cloud hover:text-white border border-wxm-cloud/20 bg-wxm-storm/40 hover:bg-wxm-storm/80 transition-all flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 17l6-5-6-5M12 19h8"/></svg>
        Console · <span id="bar-log-count" class="font-mono">0</span>
      </button>
    </div>
  </div>
</div>
