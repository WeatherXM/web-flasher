---
---

<header class="border-b border-wxm-cloud/15 bg-wxm-midnight/90 backdrop-blur-md sticky top-0 z-40">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between">
    <div class="flex items-center space-x-3.5">
      <a href="/" class="flex items-center space-x-3 group">
        <img
          src="/brand/logo-dark-horizontal.svg"
          alt="WeatherXM"
          class="h-7 w-auto object-contain transition-opacity group-hover:opacity-90"
        />
        <div class="h-4 w-px bg-wxm-cloud/20 hidden sm:block"></div>
        <span class="hidden sm:inline-block px-2.5 py-0.5 text-xs font-semibold rounded-full bg-wxm-beacon/15 border border-wxm-beacon/30 text-wxm-zenith">
          WG1200 Switcher
        </span>
      </a>
    </div>

    <div class="flex items-center space-x-3">
      <span class="hidden md:inline-block text-xs font-medium text-wxm-mist tracking-wide">
        Weather on Demand
      </span>
      <div class="h-4 w-px bg-wxm-cloud/20 hidden md:block"></div>
      <a
        href="https://github.com/WeatherXM/web-flasher"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center space-x-2 text-xs font-semibold text-wxm-cloud hover:text-white px-3 py-1.5 rounded-control border border-wxm-cloud/20 bg-wxm-midnight/60 hover:bg-wxm-storm transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>
      <a
        href="https://docs.weatherxm.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-semibold text-wxm-cloud hover:text-white px-3 py-1.5 rounded-control border border-wxm-cloud/20 bg-wxm-midnight/60 hover:bg-wxm-storm transition-colors"
      >
        Docs
      </a>
    </div>
  </div>
</header>
