---
import GithubReposButton from './GithubReposButton.astro';

interface Props {
  device?: 'wg1200' | 'ws1300' | 'ws2001' | 'h1-h2';
}

const { device } = Astro.props;
const deviceLabel =
  device === 'wg1200' ? 'WG1200 gateway' : device === 'ws1300' ? 'WS1300 station' : (device === 'ws2001' || device === 'h1-h2') ? 'WS2001 station' : null;
---

<header class="border-b border-wxm-cloud/15 bg-wxm-midnight/90 backdrop-blur-md sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3 flex items-center justify-between gap-3">
    <div class="flex items-center space-x-3.5 shrink-0">
      <a
        href="https://weatherxm.com"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center group"
        title="WeatherXM website"
      >
        <img
          src="/brand/logo-dark-horizontal.svg"
          alt="WeatherXM"
          class="h-7 w-auto object-contain transition-opacity group-hover:opacity-90"
        />
      </a>
      <div class="h-4 w-px bg-wxm-cloud/20 hidden sm:block"></div>
      <nav class="flex items-center gap-2 text-xs font-medium min-w-0" aria-label="Breadcrumb">
        <a href="/" class="hidden sm:inline-block text-wxm-cloud hover:text-white transition-colors">Firmware flasher</a>
        {deviceLabel && (
          <>
            <span class="hidden sm:inline text-wxm-cloud/40" aria-hidden="true">/</span>
            <span class="hidden sm:inline text-white font-semibold whitespace-nowrap">{deviceLabel}</span>
          </>
        )}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      {device && (
        <a
          href="/"
          class="text-xs font-semibold text-wxm-mist hover:text-white border border-wxm-cloud/20 hover:border-wxm-cloud/40 rounded-control px-2.5 py-1.5 transition-colors whitespace-nowrap"
        >
          Switch device
        </a>
      )}
      <GithubReposButton class="hidden md:inline-flex" />
    </div>
  </div>
</header>
