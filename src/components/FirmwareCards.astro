---
import manifest from '../../public/firmware/manifest.json';

const wxmEntries = Object.entries(manifest.firmwares)
  .filter(([key, fw]) => (fw as any).category === 'weatherxm' || key.startsWith('weatherxm'));
const meshEntries = Object.entries(manifest.firmwares)
  .filter(([key, fw]) => (fw as any).category === 'meshtastic' || key.startsWith('meshtastic'))
  .sort(([a], [b]) => (a === 'meshtastic' ? -1 : b === 'meshtastic' ? 1 : 0));

const defaultWxm = wxmEntries[0]?.[1] as any;
const defaultMesh = (meshEntries.find(([k]) => k === 'meshtastic')?.[1] ?? meshEntries[0]?.[1]) as any;
---

<div id="firmware-selection-section" class="hidden max-w-7xl mx-auto px-4 sm:px-8 mb-6">
  <div class="mb-4 flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <span class="text-[11px] font-bold text-wxm-zenith uppercase tracking-wider">Step 2</span>
    <h2 class="text-xl font-bold text-white tracking-tight">Choose how this WG1200 should operate</h2>
    <p class="text-xs text-wxm-mist">Protected credentials and the factory recovery image remain untouched in either mode.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- WeatherXM Card -->
    <div id="card-wxm" class="rounded-card border-2 border-wxm-cloud/15 bg-wxm-storm/30 p-5 flex flex-col justify-between transition-all shadow-card backdrop-blur-md relative overflow-hidden">
      <div>
        <div class="flex items-start justify-between gap-3 mb-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 flex-shrink-0 rounded-control bg-wxm-beacon/15 border border-wxm-beacon/30 flex items-center justify-center text-wxm-zenith">
            <svg class="w-5 h-5" viewBox="0 0 32 32" fill="none">
              <path d="M7 16L12 9L17 16L22 9L27 16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 23L12 16L17 23L22 16L27 23" stroke="#2F74DC" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
            <div class="min-w-0">
              <h3 class="text-lg font-bold text-white">WeatherXM Tri-Protocol Gateway</h3>
              <div class="flex items-center space-x-2 mt-0.5">
                <span class="text-xs text-wxm-mist font-mono font-medium" id="wxm-version">v{defaultWxm?.version ?? '0.8.27'}</span>
                <span class="text-[11px] px-2 py-0.5 rounded bg-wxm-beacon/10 text-wxm-zenith border border-wxm-beacon/25 font-medium">WXM + Meshtastic + MeshCore</span>
              </div>
            </div>
          </div>
          <span id="badge-wxm-status" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-wxm-midnight/70 border border-wxm-cloud/20 text-wxm-mist">
            Available
          </span>
        </div>


        <p class="text-xs text-wxm-mist leading-relaxed">
          Keeps the WG1200 as a full WeatherXM weather gateway while also publishing its paired station to open LoRa mesh ecosystems. Mesh publishing is configurable and does not replace WeatherXM operation.
        </p>

        <div class="mt-3 pt-3 border-t border-wxm-cloud/10">
          <span class="text-[10px] font-bold text-wxm-mist uppercase tracking-wider block mb-2 select-none">Included Capabilities</span>
          <ul class="space-y-1 text-xs text-wxm-cloud select-none">
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>WeatherXM cloud, app, rewards and OTA remain active</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Turns the paired weather station into Meshtastic-compatible sensor telemetry</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Publishes the same weather observations as MeshCore sensor-node telemetry</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Local REST / Home Assistant access stays available</span>
            </li>
          </ul>
        </div>

        <div class="mt-3 pt-3 border-t border-wxm-cloud/10">
          <label for="select-wxm-build" class="block text-[11px] font-bold text-wxm-cloud uppercase tracking-wider mb-1.5 select-none">
            Choose Firmware Build / Version:
          </label>
          <div class="relative">
            <select
              id="select-wxm-build"
              class="w-full bg-wxm-midnight border border-wxm-cloud/30 rounded-control py-2 px-3 text-xs text-white font-mono focus:outline-none focus:border-wxm-beacon focus:ring-1 focus:ring-wxm-beacon transition-colors appearance-none cursor-pointer pr-8 shadow-inner"
            >
              {wxmEntries.map(([key, fw]: [string, any], idx: number) => {
                const mb = (fw.bytes / (1024 * 1024)).toFixed(2);
                return (
                  <option value={key} selected={idx === 0}>
                    {fw.label ?? `${fw.name} v${fw.version}`} ({mb} MB)
                  </option>
                );
              })}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-wxm-mist">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between text-[11px] text-wxm-mist mt-1.5 px-0.5">
            <span id="wxm-selected-file" class="font-mono text-[10px] text-wxm-cloud truncate max-w-[200px]">{defaultWxm ? (defaultWxm.file.split('/').pop() ?? defaultWxm.file) : ''}</span>
            <span id="wxm-selected-size" class="font-mono text-[10px] text-wxm-beacon font-semibold">{defaultWxm ? (defaultWxm.bytes / (1024 * 1024)).toFixed(2) + ' MB' : ''}</span>
          </div>
        </div>
      </div>

      <!-- Action Button Area -->
      <div class="mt-4 pt-4 border-t border-wxm-cloud/15">
        <button
          id="btn-flash-weatherxm"
          type="button"
          class="w-full py-3 px-4 rounded-control font-extrabold btn-primary-beacon flex items-center justify-center space-x-2 text-sm cursor-pointer active:scale-98 select-none"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span id="btn-flash-wxm-label">Flash WeatherXM Tri-Protocol</span>
        </button>
      </div>
    </div>

    <!-- Meshtastic Card -->
    <div id="card-mesh" class="rounded-card border-2 border-wxm-cloud/15 bg-wxm-storm/30 p-5 flex flex-col justify-between transition-all shadow-card backdrop-blur-md relative overflow-hidden">
      <div>
        <div class="flex items-start justify-between gap-3 mb-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 flex-shrink-0 rounded-control bg-wxm-live/15 border border-wxm-live/30 flex items-center justify-center text-wxm-live">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
            </svg>
          </div>
            <div class="min-w-0">
              <h3 class="text-lg font-bold text-white">Full Meshtastic Node</h3>
              <div class="flex items-center space-x-2 mt-0.5">
                <span class="text-xs text-wxm-mist font-mono font-medium" id="mesh-version">v2.8.1-wxm</span>
                <span class="text-[11px] px-2 py-0.5 rounded bg-wxm-live/10 text-wxm-live border border-wxm-live/25 font-medium">Gateway becomes Meshtastic</span>
              </div>
            </div>
          </div>
          <span id="badge-mesh-status" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-wxm-midnight/70 border border-wxm-cloud/20 text-wxm-mist">
            Available
          </span>
        </div>


        <p class="text-xs text-wxm-mist leading-relaxed">
          Turns the WG1200 itself into a native Meshtastic device. WeatherXM station/cloud services pause while this mode is active; your WeatherXM identity stays protected so you can switch back at any time.
        </p>

        <div class="mt-3 pt-3 border-t border-wxm-cloud/10">
          <span class="text-[10px] font-bold text-wxm-mist uppercase tracking-wider block mb-2 select-none">Included Capabilities</span>
          <ul class="space-y-1 text-xs text-wxm-cloud select-none">
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Native Meshtastic client, routing and messaging operation</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Uses the WG1200 SX1262 radio and TFT display directly</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Works with standard Meshtastic web, iOS and Android clients</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>WeatherXM credentials and factory recovery image remain protected</span>
            </li>
          </ul>
        </div>

        <!-- Meshtastic Hardware Variant Dropdown -->
        <div class="mt-3 pt-3 border-t border-wxm-cloud/10">
          <label for="select-mesh-build" class="block text-[11px] font-bold text-emerald-400 uppercase tracking-wider mb-1.5 select-none">
            Choose Hardware Variant / Build:
          </label>
          <div class="relative">
            <select
              id="select-mesh-build"
              class="w-full bg-wxm-midnight border border-emerald-500/40 rounded-control py-2 px-3 text-xs text-white font-mono focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-colors appearance-none cursor-pointer pr-8 shadow-inner"
            >
              {meshEntries.map(([key, fw]: [string, any], idx: number) => {
                const mb = (fw.bytes / (1024 * 1024)).toFixed(2);
                const isSelected = key === 'meshtastic' || (idx === 0 && !meshEntries.some(([k]) => k === 'meshtastic'));
                return (
                  <option value={key} selected={isSelected}>
                    {fw.label ?? `${fw.name} v${fw.version}`} ({mb} MB)
                  </option>
                );
              })}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-emerald-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between text-[11px] text-wxm-mist mt-1.5 px-0.5">
            <span id="mesh-selected-file" class="font-mono text-[10px] text-wxm-cloud truncate max-w-[200px]">{defaultMesh ? (defaultMesh.file.split('/').pop() ?? defaultMesh.file) : ''}</span>
            <span id="mesh-selected-size" class="font-mono text-[10px] text-emerald-400 font-semibold">{defaultMesh ? (defaultMesh.bytes / (1024 * 1024)).toFixed(2) + ' MB' : ''}</span>
          </div>

          <!-- Variant Navigation Description -->
          <div class="mt-2.5 p-2.5 rounded bg-wxm-midnight/70 border border-emerald-500/20 text-[11px] leading-relaxed">
            <div id="mesh-variant-tip-tft" class="text-wxm-mist">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 align-middle"></span>
              <strong class="text-white">TFT Version (Default):</strong> Features interactive <span class="text-emerald-300 font-semibold">touchscreen navigation</span> directly on the display.
              <span class="block text-wxm-mist/75 mt-0.5 text-[10px]">In the Standard version, navigation is operated from the single green button.</span>
            </div>
            <div id="mesh-variant-tip-standard" class="hidden text-wxm-mist">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400 mr-1.5 align-middle"></span>
              <strong class="text-white">Standard Version:</strong> Navigation is operated from the <span class="text-amber-300 font-semibold">single green button</span>.
              <span class="block text-wxm-mist/75 mt-0.5 text-[10px]">The TFT version enables direct touchscreen navigation on the display.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Button Area -->
      <div class="mt-4 pt-4 border-t border-wxm-cloud/15">
        <button
          id="btn-flash-meshtastic"
          type="button"
          class="w-full py-3 px-4 rounded-control font-black btn-primary-green flex items-center justify-center space-x-2 text-sm cursor-pointer active:scale-98 select-none"
        >
          <svg class="w-4 h-4 text-wxm-abyss" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
          </svg>
          <span id="btn-flash-mesh-label">Flash Full Meshtastic</span>
        </button>
      </div>
    </div>
  </div>
</div>
