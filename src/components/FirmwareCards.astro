---
---

<div id="firmware-selection-section" class="hidden max-w-4xl mx-auto px-4 sm:px-6 mb-12">
  <div class="mb-6">
    <h2 class="text-xl font-bold text-white tracking-tight">Select Target Firmware</h2>
    <p class="text-xs text-wxm-muted mt-1">Choose the operating system you would like to run on your WG1200 gateway.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- WeatherXM Card -->
    <div id="card-wxm" class="rounded-2xl border border-wxm-border bg-wxm-card/90 p-6 flex flex-col justify-between hover:border-sky-500/50 transition-all shadow-xl relative overflow-hidden group">
      <div class="absolute top-0 right-0 w-32 h-32 bg-sky-500/5 rounded-full blur-2xl group-hover:bg-sky-500/10 transition-colors pointer-events-none"></div>

      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400">
            <svg class="w-6 h-6" viewBox="0 0 32 32" fill="none">
              <path d="M7 16L12 9L17 16L22 9L27 16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 23L12 16L17 23L22 16L27 23" stroke="#38BDF8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span id="badge-wxm-status" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-800 border border-slate-700 text-slate-300">
            Available
          </span>
        </div>

        <h3 class="text-lg font-bold text-white">WeatherXM Gateway</h3>
        <div class="flex items-center space-x-2 mt-1 mb-3">
          <span class="text-xs text-wxm-muted font-mono" id="wxm-version">v0.8.25</span>
          <span class="text-[11px] px-2 py-0.5 rounded bg-sky-950/80 text-sky-400 border border-sky-800/50">Official Release</span>
        </div>

        <p class="text-xs text-wxm-muted leading-relaxed">
          The factory weather station gateway software. Connects your local weather sensors via Sub-GHz RF/BLE and relays environmental data securely to the WeatherXM Decentralized Network.
        </p>

        <ul class="mt-4 space-y-2 text-xs text-slate-300">
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>WeatherXM Mobile App integration</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Cryptographic station rewards claiming</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Automatic OTA updates over WiFi</span>
          </li>
        </ul>
      </div>

      <div class="mt-6 pt-5 border-t border-wxm-border/60">
        <button
          id="btn-flash-weatherxm"
          type="button"
          class="w-full py-3 px-4 rounded-xl font-semibold text-white bg-sky-600 hover:bg-sky-500 shadow-lg shadow-sky-600/20 border border-sky-400/30 transition-all flex items-center justify-center space-x-2 text-sm cursor-pointer"
        >
          <span>Switch to WeatherXM</span>
        </button>
      </div>
    </div>

    <!-- Meshtastic Card -->
    <div id="card-mesh" class="rounded-2xl border border-wxm-border bg-wxm-card/90 p-6 flex flex-col justify-between hover:border-emerald-500/50 transition-all shadow-xl relative overflow-hidden group">
      <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/5 rounded-full blur-2xl group-hover:bg-emerald-500/10 transition-colors pointer-events-none"></div>

      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
            </svg>
          </div>
          <span id="badge-mesh-status" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-800 border border-slate-700 text-slate-300">
            Available
          </span>
        </div>

        <h3 class="text-lg font-bold text-white">Meshtastic Mesh Node</h3>
        <div class="flex items-center space-x-2 mt-1 mb-3">
          <span class="text-xs text-wxm-muted font-mono" id="mesh-version">v2.8.1-wxm</span>
          <span class="text-[11px] px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/50">Full LoRa Mesh</span>
        </div>

        <p class="text-xs text-wxm-muted leading-relaxed">
          Transforms your WeatherXM gateway into an off-grid, encrypted LoRa mesh communication router and repeater. Fully compatible with all Meshtastic apps.
        </p>

        <ul class="mt-4 space-y-2 text-xs text-slate-300">
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Decentralized off-grid messaging & routing</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Native SX1262 LoRa radio driver for WG1200</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Preserves WeatherXM credentials for easy return</span>
          </li>
        </ul>
      </div>

      <div class="mt-6 pt-5 border-t border-wxm-border/60">
        <button
          id="btn-flash-meshtastic"
          type="button"
          class="w-full py-3 px-4 rounded-xl font-semibold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg shadow-emerald-600/20 border border-emerald-400/30 transition-all flex items-center justify-center space-x-2 text-sm cursor-pointer"
        >
          <span>Switch to Meshtastic</span>
        </button>
      </div>
    </div>
  </div>
</div>
