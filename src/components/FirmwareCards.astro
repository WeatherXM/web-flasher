---
---

<div id="firmware-selection-section" class="hidden max-w-4xl mx-auto px-4 sm:px-6 mb-12">
  <div class="mb-6 space-y-1">
    <span class="text-[11px] font-bold text-wxm-zenith uppercase tracking-wider block">Step 2 — Choose Operating System</span>
    <h2 class="text-xl font-bold text-white tracking-tight">Select Target Firmware</h2>
    <p class="text-xs text-wxm-mist">Click the button below the firmware you wish to flash. Your gateway's credentials and factory recovery slot remain 100% safe.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- WeatherXM Card -->
    <div id="card-wxm" class="rounded-card border-2 border-wxm-cloud/15 bg-wxm-storm/30 p-6 flex flex-col justify-between transition-all shadow-card backdrop-blur-md relative overflow-hidden">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-control bg-wxm-beacon/15 border border-wxm-beacon/30 flex items-center justify-center text-wxm-zenith">
            <svg class="w-6 h-6" viewBox="0 0 32 32" fill="none">
              <path d="M7 16L12 9L17 16L22 9L27 16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 23L12 16L17 23L22 16L27 23" stroke="#2F74DC" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span id="badge-wxm-status" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-wxm-midnight/70 border border-wxm-cloud/20 text-wxm-mist">
            Available
          </span>
        </div>

        <h3 class="text-lg font-bold text-white">WeatherXM Gateway</h3>
        <div class="flex items-center space-x-2 mt-1 mb-3">
          <span class="text-xs text-wxm-mist font-mono font-medium" id="wxm-version">v0.8.25</span>
          <span class="text-[11px] px-2 py-0.5 rounded bg-wxm-beacon/10 text-wxm-zenith border border-wxm-beacon/25 font-medium">Official Release</span>
        </div>

        <p class="text-xs text-wxm-mist leading-relaxed">
          The factory weather station gateway software. Connects your local weather sensors via Sub-GHz RF/BLE and relays environmental data securely to the WeatherXM Decentralized Network.
        </p>

        <div class="mt-4 pt-3 border-t border-wxm-cloud/10">
          <span class="text-[10px] font-bold text-wxm-mist uppercase tracking-wider block mb-2 select-none">Included Capabilities</span>
          <ul class="space-y-2 text-xs text-wxm-cloud select-none">
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>WeatherXM Mobile App integration</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Cryptographic station rewards claiming</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Automatic OTA updates over WiFi</span>
            </li>
          </ul>
        </div>

        <div class="mt-4 pt-3 border-t border-wxm-cloud/10">
          <label for="select-wxm-build" class="block text-[11px] font-bold text-wxm-cloud uppercase tracking-wider mb-1.5 select-none">
            Choose Firmware Build / Version:
          </label>
          <div class="relative">
            <select
              id="select-wxm-build"
              class="w-full bg-wxm-midnight border border-wxm-cloud/30 rounded-control py-2.5 px-3 text-xs text-white font-mono focus:outline-none focus:border-wxm-beacon focus:ring-1 focus:ring-wxm-beacon transition-colors appearance-none cursor-pointer pr-8 shadow-inner"
            >
              <option value="weatherxm" selected>WeatherXM v0.8.25 (Latest Release)</option>
              <option value="weatherxm_0_8_23">WeatherXM v0.8.23 (Stable Release)</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-wxm-mist">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between text-[11px] text-wxm-mist mt-1.5 px-0.5">
            <span id="wxm-selected-file" class="font-mono text-[10px] text-wxm-cloud truncate max-w-[200px]">wg1200-0.8.25-signed.bin</span>
            <span id="wxm-selected-size" class="font-mono text-[10px] text-wxm-beacon font-semibold">3.54 MB</span>
          </div>
        </div>
      </div>

      <!-- Action Button Area -->
      <div class="mt-6 pt-5 border-t border-wxm-cloud/15">
        <button
          id="btn-flash-weatherxm"
          type="button"
          class="w-full py-3.5 px-4 rounded-control font-extrabold btn-primary-beacon flex items-center justify-center space-x-2 text-sm cursor-pointer active:scale-98 select-none"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span id="btn-flash-wxm-label">Flash WeatherXM</span>
        </button>
      </div>
    </div>

    <!-- Meshtastic Card -->
    <div id="card-mesh" class="rounded-card border-2 border-wxm-cloud/15 bg-wxm-storm/30 p-6 flex flex-col justify-between transition-all shadow-card backdrop-blur-md relative overflow-hidden">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-control bg-wxm-live/15 border border-wxm-live/30 flex items-center justify-center text-wxm-live">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
            </svg>
          </div>
          <span id="badge-mesh-status" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-wxm-midnight/70 border border-wxm-cloud/20 text-wxm-mist">
            Available
          </span>
        </div>

        <h3 class="text-lg font-bold text-white">Meshtastic Mesh Node</h3>
        <div class="flex items-center space-x-2 mt-1 mb-3">
          <span class="text-xs text-wxm-mist font-mono font-medium" id="mesh-version">v2.8.1-wxm</span>
          <span class="text-[11px] px-2 py-0.5 rounded bg-wxm-live/10 text-wxm-live border border-wxm-live/25 font-medium">Full LoRa Mesh</span>
        </div>

        <p class="text-xs text-wxm-mist leading-relaxed">
          Transforms your WeatherXM gateway into an off-grid, encrypted LoRa mesh communication router and repeater. Fully compatible with all Meshtastic apps.
        </p>

        <div class="mt-4 pt-3 border-t border-wxm-cloud/10">
          <span class="text-[10px] font-bold text-wxm-mist uppercase tracking-wider block mb-2 select-none">Included Capabilities</span>
          <ul class="space-y-2 text-xs text-wxm-cloud select-none">
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Decentralized off-grid messaging & routing</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Native SX1262 LoRa radio driver for WG1200</span>
            </li>
            <li class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-wxm-live flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Preserves WeatherXM credentials for easy return</span>
            </li>
          </ul>
        </div>

        <!-- Meshtastic Hardware Variant Dropdown -->
        <div class="mt-4 pt-3 border-t border-wxm-cloud/10">
          <label for="select-mesh-build" class="block text-[11px] font-bold text-emerald-400 uppercase tracking-wider mb-1.5 select-none">
            Choose Hardware Variant / Build:
          </label>
          <div class="relative">
            <select
              id="select-mesh-build"
              class="w-full bg-wxm-midnight border border-emerald-500/40 rounded-control py-2.5 px-3 text-xs text-white font-mono focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-colors appearance-none cursor-pointer pr-8 shadow-inner"
            >
              <option value="meshtastic" selected>v2.8.1 — TFT Display [Color Screen] (3.80 MB)</option>
              <option value="meshtastic_standard">v2.8.1 — Standard / No Screen (2.39 MB)</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-emerald-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between text-[11px] text-wxm-mist mt-1.5 px-0.5">
            <span id="mesh-selected-file" class="font-mono text-[10px] text-wxm-cloud truncate max-w-[200px]">firmware-weatherxm-wg1200-tft-2.8.1-signed.bin</span>
            <span id="mesh-selected-size" class="font-mono text-[10px] text-emerald-400 font-semibold">3.80 MB</span>
          </div>
        </div>
      </div>

      <!-- Action Button Area -->
      <div class="mt-6 pt-5 border-t border-wxm-cloud/15">
        <button
          id="btn-flash-meshtastic"
          type="button"
          class="w-full py-3.5 px-4 rounded-control font-black btn-primary-green flex items-center justify-center space-x-2 text-sm cursor-pointer active:scale-98 select-none"
        >
          <svg class="w-4 h-4 text-wxm-abyss" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
          </svg>
          <span id="btn-flash-mesh-label">Flash Meshtastic</span>
        </button>
      </div>
    </div>
  </div>
</div>
