---
---

<div id="flash-progress-section" class="hidden max-w-7xl mx-auto px-4 sm:px-8 mb-6">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-stretch">
    <!-- Left: progress & pipeline -->
    <div class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/30 backdrop-blur-md p-6 shadow-card">
      <div class="flex items-center space-x-3 mb-5">
        <div id="progress-spinner" class="w-8 h-8 rounded-full border-2 border-wxm-beacon border-t-transparent animate-spin"></div>
        <div>
          <h3 id="progress-title" class="text-lg font-bold text-white">Installing Firmware…</h3>
          <p id="progress-status" class="text-xs text-wxm-mist">Preparing flashing pipeline</p>
        </div>
      </div>

      <!-- Main Progress Bar -->
      <div class="relative w-full h-3 rounded-full bg-wxm-midnight/80 border border-wxm-cloud/10 overflow-hidden mb-6">
        <div
          id="progress-bar-fill"
          class="h-full bg-wxm-beacon transition-all duration-300 rounded-full"
          style="width: 0%"
        ></div>
      </div>

      <!-- Staged Checklist -->
      <div class="flex flex-col gap-3.5 text-sm" id="progress-steps">
        <div id="step-download" class="flex items-center space-x-2 text-wxm-mist">
          <span class="w-5 h-5 rounded-full border border-wxm-cloud/20 flex items-center justify-center text-[10px]">1</span>
          <span>Download & cryptographic verification</span>
        </div>
        <div id="step-snapshot" class="flex items-center space-x-2 text-wxm-mist">
          <span class="w-5 h-5 rounded-full border border-wxm-cloud/20 flex items-center justify-center text-[10px]">2</span>
          <span>Protected credentials snapshot</span>
        </div>
        <div id="step-write" class="flex items-center space-x-2 text-wxm-mist">
          <span class="w-5 h-5 rounded-full border border-wxm-cloud/20 flex items-center justify-center text-[10px]">3</span>
          <span>Guarded flash write (safe bounds)</span>
        </div>
        <div id="step-md5" class="flex items-center space-x-2 text-wxm-mist">
          <span class="w-5 h-5 rounded-full border border-wxm-cloud/20 flex items-center justify-center text-[10px]">4</span>
          <span>Hardware flash MD5 check</span>
        </div>
        <div id="step-otadata" class="flex items-center space-x-2 text-wxm-mist">
          <span class="w-5 h-5 rounded-full border border-wxm-cloud/20 flex items-center justify-center text-[10px]">5</span>
          <span>Boot pointer & CRC32 update</span>
        </div>
        <div id="step-reboot" class="flex items-center space-x-2 text-wxm-mist">
          <span class="w-5 h-5 rounded-full border border-wxm-cloud/20 flex items-center justify-center text-[10px]">6</span>
          <span>RTS reset & boot sequence capture</span>
        </div>
      </div>

      <!-- Error Alert Box -->
      <div id="flash-error-box" class="hidden mt-6 p-4 rounded-card border border-wxm-error/40 bg-wxm-error/10 text-xs text-white">
        <div class="flex items-start space-x-3">
          <svg class="w-5 h-5 text-wxm-error flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <h4 class="font-bold text-white text-sm" id="flash-error-title">Flashing Encountered an Issue</h4>
            <p class="text-wxm-cloud mt-1 leading-relaxed" id="flash-error-msg">An unexpected error occurred.</p>
            <div class="mt-3 p-3 rounded-control bg-wxm-abyss/80 border border-wxm-cloud/10 text-[11px] text-wxm-mist">
              <strong class="text-white">Recovery Advice:</strong> Your device credentials and factory partition remain protected. Disconnect USB, reconnect the gateway, and try again. If the device does not respond, hold the BOOT button while plugging in the USB cable to force ROM bootloader mode.
            </div>
            <button
              id="btn-retry-flash"
              type="button"
              class="mt-4 px-4 py-2 rounded-control bg-wxm-storm/60 hover:bg-wxm-storm border border-wxm-cloud/20 text-white font-semibold transition-colors cursor-pointer"
            >
              Return to Device Overview
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: the Technical Console is moved here while flashing (see index.astro placeConsole) -->
    <div id="progress-log-slot" class="min-w-0"></div>
  </div>
</div>
