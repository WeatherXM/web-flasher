---
import SiteLayout from '../layouts/SiteLayout.astro';
import BleBrowserNotice from '../components/ws1300/BleBrowserNotice.astro';
import { Code } from 'astro:components';
import { WS2001_UPLINK_DECODER } from '../lib/ble/ws2001UplinkDecoder';
---

<SiteLayout
  title="WS2001 (H2) Open LoRaWAN Configurator — WeatherXM"
  description="Configure your WeatherXM WS2001 (H2) weather station for The Things Network, ChirpStack, or generic LoRaWAN networks over Bluetooth."
  device="ws2001"
>
  <BleBrowserNotice />

  <section class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-start">
      <!-- Left: introduction & documentation -->
      <div class="space-y-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-wxm-storm/40 border border-wxm-cloud/20 text-xs font-semibold text-white">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Your own LoRaWAN network · TTN · ChirpStack
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight text-balance">
          Configure WS2001 (H2) for Any LoRaWAN Network
        </h1>
        <p class="text-sm sm:text-base text-wxm-mist leading-relaxed">
          The H2 starts on the <strong>WeatherXM network</strong>. You can move it to The Things Network (TTN), ChirpStack or any other LoRaWAN network server.
          It is the same hardware as the SenseCAP S2120, with <strong>WeatherXM's own firmware</strong>: its frame carries more weather data,
          such as <strong>wind gust</strong> and <strong>rain total</strong>, in a compact 24-byte payload.
          The station keeps its WeatherXM settings, so it can potentially return to the WeatherXM network later.
        </p>

        <p class="text-sm">
          <a href="https://weatherxm.com/stations/" class="inline-flex items-center gap-1.5 font-semibold text-wxm-zenith hover:text-white underline underline-offset-4 decoration-wxm-cloud/30">
            Explore WeatherXM stations <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>

      <!-- Right: Action card -->
      <div class="space-y-4">
        <!-- 1. Connect view -->
        <div id="view-connect" class="p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-beacon/40 backdrop-blur-md shadow-card space-y-5">
          <div class="flex items-center gap-5">
            <img
              src="/h2.webp"
              alt="WeatherXM WS2001 (H2) Weather Station"
              width="388"
              height="228"
              class="w-24 sm:w-28 h-auto flex-shrink-0 drop-shadow-[0_8px_16px_rgba(0,0,0,0.5)]"
            />
            <div class="space-y-1">
              <span class="text-[11px] font-extrabold text-wxm-zenith uppercase tracking-widest block">Bluetooth connection</span>
              <h2 class="text-lg font-bold">Connect to WS2001 (H2)</h2>
              <p class="text-xs text-wxm-mist">Make sure your station is powered on and within Bluetooth range.</p>
            </div>
          </div>

          <button
            id="btn-connect"
            type="button"
            class="w-full py-4 px-6 rounded-control text-base btn-primary-beacon flex items-center justify-center gap-3 cursor-pointer disabled:opacity-50 disabled:cursor-wait focus:outline-none focus-visible:ring-2 focus-visible:ring-wxm-zenith"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7l10 10-5 5V2l5 5L7 17" />
            </svg>
            <span id="btn-connect-label">Connect to WS2001 (H2)</span>
          </button>
          <button
            id="btn-cancel-connect"
            type="button"
            class="hidden w-full py-2 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-red-400/60 cursor-pointer"
          >
            Cancel and disconnect
          </button>
          <label class="flex items-start gap-2.5 text-xs text-wxm-mist leading-relaxed cursor-pointer select-none">
            <input id="chk-auto-update" type="checkbox" class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-beacon focus:ring-0 cursor-pointer" />
            <span><strong class="text-white">Auto-update to latest firmware immediately on connect</strong> (leave unchecked to choose whether to flash a specific version, switch to Open LoRaWAN, or switch to Helium after connecting).</span>
          </label>
          <p id="connect-error" class="hidden text-xs text-red-300 leading-relaxed" role="alert"></p>
        </div>

        <!-- 2. Device info card (unhides when connected) -->
        <div id="view-device" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-cloud/20 backdrop-blur-md shadow-card space-y-5">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <span class="text-[11px] font-extrabold text-wxm-live uppercase tracking-widest flex items-center gap-1.5">
                <span class="indicator-dot-green"></span> Connected
              </span>
              <h2 id="dev-name" class="text-lg font-bold mt-0.5 truncate">WeatherXM WS2001 (H2)</h2>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button
                id="btn-refresh"
                type="button"
                title="Refresh station configuration and status"
                class="px-2.5 py-1 rounded-control text-xs font-semibold text-wxm-mist hover:text-white border border-wxm-cloud/20 hover:bg-wxm-storm/40 transition-colors flex items-center gap-1.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <svg id="icon-refresh" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span id="label-refresh">Refresh</span>
              </button>
              <button
                id="btn-disconnect"
                type="button"
                title="Disconnect from station"
                class="px-2.5 py-1 rounded-control text-xs font-semibold text-wxm-mist hover:text-red-300 hover:border-red-500/40 hover:bg-red-500/10 border border-wxm-cloud/20 transition-colors flex items-center gap-1.5 cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span>Disconnect</span>
              </button>
            </div>
          </div>

          <!-- DevEUI full-width banner (guarantees full 23-char DevEUI is always visible) -->
          <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">DevEUI</span>
              <span id="stat-deveui" class="font-mono font-bold text-white text-xs sm:text-sm tracking-wide select-all block mt-0.5">–</span>
            </div>
            <button
              id="btn-copy-deveui"
              type="button"
              title="Copy DevEUI"
              class="px-2.5 py-1 rounded-control text-xs font-semibold text-wxm-mist hover:text-white border border-wxm-cloud/20 hover:bg-wxm-storm/40 transition-colors flex items-center gap-1.5 shrink-0 cursor-pointer"
            >
              <svg id="icon-copy-deveui" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="label-copy-deveui">Copy</span>
            </button>
          </div>

          <!-- Device stats grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10 col-span-2 sm:col-span-2">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Network</span>
              <span id="stat-mode" class="font-semibold text-white mt-0.5 block truncate text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Region / Band</span>
              <span id="stat-band" class="font-semibold text-white mt-0.5 block truncate text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Firmware</span>
              <span id="stat-ver" class="font-mono text-white mt-0.5 block text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Battery</span>
              <span id="stat-bat" class="font-semibold text-white mt-0.5 block text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Interval</span>
              <span id="stat-interval" class="font-semibold text-white mt-0.5 block text-[11px]">–</span>
            </div>
          </div>

          <!-- Action Chooser: Ask user what they want to do upon connection -->
          <div id="action-chooser" class="border-t border-wxm-cloud/15 pt-4 space-y-2.5">
            <span class="text-[11px] font-extrabold text-wxm-zenith uppercase tracking-widest block">What would you like to do?</span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" role="tablist" aria-label="Station actions">
              <button
                id="btn-mode-flash"
                type="button"
                role="tab"
                aria-selected="false"
                class="p-3 rounded-control text-left border border-wxm-cloud/20 bg-wxm-abyss/60 hover:bg-wxm-storm/50 transition-all cursor-pointer space-y-1"
              >
                <span class="text-xs font-bold text-white flex items-center justify-between gap-1">
                  <span>1. Flash Firmware</span>
                  <span id="badge-mode-flash" class="hidden px-1.5 py-0.5 rounded bg-amber-500/20 border border-amber-400/40 text-[10px] text-amber-300 font-mono">Update</span>
                </span>
                <span class="text-[11px] text-wxm-mist block leading-snug">Flash V4.9 or a specific release only</span>
              </button>

              <button
                id="btn-mode-open"
                type="button"
                role="tab"
                aria-selected="true"
                class="p-3 rounded-control text-left border border-wxm-zenith bg-wxm-storm/60 hover:bg-wxm-storm/50 transition-all cursor-pointer space-y-1"
              >
                <span class="text-xs font-bold text-white flex items-center justify-between gap-1">
                  <span>2. Open LoRaWAN</span>
                  <span id="badge-mode-open" class="hidden px-1.5 py-0.5 rounded bg-emerald-500/20 border border-emerald-400/40 text-[10px] text-emerald-300 font-mono">Saved</span>
                </span>
                <span class="text-[11px] text-wxm-mist block leading-snug">Switch to TTN, ChirpStack or custom LNS</span>
              </button>

              <button
                id="btn-mode-helium"
                type="button"
                role="tab"
                aria-selected="false"
                class="p-3 rounded-control text-left border border-wxm-cloud/20 bg-wxm-abyss/60 hover:bg-wxm-storm/50 transition-all cursor-pointer space-y-1"
              >
                <span class="text-xs font-bold text-white flex items-center justify-between gap-1">
                  <span>3. Helium (WXM)</span>
                  <span id="badge-mode-helium" class="hidden px-1.5 py-0.5 rounded bg-emerald-500/20 border border-emerald-400/40 text-[10px] text-emerald-300 font-mono">Saved</span>
                </span>
                <span class="text-[11px] text-wxm-mist block leading-snug">Return to WeatherXM Helium (0 config)</span>
              </button>
            </div>
          </div>

          <!-- PANEL 1: Flash a specific firmware version -->
          <div id="panel-flash" class="hidden border-t border-wxm-cloud/15 pt-4 space-y-4">
            <div id="group-fwupdate" class="p-4 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/15 space-y-3">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Firmware Flash</span>
                  <span id="fw-update-text" class="font-semibold text-white block mt-0.5 text-xs">Checking for updates...</span>
                </div>
              </div>

              <div>
                <label for="cfg-fw-version" class="block text-xs font-semibold text-wxm-cloud mb-1">Target Firmware Version</label>
                <select
                  id="cfg-fw-version"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-zenith"
                >
                  <option value="4.9">V4.9 (Latest — Dual Network Profiles + Flash Preservation)</option>
                  <option value="custom">Custom signed package (-ble-dfu.zip)...</option>
                </select>
              </div>

              <div id="group-fw-custom" class="hidden space-y-1">
                <label for="cfg-fw-file" class="block text-xs font-semibold text-wxm-cloud">Select Signed DFU Package (<span class="font-mono">-ble-dfu.zip</span>)</label>
                <input
                  id="cfg-fw-file"
                  type="file"
                  accept=".zip,application/zip"
                  class="w-full text-xs text-wxm-mist file:mr-3 file:py-1.5 file:px-3 file:rounded-control file:border file:border-wxm-cloud/20 file:text-xs file:font-semibold file:bg-wxm-storm/60 file:text-white hover:file:bg-wxm-storm cursor-pointer"
                />
              </div>

              <p id="fw-version-note" class="text-[11px] text-wxm-mist leading-relaxed">
                Flashing V4.9 onto a V4.3 field station preserves all existing settings and automatically backs up its factory Helium (WeatherXM) keys into Profile 0 so you can switch between Open LoRaWAN and Helium at any time.
              </p>

              <button
                id="btn-fw-update"
                type="button"
                disabled
                class="w-full py-3 px-4 rounded-control text-xs font-bold text-white btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
              >
                Flash Selected Firmware
              </button>
            </div>
          </div>

          <!-- PANEL 3: Switch to Helium / WeatherXM (0 configuration needed) -->
          <div id="panel-helium" class="hidden border-t border-wxm-cloud/15 pt-4 space-y-4">
            <div id="group-switchback" class="p-4 rounded-control bg-emerald-500/10 border border-emerald-500/30 text-xs space-y-3 leading-relaxed">
              <div class="space-y-1">
                <p id="helium-status-title" class="font-bold text-emerald-300 text-sm">Switch to Helium (WeatherXM Network)</p>
                <p id="helium-status-desc" class="text-emerald-200/80">
                  Restores the station's factory Helium (WeatherXM) credentials and 3-minute upload interval from Profile 0 (<span class="font-mono">AT+NETPROFILE=0</span>). No keys or parameters need to be entered, and any custom Open LoRaWAN profile remains saved in Profile 1.
                </p>
              </div>
              <button
                id="btn-switchback"
                type="button"
                class="w-full py-3 rounded-control text-xs font-bold text-white bg-emerald-700/80 border border-emerald-500/40 hover:bg-emerald-600 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
              >
                Switch to Helium (WeatherXM) — No Configuration Needed
              </button>
            </div>
          </div>

          <!-- PANEL 2: Switch to Open LoRaWAN -->
          <div id="panel-open" class="border-t border-wxm-cloud/15 pt-4 space-y-4">
            <!-- Banner when station runs < V4.5 (e.g. V4.3) -->
            <div id="open-old-fw-banner" class="hidden p-3.5 rounded-control bg-amber-500/15 border border-amber-400/40 text-xs space-y-2.5 leading-relaxed">
              <p class="font-bold text-amber-300">Station is running <span id="open-old-fw-ver" class="font-mono">V4.3</span> (no dual profiles yet)</p>
              <p class="text-amber-200/90">
                Flash <strong>V4.9</strong> first so the station automatically backs up its factory Helium (WeatherXM) credentials into Profile 0 before switching to Open LoRaWAN.
              </p>
              <button
                id="btn-goto-flash-v49"
                type="button"
                class="w-full py-2.5 px-4 rounded-control text-xs font-bold text-white bg-amber-600 hover:bg-amber-500 cursor-pointer"
              >
                Step 1: Flash V4.9 Firmware First
              </button>
            </div>

            <!-- 1-Click Switch to Stored Open LoRaWAN Profile (shown when customStored is true) -->
            <div id="group-switch-open-stored" class="hidden p-3.5 rounded-control bg-emerald-500/10 border border-emerald-500/30 text-xs space-y-2.5 leading-relaxed">
              <p class="font-bold text-emerald-300">Stored Open LoRaWAN Profile Available (No Configuration Needed)</p>
              <p class="text-emerald-200/80">
                This station already has Open LoRaWAN credentials saved in Profile 1. You can reactivate Profile 1 in one click without re-entering any keys, or update the credentials in the form below.
              </p>
              <button
                id="btn-switch-open-stored"
                type="button"
                class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-emerald-700/80 border border-emerald-500/40 hover:bg-emerald-600 cursor-pointer disabled:opacity-50 disabled:cursor-wait"
              >
                Switch to Stored Open LoRaWAN Profile Now
              </button>
            </div>

            <div>
              <h3 class="text-sm font-bold text-white">Open LoRaWAN Network Configuration</h3>
              <p class="text-xs text-wxm-mist mt-1">
                LoRaWAN 1.0.4 · OTAA · Class A · WeatherXM 24-byte frame on FPort 99
              </p>
            </div>

            <div class="space-y-3">
              <!-- Frequency Region -->
              <div>
                <label for="cfg-band" class="block text-xs font-semibold text-wxm-cloud mb-1">Frequency Region</label>
                <select
                  id="cfg-band"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-zenith"
                >
                  <option value="5">EU868 (Europe 868 MHz)</option>
                  <option value="8">US915 (North America 915 MHz)</option>
                  <option value="1">AU915 (Australia 915 MHz)</option>
                  <option value="15">AS923-1 (Asia 923 MHz)</option>
                  <option value="7">IN865 (India 865 MHz)</option>
                  <option value="6">KR920 (Korea 920 MHz)</option>
                  <option value="9">RU864 (Russia 864 MHz)</option>
                </select>
              </div>

              <!-- Sub-band (US915 / AU915) -->
              <div id="group-subband">
                <label for="cfg-subband" class="block text-xs font-semibold text-wxm-cloud mb-1">
                  Channel Sub-Band (FSB)
                </label>
                <select
                  id="cfg-subband"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-zenith"
                >
                  <option value="1">Sub-Band 2 (Channels 8-15) — Standard for TTN & ChirpStack</option>
                  <option value="0">Sub-Band 1 (Channels 0-7)</option>
                  <option value="2">Sub-Band 3 (Channels 16-23)</option>
                  <option value="3">Sub-Band 4 (Channels 24-31)</option>
                  <option value="4">Sub-Band 5 (Channels 32-39)</option>
                  <option value="5">Sub-Band 6 (Channels 40-47)</option>
                  <option value="6">Sub-Band 7 (Channels 48-55)</option>
                  <option value="7">Sub-Band 8 (Channels 56-63)</option>
                </select>
              </div>

              <!-- JoinEUI / AppEUI -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="cfg-joineui" class="text-xs font-semibold text-wxm-cloud">JoinEUI / AppEUI (16 hex chars)</label>
                  <span class="text-[10px] text-wxm-mist font-mono">MSB</span>
                </div>
                <input
                  id="cfg-joineui"
                  type="text"
                  maxlength="23"
                  placeholder="0000000000000000"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-zenith uppercase"
                />
              </div>

              <!-- AppKey -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="cfg-appkey" class="text-xs font-semibold text-wxm-cloud">AppKey (32 hex chars)</label>
                  <button
                    id="btn-gen-appkey"
                    type="button"
                    class="text-[11px] font-semibold text-wxm-zenith hover:text-white cursor-pointer"
                  >
                    Generate Random
                  </button>
                </div>
                <input
                  id="cfg-appkey"
                  type="text"
                  maxlength="47"
                  placeholder="00112233445566778899AABBCCDDEEFF"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-zenith uppercase"
                />
              </div>

              <!-- Upload Interval -->
              <div>
                <label for="cfg-interval" class="block text-xs font-semibold text-wxm-cloud mb-1">Upload Interval</label>
                <select
                  id="cfg-interval"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-zenith"
                >
                  <option value="5" selected>5 minutes (recommended, within TTN fair use)</option>
                  <option value="10">10 minutes (weak signal, SF9 or slower on TTN)</option>
                  <option value="15">15 minutes (battery saving)</option>
                  <option value="30">30 minutes</option>
                  <option value="3">3 minutes (private ChirpStack only)</option>
                </select>
                <p class="text-[11px] text-wxm-mist mt-1 leading-relaxed">
                  TTN allows 30 s of airtime per device per day. A 24-byte uplink takes about 82 ms at SF7, so 3-minute uplinks exceed it; use 5 minutes or more.
                </p>
              </div>

              <!-- GNSS location scans (V4.7+) -->
              <label class="flex items-start gap-2.5 text-xs text-wxm-mist leading-relaxed cursor-pointer select-none">
                <input id="cfg-gnss" type="checkbox" class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-beacon focus:ring-0 cursor-pointer" />
                <span>
                  <strong class="text-white">Send GNSS location scans</strong> (optional, off by default). About once a day the station sends a raw satellite scan
                  (<span class="font-mono">0xF3</span> frame on FPort 99) that you can store and resolve later with a GNSS solver.
                  It needs the network time from your server (LoRaWAN DeviceTimeReq, answered by TTN and ChirpStack); if the server never answers,
                  the station turns the scans off until it restarts.
                  <span id="cfg-gnss-note" class="hidden text-amber-300">Needs the latest firmware: update the station first.</span>
                </span>
              </label>
            </div>

            <!-- Warning Banner -->
            <div class="p-3.5 rounded-control bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs space-y-2 leading-relaxed">
              <div class="flex items-center gap-2 font-bold text-amber-400">
                <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>Warning</span>
              </div>
              <ul class="list-disc list-inside text-[11px] text-amber-300 space-y-1.5 ml-0.5">
                <li>While it is on your network, the station is off the WeatherXM network and does not earn $WXM token rewards.</li>
                <li id="warn-keys">Checking whether this firmware can keep the WeatherXM keys...</li>
                <li>Its data does not appear in the WeatherXM app. The station can return to the WeatherXM (Helium) network at any time via the Helium tab above.</li>
              </ul>
            </div>

            <!-- Submit button -->
            <button
              id="btn-apply"
              type="button"
              class="w-full py-3.5 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Apply &amp; Connect to My Network</span>
            </button>
            <button id="btn-ttn-export-form" type="button" class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith cursor-pointer inline-flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download TTN import file (.json)
            </button>
            <p class="text-[11px] text-wxm-mist leading-relaxed">
              Registers this station in The Things Network in one step: in your TTN application open
              <strong class="text-white">End devices &gt; Import end devices</strong>, choose <strong class="text-white">The Things Stack JSON</strong>
              and select the file. It contains the DevEUI, JoinEUI, AppKey, LoRaWAN 1.0.4 / RP002 1.0.3 and the frequency plan.
              <span class="text-amber-300">The file holds your AppKey: keep it private.</span>
            </p>
          </div>

          <!-- Validation alert (shared across tabs) -->
          <p id="form-error" class="hidden text-xs text-red-300 leading-relaxed font-semibold"></p>

          <!-- Disconnect / Reboot notice -->
          <div class="p-3 rounded-control bg-wxm-abyss/60 border border-wxm-cloud/15 text-xs text-wxm-mist space-y-1.5 leading-relaxed">
            <div class="flex items-center gap-2 font-bold text-white text-xs">
              <svg class="w-3.5 h-3.5 text-wxm-zenith shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Note</span>
            </div>
            <ul class="list-disc list-inside text-[11px] text-wxm-mist space-y-1 ml-0.5">
              <li>Disconnecting reboots the station and triggers a LoRaWAN <code class="text-wxm-zenith bg-wxm-abyss px-1 py-0.5 rounded">Join-Request</code>.</li>
              <li>Click <code class="text-wxm-zenith bg-wxm-abyss px-1 py-0.5 rounded">Refresh</code> to reload any <strong class="text-white">Unknown</strong> values.</li>
            </ul>
          </div>
        </div>

        <!-- 3. Progress card (during write) -->
        <div id="view-progress" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin"></div>
            <div>
              <h3 class="text-sm font-bold text-white">Configuring Station...</h3>
              <p id="progress-step-text" class="text-xs text-wxm-mist">Applying LoRaWAN parameters over Bluetooth</p>
            </div>
          </div>
          <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
            <div id="progress-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
          </div>
        </div>

        <!-- 3b. Firmware update card -->
        <div id="view-dfu" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
          <div class="flex items-center gap-3">
            <div id="dfu-spinner" class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin shrink-0"></div>
            <div class="min-w-0">
              <h3 id="dfu-title" class="text-sm font-bold text-white">Updating firmware</h3>
              <p id="dfu-step" class="text-xs text-wxm-mist leading-relaxed">Preparing...</p>
            </div>
          </div>
          <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
            <div id="dfu-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
          </div>
          <p id="dfu-detail" class="text-[11px] text-wxm-mist leading-relaxed">Keep the station powered and this device within a few metres until the update finishes.</p>
          <div id="dfu-name-hint" class="hidden p-3 rounded-control bg-wxm-abyss/80 border border-wxm-zenith/30 text-[11.5px] text-wxm-cloud leading-relaxed space-y-1">
            <p class="font-bold text-white">Look for a different name in the Bluetooth list</p>
            <p>
              In update mode the station is a separate Bluetooth device called
              <strong id="dfu-name-hint-value" class="font-mono text-wxm-zenith">DfuWX…</strong>
              (or <span class="font-mono">DfuTarg</span>), <strong>not</strong> "WeatherXM WS2001 …". Only update-mode devices are listed.
              It returns to its normal name after the update.
            </p>
          </div>
          <button id="btn-dfu-pick" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Continue: select the station's update mode</button>
          <button id="btn-dfu-reconnect" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Reconnect to the station</button>
          <button id="btn-dfu-close" type="button" class="hidden w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">Close</button>
        </div>

        <!-- 4. Success card -->
        <div id="view-success" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-emerald-500/50 backdrop-blur-md shadow-card space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <h3 id="success-title" class="text-sm font-bold text-white">Connected to your network!</h3>
              <p id="success-sub" class="text-xs text-emerald-300">Settings written to flash. The station has rebooted to join your network.</p>
            </div>
          </div>
          <div class="p-3.5 rounded-control bg-wxm-abyss/80 border border-wxm-cloud/10 text-xs text-wxm-mist space-y-2">
            <p><strong>Next steps:</strong></p>
            <ul id="success-steps" class="list-disc pl-4 space-y-1">
              <li>Register the <strong>DevEUI</strong>, <strong>JoinEUI</strong> and <strong>AppKey</strong> in your TTN or ChirpStack application (LoRaWAN 1.0.4, OTAA, Class A). On TTN you can import the file below (<strong>End devices &gt; Import end devices &gt; The Things Stack JSON</strong>).</li>
              <li>Install the <strong>WeatherXM decoder</strong> below: one script for TTN v3, ChirpStack v4 and v3 that decodes the 24-byte frame on FPort 99, including wind gust and rain total.</li>
              <li>Wait for the device's first Join-Request (typically within 30-60 seconds after boot).</li>
            </ul>
          </div>
          <button id="btn-ttn-export-success" type="button" class="hidden w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith cursor-pointer inline-flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Download TTN import file (.json)
          </button>
          <button
            id="btn-done"
            type="button"
            class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer"
          >
            Configure Another Device
          </button>
        </div>

        <!-- Payload Decoder -->
        <div class="rounded-card border border-wxm-cloud/20 bg-wxm-abyss/60 p-4 space-y-2.5">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">Payload Decoder</h3>
          <p class="text-[11px] text-wxm-mist leading-relaxed">
            One script for The Things Stack v3, ChirpStack v4 and ChirpStack v3. It decodes the WeatherXM 24-byte frame on FPort 99, labels the radio's background messages on FPort 199, and still reads the legacy FPort 3 format. Paste it into TTN (Payload formatters &gt; Uplink &gt; Custom Javascript formatter) or ChirpStack (Device profile &gt; Codec).
          </p>
          <div class="flex flex-wrap gap-2">
            <button
              id="btn-show-decoder"
              type="button"
              title="Show the payload decoder"
              class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              Show
            </button>
            <button
              id="btn-copy-decoder"
              type="button"
              title="Copy the payload decoder to the clipboard"
              class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>
              Copy decoder
            </button>
            <a
              href="/decoders/ws2001_uplink_decoder.js"
              download="ws2001_uplink_decoder.js"
              title="Download ws2001_uplink_decoder.js"
              class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download .js
            </a>
          </div>
          <dialog
            id="decoder-dialog"
            aria-labelledby="decoder-dialog-title"
            class="m-auto w-[min(56rem,calc(100vw-2rem))] max-h-[85vh] rounded-card border border-wxm-cloud/20 bg-wxm-abyss p-0 text-white backdrop:bg-black/70"
          >
            <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-wxm-cloud/20">
              <h3 id="decoder-dialog-title" class="text-sm font-bold">ws2001_uplink_decoder.js</h3>
              <div class="flex items-center gap-2">
                <button id="btn-dialog-copy-decoder" type="button" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith cursor-pointer">Copy</button>
                <button id="btn-close-decoder" type="button" aria-label="Close" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">Close</button>
              </div>
            </div>
            <div class="overflow-auto max-h-[calc(85vh-3.5rem)] text-xs [&_pre]:p-4 [&_pre]:m-0">
              <Code code={WS2001_UPLINK_DECODER} lang="js" theme="github-dark" />
            </div>
          </dialog>
          <span id="decoder-copy-toast" class="hidden text-[11px] font-semibold text-emerald-300 block"></span>
        </div>
      </div>
    </div>

    <ol id="connect-steps" class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-3">
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">1</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Stand next to the station</h3>
          <p class="text-xs text-wxm-mist leading-relaxed">Stay within a few metres during the update. A laptop or an Android phone both work.</p>
        </div>
      </li>
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">2</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Press the station RESET button once <span class="block sm:inline text-xs font-medium text-wxm-mist">(first-time pairing only)</span></h3>
          <p class="text-xs text-wxm-mist leading-relaxed">
            If the station has never been paired before, press <strong class="text-white font-semibold">RESET</strong> once. You only need this for the initial pairing; new computers can pair during the first 5 minutes after the restart.
            <strong class="text-amber-300 font-semibold">Don't hold RESET:</strong> holding it for 10 seconds resets the station to factory settings.
          </p>
        </div>
      </li>
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">3</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Connect and pick "WeatherXM WS2001"</h3>
          <p class="text-xs text-wxm-mist leading-relaxed">Click Connect to WS2001 (H2) and select the station. If your computer asks to pair, accept it and let the pairing prompt finish.</p>
        </div>
      </li>
    </ol>

    <!-- Communication Log -->
    <div class="mt-6 p-4 rounded-card bg-wxm-abyss/80 border border-wxm-cloud/15 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-wxm-cloud uppercase tracking-wider text-[10px]">Communication Log</span>
        <button id="btn-clear-log" type="button" class="text-wxm-mist hover:text-white text-[11px] cursor-pointer">Clear</button>
      </div>
      <div
        id="term-log"
        class="h-36 overflow-y-auto font-mono text-[11px] space-y-1 p-2 rounded bg-black/40 border border-wxm-cloud/10 text-wxm-mist"
      >
        <div>[READY] Waiting for Bluetooth connection...</div>
      </div>
    </div>
  </section>

  <!-- Final Confirmation Modal -->
  <div id="modal-ws2001-confirm" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-wxm-ink/80 backdrop-blur-sm">
    <div class="max-w-md w-full rounded-modal border border-amber-500/40 bg-wxm-midnight p-6 shadow-2xl relative text-left space-y-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-control bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Confirm Network Migration</h3>
          <p class="text-xs text-amber-400 font-medium">Leaving the WeatherXM network</p>
        </div>
      </div>

      <div class="space-y-3 py-3 border-y border-wxm-cloud/15 text-xs text-wxm-cloud">
        <p class="text-[12px] text-white leading-relaxed">
          You are about to move <strong id="modal-confirm-deveui" class="font-mono text-wxm-zenith"></strong> from the WeatherXM network to your own LoRaWAN network server.
        </p>
        <div class="p-3 rounded-control bg-wxm-abyss/80 border border-amber-500/25 text-amber-200/90 text-[11.5px] space-y-1.5">
          <p class="font-bold text-amber-400">Please acknowledge before proceeding:</p>
          <ul class="list-disc list-inside space-y-1 text-amber-200/80">
            <li>While it is on your network, the station is off the WeatherXM network and does not earn $WXM token rewards.</li>
            <li id="modal-warn-keys">Checking whether this firmware can keep the WeatherXM keys...</li>
            <li>Its data does not appear in the WeatherXM app. The station can potentially return to the WeatherXM network later; contact WeatherXM support if needed.</li>
          </ul>
        </div>
      </div>

      <div class="flex items-start gap-2.5 pt-1">
        <input type="checkbox" id="chk-confirm-irreversible" class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-beacon focus:ring-0 cursor-pointer" />
        <label for="chk-confirm-irreversible" class="text-xs text-wxm-cloud cursor-pointer select-none leading-tight">
          I understand.
        </label>
      </div>

      <div class="pt-2 flex space-x-3 justify-end">
        <button
          id="btn-confirm-cancel"
          type="button"
          class="px-4 py-2.5 rounded-control text-xs font-semibold text-wxm-cloud hover:text-white border border-wxm-cloud/20 bg-wxm-storm/50 hover:bg-wxm-storm transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          id="btn-confirm-proceed"
          type="button"
          disabled
          class="px-5 py-2.5 rounded-control text-xs font-bold text-white bg-amber-600 hover:bg-amber-500 disabled:opacity-30 disabled:cursor-not-allowed shadow-card transition-all cursor-pointer"
        >
          Confirm & Switch
        </button>
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import { Ws2001AtClient, formatHexWithColons, type Ws2001DeviceConfig } from '../lib/ble/ws2001AtClient';
  import { WS2001_UPLINK_DECODER } from '../lib/ble/ws2001UplinkDecoder';
  import { trackTelemetry, redactTelemetryString } from '../lib/telemetry';
  import { ttnImportJson, ttnImportFileName, type TtnExportParams } from '../lib/ble/ws2001TtnExport';
  import { enterBootloader, requestBootloaderDevice, SecureDfuTransfer, makeBootloaderName, parseWs2001DfuPackage, type Ws2001DfuPackage } from '../lib/ble/ws2001Dfu';
  import { fetchWs2001Manifest, latestRelease, downloadWs2001Release, isOutdated, compareStationVersion, type Ws2001Release } from '../lib/ble/ws2001Firmware';

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };

  let client: Ws2001AtClient | null = null;
  let currentConfig: Ws2001DeviceConfig | null = null;
  let operationInFlight = false;

  // Published firmware releases (public/firmware/ws2001/manifest.json)
  let latest: Ws2001Release | null = null;
  let allReleases: Ws2001Release[] = [];
  const fwVersionSelect = $<HTMLSelectElement>('cfg-fw-version');
  const fwFileInput = $<HTMLInputElement>('cfg-fw-file');

  const latestReady = fetchWs2001Manifest()
    .then((m) => {
      latest = latestRelease(m);
      allReleases = m.releases;
      fwVersionSelect.innerHTML = '';
      for (const r of m.releases) {
        const opt = document.createElement('option');
        opt.value = r.version;
        opt.textContent = r.version === m.latest
          ? `${r.label} (Latest — Dual Network Profiles + Flash Preservation)`
          : r.label;
        fwVersionSelect.appendChild(opt);
      }
      const customOpt = document.createElement('option');
      customOpt.value = 'custom';
      customOpt.textContent = 'Custom signed package (-ble-dfu.zip)...';
      fwVersionSelect.appendChild(customOpt);
      fwVersionSelect.value = m.latest;
    })
    .catch((e) => {
      latest = null;
      allReleases = [];
      console.warn('WS2001 firmware list unavailable', e);
    });

  // Action mode switcher (Flash Firmware | Switch to Open LoRaWAN | Switch to Helium)
  type ActionMode = 'flash' | 'open' | 'helium';
  const modeButtons: Record<ActionMode, HTMLButtonElement> = {
    flash: $<HTMLButtonElement>('btn-mode-flash'),
    open: $<HTMLButtonElement>('btn-mode-open'),
    helium: $<HTMLButtonElement>('btn-mode-helium'),
  };
  const modePanels: Record<ActionMode, HTMLElement> = {
    flash: $('panel-flash'),
    open: $('panel-open'),
    helium: $('panel-helium'),
  };

  function selectActionMode(mode: ActionMode) {
    ($('form-error') as HTMLElement).classList.add('hidden');
    for (const m of ['flash', 'open', 'helium'] as ActionMode[]) {
      const active = m === mode;
      modeButtons[m].setAttribute('aria-selected', active ? 'true' : 'false');
      modeButtons[m].className = active
        ? 'p-3 rounded-control text-left border border-wxm-zenith bg-wxm-storm/60 hover:bg-wxm-storm/50 transition-all cursor-pointer space-y-1'
        : 'p-3 rounded-control text-left border border-wxm-cloud/20 bg-wxm-abyss/60 hover:bg-wxm-storm/50 transition-all cursor-pointer space-y-1';
      modePanels[m].classList.toggle('hidden', !active);
    }
  }

  modeButtons.flash.addEventListener('click', () => selectActionMode('flash'));
  modeButtons.open.addEventListener('click', () => selectActionMode('open'));
  modeButtons.helium.addEventListener('click', () => selectActionMode('helium'));
  $('btn-goto-flash-v49').addEventListener('click', () => {
    if (latest) fwVersionSelect.value = latest.version;
    if (currentConfig) updateFirmwarePanel(currentConfig);
    selectActionMode('flash');
  });

  const termLog = $('term-log');

  const addLog = (msg: string, level = 'INFO') => {
    const row = document.createElement('div');
    const time = new Date().toTimeString().slice(0, 8);
    let color = 'text-wxm-mist';
    if (level === 'CMD') color = 'text-wxm-zenith font-bold';
    if (level === 'RESP') color = 'text-emerald-300';
    if (level === 'WARN') color = 'text-amber-300';
    if (level === 'ERROR') color = 'text-red-400 font-bold';

    row.className = color;
    row.textContent = `[${time}] ${redactTelemetryString(msg)}`;
    termLog.appendChild(row);
    termLog.scrollTop = termLog.scrollHeight;
  };

  // Setup decoders copy buttons
  const decoderToast = $('decoder-copy-toast');
  const showDecoderToast = (text: string) => {
    decoderToast.textContent = text;
    decoderToast.classList.remove('hidden');
    setTimeout(() => decoderToast.classList.add('hidden'), 3500);
  };

  const copyDecoder = async () => {
    try {
      await navigator.clipboard.writeText(WS2001_UPLINK_DECODER);
      showDecoderToast('Copied the payload decoder to the clipboard.');
    } catch {
      showDecoderToast('Copy failed: use Download .js instead.');
    }
  };
  const decoderDialog = $<HTMLDialogElement>('decoder-dialog');
  $('btn-copy-decoder').addEventListener('click', copyDecoder);
  $('btn-show-decoder').addEventListener('click', () => decoderDialog.showModal());
  $('btn-close-decoder').addEventListener('click', () => decoderDialog.close());
  $('btn-dialog-copy-decoder').addEventListener('click', async () => {
    await copyDecoder();
    decoderDialog.close();
  });
  // Close when clicking the backdrop
  decoderDialog.addEventListener('click', (e) => {
    if (e.target === decoderDialog) decoderDialog.close();
  });

  $('btn-clear-log').addEventListener('click', () => {
    termLog.innerHTML = '<div>[CLEARED]</div>';
  });

  // Frequency band change handler (toggles sub-band selector)
  const bandSelect = $<HTMLSelectElement>('cfg-band');
  const groupSubband = $('group-subband');
  const updateSubbandVisibility = () => {
    const band = parseInt(bandSelect.value, 10);
    groupSubband.style.display = band === 8 || band === 1 ? 'block' : 'none';
  };
  bandSelect.addEventListener('change', updateSubbandVisibility);

  // Generate random 16-byte AppKey
  const generateRandomAppKey = () => {
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);
    const hex = Array.from(bytes)
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('')
      .toUpperCase();
    $<HTMLInputElement>('cfg-appkey').value = hex;
  };
  $('btn-gen-appkey').addEventListener('click', generateRandomAppKey);

  fwVersionSelect.addEventListener('change', () => {
    $('group-fw-custom').classList.toggle('hidden', fwVersionSelect.value !== 'custom');
    if (currentConfig) updateFirmwarePanel(currentConfig);
  });
  fwFileInput.addEventListener('change', () => {
    if (currentConfig) updateFirmwarePanel(currentConfig);
  });

  function getSelectedRelease(): Ws2001Release | null {
    const val = fwVersionSelect.value;
    if (val === 'custom') return null;
    return allReleases.find((r) => r.version === val) ?? latest;
  }

  function updateModeDisplay(cfg: Ws2001DeviceConfig) {
    const modeEl = $('stat-mode');
    const format = cfg.testModeType === 1 ? 'legacy FPort 3 format' : cfg.testModeType === 0 ? '24-byte frame' : 'format unknown';
    const onCustom = cfg.netProfile ? cfg.netProfile.active === 1 : cfg.testModeType === 1;
    const join = cfg.lorawanStatus === 'JOINED' ? ' · joined' : cfg.lorawanStatus === 'JOINING' ? ' · joining...' : '';
    if (onCustom) {
      modeEl.textContent = `Open LoRaWAN (${format})${join}`;
      modeEl.className = 'font-bold text-emerald-400 inline-block text-[11px]';
    } else if (cfg.netProfile || cfg.testModeType === 0) {
      modeEl.textContent = `Helium / WeatherXM (${format})${join}`;
      modeEl.className = 'font-bold text-amber-400 inline-block text-[11px]';
    } else {
      modeEl.textContent = 'Unknown';
      modeEl.className = 'font-bold text-zinc-400 inline-block text-[11px]';
    }

    const keysText = cfg.netProfile
      ? cfg.netProfile.weatherxmStored
        ? 'Your network settings are stored as a separate profile (profile 1); the Helium (WeatherXM) settings on the station are preserved in profile 0.'
        : 'Switching to your network will save the current Helium (WeatherXM) settings into profile 0 before activating profile 1.'
      : 'This firmware (< V4.5) is too old for dual network profiles: flash V4.9 first (1. Flash Firmware tab above) so Helium keys are preserved.';
    $('warn-keys').textContent = keysText;
    $('modal-warn-keys').textContent = keysText;

    // Badges on the 3 action tabs
    const hasStoredOpen = Boolean(cfg.netProfile?.customStored);
    const hasStoredHelium = Boolean(cfg.netProfile && (cfg.netProfile.weatherxmStored || cfg.netProfile.active === 0));
    $('badge-mode-open').classList.toggle('hidden', !hasStoredOpen);
    $('badge-mode-helium').classList.toggle('hidden', !hasStoredHelium);

    // Banner for < V4.5 (e.g. V4.3) in Open LoRaWAN tab
    const isOldFw = !cfg.netProfile;
    $('open-old-fw-ver').textContent = cfg.version || 'V4.3';
    $('open-old-fw-banner').classList.toggle('hidden', !isOldFw);

    // 1-click stored Open LoRaWAN card in Open LoRaWAN tab
    $('group-switch-open-stored').classList.toggle('hidden', !hasStoredOpen);
    const btnSwitchOpenStored = $<HTMLButtonElement>('btn-switch-open-stored');
    btnSwitchOpenStored.disabled = !hasStoredOpen;
    btnSwitchOpenStored.textContent = onCustom
      ? 'Re-apply Stored Open LoRaWAN Profile & Reboot'
      : 'Switch to Stored Open LoRaWAN Profile Now (No Config Needed)';

    // Helium (WeatherXM) tab status & button
    const btnSwitchBack = $<HTMLButtonElement>('btn-switchback');
    if (!cfg.netProfile) {
      $('helium-status-title').textContent = `Station is running ${cfg.version} (Single Profile)`;
      $('helium-status-desc').textContent =
        'Flash V4.9 first in the "1. Flash Firmware" tab so the station backs up its Helium (WeatherXM) credentials into Profile 0.';
      btnSwitchBack.disabled = true;
      btnSwitchBack.textContent = 'Flash V4.9 First to Enable Instant Helium Switching';
    } else if (!hasStoredHelium) {
      $('helium-status-title').textContent = 'No Stored Helium Profile Found';
      $('helium-status-desc').textContent =
        'Profile 0 does not have stored WeatherXM credentials on this station.';
      btnSwitchBack.disabled = true;
      btnSwitchBack.textContent = 'Helium Profile Unavailable';
    } else if (onCustom) {
      $('helium-status-title').textContent = 'Ready to Return to Helium (WeatherXM)';
      $('helium-status-desc').textContent =
        'This station is currently on Open LoRaWAN (Profile 1). Its original Helium (WeatherXM) keys and 3-minute interval are safely stored in Profile 0 — click below to switch back with zero configuration.';
      btnSwitchBack.disabled = false;
      btnSwitchBack.textContent = 'Switch Back to Helium (WeatherXM) — No Configuration Needed';
    } else {
      $('helium-status-title').textContent = 'Station is Currently on Helium (WeatherXM)';
      $('helium-status-desc').textContent =
        'Profile 0 (Helium / WeatherXM) is already active. You can click below to re-apply Profile 0 and reboot the station to send a fresh Helium Join-Request.';
      btnSwitchBack.disabled = false;
      btnSwitchBack.textContent = 'Re-apply Helium (WeatherXM) Profile & Reboot';
    }
  }

  function updateFirmwarePanel(cfg: Ws2001DeviceConfig) {
    const btn = $<HTMLButtonElement>('btn-fw-update');
    const txt = $('fw-update-text');
    const note = $('fw-version-note');

    const outdatedVsLatest = Boolean(latest && isOutdated(cfg.version, latest.version));
    $('badge-mode-flash').classList.toggle('hidden', !outdatedVsLatest);

    if (fwVersionSelect.value === 'custom') {
      const file = fwFileInput.files?.[0];
      if (!file) {
        txt.textContent = `Current: ${cfg.version} · Select a signed -ble-dfu.zip file below`;
        txt.className = 'font-semibold block mt-0.5 text-xs text-amber-300';
        btn.textContent = 'Select a .zip file first';
        btn.disabled = true;
      } else {
        txt.textContent = `Current: ${cfg.version} → Custom package (${file.name})`;
        txt.className = 'font-semibold block mt-0.5 text-xs text-emerald-300';
        btn.textContent = `Flash ${file.name}`;
        btn.disabled = false;
      }
      note.textContent = 'The custom package must be signed with the WS2001 DFU key and have a firmware version >= the station version.';
      return;
    }

    const selected = getSelectedRelease();
    if (!selected) {
      txt.textContent = 'Firmware list unavailable';
      btn.disabled = true;
      return;
    }

    const cmp = compareStationVersion(cfg.version, selected.version);
    if (cmp === 'older') {
      txt.textContent = `Current: ${cfg.version} → ${selected.label} ready to flash`;
      txt.className = 'font-semibold block mt-0.5 text-xs text-amber-300';
      btn.textContent = `Flash ${selected.label} Firmware`;
      btn.disabled = false;
      note.textContent =
        'Flashing V4.9 preserves all existing station settings and automatically backs up factory Helium (WeatherXM) keys into Profile 0.';
    } else if (cmp === 'equal') {
      txt.textContent = `Station is already on ${selected.label} (can reinstall)`;
      txt.className = 'font-semibold block mt-0.5 text-xs text-emerald-300';
      btn.textContent = `Reinstall ${selected.label} Firmware`;
      btn.disabled = false;
      note.textContent = 'Reinstalling the same firmware version preserves all stored network profiles and rain counters.';
    } else if (cmp === 'newer') {
      txt.textContent = `Station runs ${cfg.version} (newer than ${selected.label})`;
      txt.className = 'font-semibold block mt-0.5 text-xs text-amber-300';
      btn.textContent = `Cannot downgrade (${cfg.version} → ${selected.label})`;
      btn.disabled = true;
      note.textContent = 'The WS2001 secure bootloader blocks firmware downgrades to a lower version number.';
    } else {
      txt.textContent = `Station version unknown (selected ${selected.label}); click Refresh first`;
      txt.className = 'font-semibold block mt-0.5 text-xs text-amber-300';
      btn.textContent = `Flash ${selected.label}`;
      btn.disabled = true;
    }
  }

  // What the WeatherXM backend needs to unprovision / re-provision the station on its LNS
  // (Helium ChirpStack / LoneStar). serial_number on the event is the DevEUI.
  function networkSwitchDetails(cfg: Ws2001DeviceConfig | null) {
    const wxmActive = cfg?.netProfile ? cfg.netProfile.active === 0 : cfg?.testModeType !== 1;
    return {
      model: cfg?.deviceModel || 'H2',
      bleName: cfg?.bleName,
      defEui: cfg?.formattedDefEui || cfg?.defEui,
      devAddr: cfg?.devAddr,
      hardwareVersion: cfg?.hardwareVersion,
      lorawanVersion: cfg?.lorawanVersion,
      firmwareVersion: cfg?.version,
      keysKept: Boolean(cfg?.netProfile && (cfg.netProfile.weatherxmStored || cfg.netProfile.active === 0)),
      fromNetwork: wxmActive ? 'weatherxm' : 'open_lorawan',
      wxmJoinEui: wxmActive ? cfg?.appEui ?? null : null,
    };
  }

  // GNSS on a customer network needs V4.7+ (DeviceTimeReq, no FPort 199 services)
  function gnssAllowed(): boolean {
    if (!currentConfig) return false;
    const cmp = compareStationVersion(currentConfig.version, '4.7');
    return cmp === 'equal' || cmp === 'newer';
  }

  function populateDeviceView(cfg: Ws2001DeviceConfig) {
    currentConfig = cfg;
    const gnssBox = $<HTMLInputElement>('cfg-gnss');
    gnssBox.disabled = !gnssAllowed();
    gnssBox.checked = gnssAllowed() && cfg.gnssSwitch === true;
    $('cfg-gnss-note').classList.toggle('hidden', gnssAllowed());
    updateFirmwarePanel(cfg);

    // Populate Device Status Card
    const devLabel = client?.deviceName || 'Station';
    $('dev-name').textContent = cfg.deviceModel !== 'Unknown' ? `${cfg.deviceModel} (${devLabel})` : devLabel;
    $('stat-deveui').textContent = cfg.formattedDevEui;
    $('stat-band').textContent = cfg.frequencyName;
    $('stat-ver').textContent = cfg.version;
    $('stat-bat').textContent = cfg.battery;
    $('stat-interval').textContent = cfg.uploadInterval !== null ? `${cfg.uploadInterval} min` : 'Unknown';

    updateModeDisplay(cfg);

    // Choose initial action tab based on station state, while letting the user pick any of the 3 tabs
    if (!cfg.netProfile) {
      // Field station on V4.3: highlight Flash Firmware (V4.9) first
      selectActionMode('flash');
    } else if (cfg.netProfile.active === 1) {
      // Currently on Open LoRaWAN: highlight Helium (or user can click Flash / Open)
      selectActionMode('helium');
    } else {
      // On V4.5+ Helium: highlight Open LoRaWAN (or user can click Flash / Helium)
      selectActionMode('open');
    }

    trackTelemetry({
      device_type: 'ws2001',
      serial_number: cfg.formattedDevEui || cfg.deviceEui,
      action: 'connected',
      firmware_source: cfg.version,
      status: 'success',
      details: {
        model: cfg.deviceModel,
        bleName: cfg.bleName,
        bleId: cfg.bleId,
        defEui: cfg.formattedDefEui || cfg.defEui,
        devAddr: cfg.devAddr,
        appEui: cfg.appEui,
        hardwareVersion: cfg.hardwareVersion,
        lorawanVersion: cfg.lorawanVersion,
        classType: cfg.classType,
        joinType: cfg.joinType,
        battery: cfg.battery,
        intervalMinutes: cfg.uploadInterval,
        mode: cfg.testModeType === 0 ? 'weatherxm' : cfg.testModeType === 1 ? 'open_lorawan' : 'unknown',
        netProfile: cfg.netProfile ? cfg.netProfile.active : null,
        band: cfg.frequencyName,
      },
    });

    // Prepopulate form with device current band
    if (cfg.frequencyBand !== null) {
      bandSelect.value = String(cfg.frequencyBand);
    }
    if (cfg.subBand !== null) {
      $<HTMLSelectElement>('cfg-subband').value = String(cfg.subBand);
    }
    updateSubbandVisibility();

    // Keep the TTN-friendly default unless the station is already on the customer's network
    const alreadyCustom = cfg.netProfile ? cfg.netProfile.active === 1 : cfg.testModeType === 1;
    if (cfg.uploadInterval !== null && alreadyCustom) {
      const intervalSelect = $<HTMLSelectElement>('cfg-interval');
      const val = String(cfg.uploadInterval);
      const hasOption = Array.from(intervalSelect.options).some((opt) => opt.value === val);
      if (!hasOption) {
        const customOpt = document.createElement('option');
        customOpt.value = val;
        const fairUseNote = cfg.uploadInterval < 5 ? ' — exceeds TTN fair use' : '';
        customOpt.textContent = `${cfg.uploadInterval} minutes (current${fairUseNote})`;
        intervalSelect.appendChild(customOpt);
      }
      intervalSelect.value = val;
    }

    // Never pre-fill the WeatherXM JoinEUI into a form meant for the customer's network
    if (alreadyCustom && cfg.appEui && cfg.appEui.length === 16) {
      $<HTMLInputElement>('cfg-joineui').value = cfg.appEui;
    } else {
      $<HTMLInputElement>('cfg-joineui').value = '0000000000000000';
    }

    // Pre-generate a random 16-byte AppKey if empty so first-time Open LoRaWAN setup requires zero typing
    const appKeyInput = $<HTMLInputElement>('cfg-appkey');
    if (!appKeyInput.value.trim()) {
      generateRandomAppKey();
    }
  }

  // Connect button handler
  const btnConnect = $<HTMLButtonElement>('btn-connect');
  const connectError = $('connect-error');

  // Cancel a connect that hangs (e.g. the OS stuck mid-pairing): drops the link so the next try starts clean
  const btnCancelConnect = $<HTMLButtonElement>('btn-cancel-connect');
  let cancelConnect: (() => void) | null = null;
  btnCancelConnect.addEventListener('click', () => cancelConnect?.());

  btnConnect.addEventListener('click', async () => {
    connectError.classList.add('hidden');
    btnConnect.disabled = true;
    $('btn-connect-label').textContent = 'Connecting...';
    btnCancelConnect.classList.remove('hidden');

    client = new Ws2001AtClient((msg, lvl) => addLog(msg, lvl));
    const cancelled = new Promise<never>((_, reject) => {
      cancelConnect = () => reject(new Error('Connection cancelled. Wait a few seconds, then connect again.'));
    });

    try {
      const cfg = await Promise.race([
        (async () => {
          await client!.connect();
          addLog('Connection established. Querying station info...');
          return client!.readFullConfig();
        })(),
        cancelled,
      ]);
      await latestReady;
      populateDeviceView(cfg);

      // Show device view
      $('view-connect').classList.add('hidden');
      $('connect-steps').classList.add('hidden');
      $('view-device').classList.remove('hidden');

      if (chkAutoUpdate.checked && latest && isOutdated(cfg.version, latest.version)) {
        addLog(`Station runs ${cfg.version}; updating to ${latest.label} automatically (option enabled).`, 'INFO');
        void runFirmwareUpdate('auto');
      }
    } catch (err) {
      addLog((err as Error).message, 'ERROR');
      connectError.textContent = (err as Error).message;
      connectError.classList.remove('hidden');
      // Release a half-open link so the next attempt starts clean
      await client?.disconnect().catch(() => {});
      client = null;
    } finally {
      cancelConnect = null;
      btnCancelConnect.classList.add('hidden');
      btnConnect.disabled = false;
      $('btn-connect-label').textContent = 'Connect to WS2001 (H2)';
    }
  });

  // Copy DevEUI button with local inline feedback
  let copyDevEuiTimer: ReturnType<typeof setTimeout> | null = null;
  $('btn-copy-deveui').addEventListener('click', async () => {
    if (currentConfig?.deviceEui && currentConfig.deviceEui !== 'Unknown') {
      await navigator.clipboard.writeText(currentConfig.deviceEui);
      const btn = $<HTMLButtonElement>('btn-copy-deveui');
      const label = $('label-copy-deveui');
      const icon = $('icon-copy-deveui');

      label.textContent = 'Copied!';
      btn.classList.add('text-emerald-400', 'border-emerald-500/40');
      btn.classList.remove('text-wxm-mist');
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />';

      if (copyDevEuiTimer) clearTimeout(copyDevEuiTimer);
      copyDevEuiTimer = setTimeout(() => {
        label.textContent = 'Copy';
        btn.classList.remove('text-emerald-400', 'border-emerald-500/40');
        btn.classList.add('text-wxm-mist');
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />';
      }, 2000);
    }
  });

  // Refresh button handler
  $('btn-refresh').addEventListener('click', async () => {
    if (!client || !client.isConnected || operationInFlight) return;
    operationInFlight = true;
    const btnRefresh = $<HTMLButtonElement>('btn-refresh');
    const iconRefresh = $('icon-refresh');
    const labelRefresh = $('label-refresh');

    btnRefresh.disabled = true;
    iconRefresh.classList.add('animate-spin');
    labelRefresh.textContent = 'Refreshing...';

    try {
      addLog('Refreshing station configuration (AT+CONFIG=?, AT+TESTMODE_TYPE=?)...', 'INFO');
      const cfg = await client.readFullConfig();
      populateDeviceView(cfg);
      addLog('Station info refreshed successfully.', 'SUCCESS');
    } catch (err) {
      addLog(`Failed to refresh station info: ${(err as Error).message}`, 'WARN');
    } finally {
      operationInFlight = false;
      btnRefresh.disabled = false;
      iconRefresh.classList.remove('animate-spin');
      labelRefresh.textContent = 'Refresh';
    }
  });

  // Disconnect button handler
  $('btn-disconnect').addEventListener('click', async () => {
    addLog('Disconnecting Bluetooth... Station will reboot and send a fresh LoRaWAN Join-Request.', 'INFO');
    if (client) {
      await client.disconnect();
      client = null;
    }
    currentConfig = null;
    $('view-device').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
  });

  // Apply configuration button
  const btnApply = $<HTMLButtonElement>('btn-apply');
  const formError = $('form-error');

  const modalConfirm = $('modal-ws2001-confirm');
  const modalConfirmDevEui = $('modal-confirm-deveui');
  const chkConfirm = $<HTMLInputElement>('chk-confirm-irreversible');
  const btnConfirmCancel = $<HTMLButtonElement>('btn-confirm-cancel');
  const btnConfirmProceed = $<HTMLButtonElement>('btn-confirm-proceed');

  // TTN import file (generated in the browser only, it contains the AppKey)
  let lastTtnExport: TtnExportParams | null = null;
  function downloadTtnImport(params: TtnExportParams): void {
    const blob = new Blob([ttnImportJson(params)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = ttnImportFileName(params);
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    addLog(`Saved ${a.download} for The Things Network import (contains the AppKey).`, 'INFO');
  }
  function ttnExportFromForm(): TtnExportParams {
    const devEui = currentConfig?.deviceEui || currentConfig?.formattedDevEui;
    if (!devEui || devEui === 'Unknown') throw new Error('Connect to a station first: its DevEUI is needed.');
    return {
      devEui,
      joinEui: $<HTMLInputElement>('cfg-joineui').value.trim(),
      appKey: $<HTMLInputElement>('cfg-appkey').value.trim(),
      band: parseInt(bandSelect.value, 10),
      subBand: parseInt($<HTMLSelectElement>('cfg-subband').value, 10),
    };
  }
  $('btn-ttn-export-form').addEventListener('click', () => {
    formError.classList.add('hidden');
    try {
      downloadTtnImport(ttnExportFromForm());
    } catch (e) {
      formError.textContent = (e as Error).message;
      formError.classList.remove('hidden');
    }
  });
  $('btn-ttn-export-success').addEventListener('click', () => {
    if (lastTtnExport) downloadTtnImport(lastTtnExport);
  });

  let pendingMigrationParams: {
    band: number;
    subBand: number;
    joinEui: string;
    appKey: string;
    intervalMinutes: number;
    gnss: boolean;
  } | null = null;

  // Toggle proceed button based on checkbox acknowledgment
  chkConfirm.addEventListener('change', () => {
    btnConfirmProceed.disabled = !chkConfirm.checked;
  });

  // Cancel modal
  btnConfirmCancel.addEventListener('click', () => {
    modalConfirm.classList.add('hidden');
    pendingMigrationParams = null;
  });

  // Apply button clicked -> validate and show confirmation modal
  btnApply.addEventListener('click', () => {
    if (!client || !client.isConnected || operationInFlight) {
      alert('Station is not connected.');
      return;
    }

    formError.classList.add('hidden');

    if (!currentConfig?.netProfile) {
      formError.textContent = 'This station runs firmware that is too old for your own network. Flash V4.9 first in the "1. Flash Firmware" tab above, then apply your settings.';
      formError.classList.remove('hidden');
      return;
    }

    const band = parseInt(bandSelect.value, 10);
    const subBand = parseInt($<HTMLSelectElement>('cfg-subband').value, 10);
    const joinEuiRaw = $<HTMLInputElement>('cfg-joineui').value.trim();
    const appKeyRaw = $<HTMLInputElement>('cfg-appkey').value.trim();
    const interval = parseInt($<HTMLSelectElement>('cfg-interval').value, 10);

    if (isNaN(band)) {
      formError.textContent = 'Please select a valid frequency region.';
      formError.classList.remove('hidden');
      return;
    }

    // Validate JoinEUI
    let formattedJoinEui = '';
    try {
      formattedJoinEui = formatHexWithColons(joinEuiRaw, 8);
    } catch {
      formError.textContent = 'Invalid JoinEUI: must be exactly 16 hexadecimal characters (8 bytes).';
      formError.classList.remove('hidden');
      return;
    }

    // Validate AppKey
    let formattedAppKey = '';
    try {
      formattedAppKey = formatHexWithColons(appKeyRaw, 16);
    } catch {
      formError.textContent = 'Invalid AppKey: must be exactly 32 hexadecimal characters (16 bytes).';
      formError.classList.remove('hidden');
      return;
    }

    // Store parameters pending user confirmation
    pendingMigrationParams = {
      band,
      subBand,
      joinEui: formattedJoinEui,
      appKey: formattedAppKey,
      intervalMinutes: interval,
      gnss: gnssAllowed() && $<HTMLInputElement>('cfg-gnss').checked,
    };

    // Open confirmation modal
    modalConfirmDevEui.textContent = currentConfig?.formattedDevEui || currentConfig?.deviceEui || 'WS2001 Station';
    chkConfirm.checked = false;
    btnConfirmProceed.disabled = true;
    modalConfirm.classList.remove('hidden');
  });

  // Final confirmation proceed -> execute migration
  btnConfirmProceed.addEventListener('click', async () => {
    if (!pendingMigrationParams || !client || !client.isConnected || operationInFlight) {
      modalConfirm.classList.add('hidden');
      return;
    }

    operationInFlight = true;
    modalConfirm.classList.add('hidden');

    // Begin progress view
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const progressBar = $('progress-bar');
    const stepText = $('progress-step-text');

    const params = pendingMigrationParams;
    pendingMigrationParams = null;

    const serialNum = currentConfig?.formattedDevEui || currentConfig?.deviceEui;
    const fwVer = currentConfig?.version;
    const switchDetails = {
      ...networkSwitchDetails(currentConfig),
      band: params.band,
      subBand: params.subBand,
      intervalMinutes: params.intervalMinutes,
      gnss: params.gnss,
    };

    trackTelemetry({
      device_type: 'ws2001',
      serial_number: serialNum,
      action: 'network_switch_started',
      firmware_target: 'open_lorawan',
      firmware_source: fwVer,
      status: 'in_progress',
      details: switchDetails,
    });

    try {
      await client.configureOpenLoRaWan(
        params,
        (stepDesc, current, total) => {
          stepText.textContent = stepDesc;
          const percent = Math.round((current / total) * 100);
          progressBar.style.width = `${percent}%`;
          addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
        },
        // V4.5+ only (older firmware is blocked above): the keys go into the custom profile
        { useProfiles: true, allowOverwrite: false },
      );
      $('success-title').textContent = 'Connected to your network!';
      $('success-sub').textContent = 'Settings written to flash. The station has rebooted to join your network.';
      $('success-steps').classList.remove('hidden');
      try {
        lastTtnExport = ttnExportFromForm();
        $('btn-ttn-export-success').classList.remove('hidden');
      } catch {
        lastTtnExport = null;
        $('btn-ttn-export-success').classList.add('hidden');
      }

      currentConfig = null;
      client = null;
      progressBar.style.width = '100%';
      $('view-progress').classList.add('hidden');
      $('view-success').classList.remove('hidden');

      trackTelemetry({
        device_type: 'ws2001',
        serial_number: serialNum,
        action: 'network_switch_completed',
        firmware_target: 'open_lorawan',
        firmware_source: fwVer,
        status: 'success',
        details: switchDetails,
      });
    } catch (err) {
      const safeErr = redactTelemetryString((err as Error).message);
      addLog(`Configuration failed: ${safeErr}`, 'ERROR');
      if (client?.isConnected) {
        const refreshed = await client.readFullConfig().catch(() => null);
        if (refreshed) populateDeviceView(refreshed);
      } else {
        currentConfig = null;
      }
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = safeErr;
      formError.classList.remove('hidden');

      trackTelemetry({
        device_type: 'ws2001',
        serial_number: serialNum,
        action: 'network_switch_failed',
        firmware_target: 'open_lorawan',
        firmware_source: fwVer,
        status: 'failed',
        details: { ...switchDetails, error: safeErr },
      });
    } finally {
      operationInFlight = false;
    }
  });

  // --- Firmware update (auto on connect if enabled, or manual version selection) ---
  const chkAutoUpdate = $<HTMLInputElement>('chk-auto-update');
  try {
    chkAutoUpdate.checked = localStorage.getItem('ws2001-auto-update') === '1';
  } catch { /* storage unavailable: keep default (off so user chooses action on connect) */ }
  chkAutoUpdate.addEventListener('change', () => {
    try { localStorage.setItem('ws2001-auto-update', chkAutoUpdate.checked ? '1' : '0'); } catch { /* ignore */ }
  });

  let dfuName = '';
  let dfuPackage: Ws2001DfuPackage | null = null;
  let dfuTargetLabel = '';
  let dfuFrom = '';
  let dfuSerial: string | undefined;

  function setDfu(step: string, percent: number, title = 'Updating firmware') {
    $('dfu-title').textContent = title;
    $('dfu-step').textContent = step;
    $('dfu-bar').style.width = `${Math.max(0, Math.min(100, percent))}%`;
  }
  function showDfuButtons(which: Array<'pick' | 'reconnect' | 'close'>) {
    $('btn-dfu-pick').classList.toggle('hidden', !which.includes('pick'));
    $('btn-dfu-reconnect').classList.toggle('hidden', !which.includes('reconnect'));
    $('btn-dfu-close').classList.toggle('hidden', !which.includes('close'));
    $('dfu-spinner').classList.toggle('hidden', which.length > 0);
    // Whenever the user has to pick the bootloader, explain that it has a different name
    $('dfu-name-hint-value').textContent = dfuName || 'DfuWX…';
    $('dfu-name-hint').classList.toggle('hidden', !which.includes('pick'));
  }
  function dfuFailed(err: unknown, canResume: boolean) {
    const msg = redactTelemetryString((err as Error).message);
    addLog(`Firmware update failed: ${msg}`, 'ERROR');
    setDfu(msg, 0, 'Firmware update failed');
    $('dfu-detail').textContent = canResume
      ? 'The station stays in update mode for about 2 minutes and keeps its current firmware. Try again to resume.'
      : 'The station was not changed.';
    $('btn-dfu-pick').textContent = 'Try again';
    showDfuButtons(canResume ? ['pick', 'close'] : ['close']);
    trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_failed', firmware_target: dfuTargetLabel,
      firmware_source: dfuFrom, status: 'failed', details: { error: msg } });
  }

  async function runFirmwareUpdate(trigger: 'auto' | 'manual', customFile?: File) {
    if (!client || !client.gattServer || !currentConfig || operationInFlight) return;
    const targetRel = trigger === 'auto' ? latest : getSelectedRelease();
    if (!customFile && !targetRel) return;

    if (!customFile && targetRel) {
      const cmp = compareStationVersion(currentConfig.version, targetRel.version);
      if (cmp !== 'older' && cmp !== 'equal') return;
    }

    operationInFlight = true;
    dfuTargetLabel = customFile ? customFile.name : targetRel!.label;
    dfuFrom = currentConfig.version;
    dfuSerial = currentConfig.formattedDevEui || currentConfig.deviceEui;
    $('view-device').classList.add('hidden');
    $('view-dfu').classList.remove('hidden');
    $('dfu-detail').textContent = 'Keep the station powered and this device within a few metres until the update finishes.';
    showDfuButtons([]);
    setDfu(`Preparing and verifying ${dfuTargetLabel}...`, 1);
    trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_started', firmware_target: dfuTargetLabel,
      firmware_source: dfuFrom, status: 'in_progress', details: { trigger } });
    try {
      if (customFile) {
        const bytes = new Uint8Array(await customFile.arrayBuffer());
        dfuPackage = await parseWs2001DfuPackage(bytes);
        if (dfuPackage.initPacket.fwVersion !== null) {
          dfuTargetLabel = `V${Math.floor(dfuPackage.initPacket.fwVersion / 10)}.${dfuPackage.initPacket.fwVersion % 10}`;
        }
      } else {
        dfuPackage = await downloadWs2001Release(targetRel!);
      }
      addLog(`${dfuTargetLabel} verified: signed for the WS2001 bootloader (${dfuPackage.firmware.length} bytes).`);
    } catch (e) {
      operationInFlight = false;
      dfuFailed(e, false);
      return;
    }
    try {
      dfuName = makeBootloaderName();
      setDfu('Restarting the station into update mode...', 3);
      client.detachForBootloader();
      await enterBootloader(client.gattServer, dfuName, addLog);
      currentConfig = null;
      client = null;
      await new Promise((r) => setTimeout(r, 2500));
    } catch (e) {
      operationInFlight = false;
      dfuFailed(e, false);
      return;
    }
    operationInFlight = false;
    // Browsers need a click to connect to the bootloader, which is a new Bluetooth device.
    setDfu(`The station is in update mode. Click Continue and pick "${dfuName}" in the Bluetooth list.`, 5);
    $('btn-dfu-pick').textContent = `Continue: select "${dfuName}"`;
    showDfuButtons(['pick']);
  }

  $('btn-fw-update').addEventListener('click', () => {
    if (!currentConfig || operationInFlight) return;
    if (fwVersionSelect.value === 'custom') {
      const file = fwFileInput.files?.[0];
      if (!file) return;
      if (confirm(`Flash custom firmware package "${file.name}" onto this station? Settings and network profiles are kept.`)) {
        void runFirmwareUpdate('manual', file);
      }
      return;
    }
    const selected = getSelectedRelease();
    if (!selected) return;
    const cmp = compareStationVersion(currentConfig.version, selected.version);
    if (cmp !== 'older' && cmp !== 'equal') return;
    const question = cmp === 'older'
      ? `Flash ${selected.label} onto this station (currently ${currentConfig.version})? It takes about a minute; settings and network profiles are kept.`
      : `Reinstall ${selected.label} on this station? It takes about a minute; settings and network profiles are kept.`;
    if (confirm(question)) void runFirmwareUpdate('manual');
  });

  $('btn-dfu-pick').addEventListener('click', async () => {
    if (!dfuPackage || !dfuTargetLabel) return;
    showDfuButtons([]);
    let server: BluetoothRemoteGATTServer | null = null;
    try {
      const dev = await requestBootloaderDevice(dfuName);
      setDfu(`Connecting to ${dev.name ?? 'the bootloader'}...`, 6);
      const onProgress = (p: { stage: string; sent: number; total: number; kbPerSec: number }) => {
        if (p.stage === 'firmware') {
          const pct = 8 + (92 * p.sent) / p.total;
          setDfu(`Installing ${dfuTargetLabel}: ${Math.floor((100 * p.sent) / p.total)}% (${p.kbPerSec.toFixed(1)} KB/s)`, pct);
        }
      };
      // The first connection to a freshly rebooted bootloader often drops right away
      // ("GATT Server is disconnected"): retry a few times before asking the user.
      let transfer: SecureDfuTransfer | null = null;
      for (let attempt = 1; !transfer; attempt++) {
        try {
          server = await dev.gatt!.connect();
          transfer = await SecureDfuTransfer.open(server, addLog, onProgress);
        } catch (e) {
          if (attempt >= 3 || (e as Error).name === 'DfuError') throw e;
          addLog(`Bootloader connection dropped (${(e as Error).message}); retrying ${attempt}/2...`, 'WARN');
          try { server?.disconnect(); } catch { /* ignore */ }
          await new Promise((r) => setTimeout(r, 1500));
        }
      }
      const t0 = performance.now();
      setDfu('Sending the signed update header...', 7);
      await transfer.sendInit(dfuPackage.init);
      await transfer.sendFirmware(dfuPackage.firmware);
      addLog(`Transferred ${(dfuPackage.firmware.length / 1024).toFixed(1)} KB in ${((performance.now() - t0) / 1000).toFixed(0)} s.`);
      setDfu(`${dfuTargetLabel} installed. The station is restarting (about 10 seconds).`, 100, 'Firmware updated');
      $('dfu-detail').textContent = 'Reconnect to check the new version and continue setting up the station.';
      showDfuButtons(['reconnect', 'close']);
      trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_completed', firmware_target: dfuTargetLabel,
        firmware_source: dfuFrom, status: 'success' });
    } catch (e) {
      if ((e as Error).name === 'NotFoundError') {
        // Chooser cancelled: offer the button again
        setDfu(`Pick "${dfuName}" in the Bluetooth list to continue.`, 5);
        showDfuButtons(['pick', 'close']);
        return;
      }
      dfuFailed(e, true);
    } finally {
      try { server?.disconnect(); } catch { /* ignore */ }
    }
  });

  $('btn-dfu-reconnect').addEventListener('click', () => {
    $('view-dfu').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
    btnConnect.click(); // same user gesture opens the chooser
  });
  $('btn-dfu-close').addEventListener('click', () => {
    $('view-dfu').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
  });

  // 1-Click Switch to Stored Open LoRaWAN Profile (firmware V4.5+ when customStored is true)
  $('btn-switch-open-stored').addEventListener('click', async () => {
    if (!client || !client.isConnected || !currentConfig?.netProfile?.customStored || operationInFlight) return;
    if (!confirm('Switch this station to its stored Open LoRaWAN profile (Profile 1)? Its Helium (WeatherXM) keys stay preserved in Profile 0.')) return;
    operationInFlight = true;
    const btn = $<HTMLButtonElement>('btn-switch-open-stored');
    btn.disabled = true;
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const serialNum = currentConfig.formattedDevEui || currentConfig.deviceEui;
    const fwVer = currentConfig.version;
    const openDetails = networkSwitchDetails(currentConfig);
    trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_started', firmware_target: 'open_lorawan',
      firmware_source: fwVer, status: 'in_progress', details: { ...openDetails, storedProfile: true } });
    try {
      await client.switchToStoredOpenLoRaWan((stepDesc, current, total) => {
        $('progress-step-text').textContent = stepDesc;
        $('progress-bar').style.width = `${Math.round((current / total) * 100)}%`;
        addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
      });
      currentConfig = null;
      client = null;
      $('view-progress').classList.add('hidden');
      $('success-title').textContent = 'Switched to Stored Open LoRaWAN Profile!';
      $('success-sub').textContent = 'The station restarted with its stored Open LoRaWAN settings (Profile 1).';
      $('success-steps').classList.remove('hidden');
      $('btn-ttn-export-success').classList.add('hidden');
      $('view-success').classList.remove('hidden');
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_completed', firmware_target: 'open_lorawan',
        firmware_source: fwVer, status: 'success', details: { ...openDetails, storedProfile: true } });
    } catch (err) {
      const safeErr = redactTelemetryString((err as Error).message);
      addLog(`Switch to stored Open LoRaWAN failed: ${safeErr}`, 'ERROR');
      if (client?.isConnected) {
        const refreshed = await client.readFullConfig().catch(() => null);
        if (refreshed) populateDeviceView(refreshed);
      } else {
        currentConfig = null;
      }
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_failed', firmware_target: 'open_lorawan',
        firmware_source: fwVer, status: 'failed', details: { ...openDetails, storedProfile: true, error: safeErr } });
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = safeErr;
      formError.classList.remove('hidden');
    } finally {
      operationInFlight = false;
      btn.disabled = false;
    }
  });

  // Switch back to Helium / WeatherXM (firmware V4.5+)
  $('btn-switchback').addEventListener('click', async () => {
    const canSwitchHelium = Boolean(currentConfig?.netProfile && (currentConfig.netProfile.weatherxmStored || currentConfig.netProfile.active === 0));
    if (!client || !client.isConnected || !canSwitchHelium || operationInFlight) return;
    if (!confirm('Switch this station to its Helium (WeatherXM) network profile (Profile 0)? Any custom Open LoRaWAN settings stay stored in Profile 1.')) return;
    operationInFlight = true;
    const btn = $<HTMLButtonElement>('btn-switchback');
    btn.disabled = true;
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const serialNum = currentConfig!.formattedDevEui || currentConfig!.deviceEui;
    const fwVer = currentConfig!.version;
    const backDetails = networkSwitchDetails(currentConfig);
    trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_started', firmware_target: 'weatherxm',
      firmware_source: fwVer, status: 'in_progress', details: backDetails });
    try {
      await client.switchBackToWeatherXm((stepDesc, current, total) => {
        $('progress-step-text').textContent = stepDesc;
        $('progress-bar').style.width = `${Math.round((current / total) * 100)}%`;
        addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
      });
      currentConfig = null;
      client = null;
      $('view-progress').classList.add('hidden');
      $('success-title').textContent = 'Back on the Helium (WeatherXM) network!';
      $('success-sub').textContent = 'The station restarted with its factory Helium (WeatherXM) network settings (Profile 0).';
      $('success-steps').classList.add('hidden');
      $('btn-ttn-export-success').classList.add('hidden');
      $('view-success').classList.remove('hidden');
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_completed', firmware_target: 'weatherxm',
        firmware_source: fwVer, status: 'success', details: backDetails });
    } catch (err) {
      const safeErr = redactTelemetryString((err as Error).message);
      addLog(`Switch back failed: ${safeErr}`, 'ERROR');
      if (client?.isConnected) {
        const refreshed = await client.readFullConfig().catch(() => null);
        if (refreshed) populateDeviceView(refreshed);
      } else {
        currentConfig = null;
      }
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_failed', firmware_target: 'weatherxm',
        firmware_source: fwVer, status: 'failed', details: { ...backDetails, error: safeErr } });
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = safeErr;
      formError.classList.remove('hidden');
    } finally {
      operationInFlight = false;
      btn.disabled = false;
    }
  });

  // Done button
  $('btn-done').addEventListener('click', () => {
    currentConfig = null;
    $('view-success').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
  });
</script>
