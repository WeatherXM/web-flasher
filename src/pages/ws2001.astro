---
import SiteLayout from '../layouts/SiteLayout.astro';
import BleBrowserNotice from '../components/ws1300/BleBrowserNotice.astro';
import { Code } from 'astro:components';
import { WS2001_UPLINK_DECODER } from '../lib/ble/ws2001UplinkDecoder';
---

<SiteLayout
  title="WS2001 (H2) Open LoRaWAN Configurator — WeatherXM"
  description="Configure your WeatherXM WS2001 (H2) weather station for The Things Network, ChirpStack, or generic LoRaWAN networks over Bluetooth."
  device="ws2001"
>
  <BleBrowserNotice />

  <!-- ===================== 1. Not connected: introduction + connect ===================== -->
  <section id="view-connect" class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-start">
      <div class="space-y-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-wxm-storm/40 border border-wxm-cloud/20 text-xs font-semibold text-white">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          WeatherXM network · Your own LoRaWAN (TTN, ChirpStack)
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight text-balance">
          Update and configure your WS2001 (H2)
        </h1>
        <p class="text-sm sm:text-base text-wxm-mist leading-relaxed">
          The H2 starts on the <strong>WeatherXM network</strong>. Connect over Bluetooth to update its firmware or to move it to
          The Things Network (TTN), ChirpStack or any other LoRaWAN network server with the <strong>Open Edition</strong> profile.
          It runs <strong>WeatherXM's own firmware</strong>, whose compact weather frame carries more data than the stock
          SenseCAP S2120 firmware, such as <strong>wind gust</strong> and <strong>rain total</strong>.
          Both network identities stay stored on the station, so you can switch back at any time.
        </p>
        <p class="text-sm">
          <a href="https://weatherxm.com/stations/" class="inline-flex items-center gap-1.5 font-semibold text-wxm-zenith hover:text-white underline underline-offset-4 decoration-wxm-cloud/30">
            Explore WeatherXM stations <span aria-hidden="true">&rarr;</span>
          </a>
          <span class="text-wxm-cloud/30 mx-2" aria-hidden="true">·</span>
          <a href="/decoders/ws2001_uplink_decoder.js" download="ws2001_uplink_decoder.js" class="inline-flex items-center gap-1.5 font-semibold text-wxm-zenith hover:text-white underline underline-offset-4 decoration-wxm-cloud/30">
            Payload decoder for your own network (.js)
          </a>
          <span class="text-wxm-cloud/30 mx-2" aria-hidden="true">·</span>
          <a href="/ws2001/changelog" class="inline-flex items-center gap-1.5 font-semibold text-wxm-zenith hover:text-white underline underline-offset-4 decoration-wxm-cloud/30">
            Firmware changelog
          </a>
        </p>
      </div>

      <div class="p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-beacon/40 backdrop-blur-md shadow-card space-y-5">
        <div class="flex items-center gap-5">
          <img
            src="/h2.webp"
            alt="WeatherXM WS2001 (H2) Weather Station"
            width="388"
            height="228"
            class="w-24 sm:w-28 h-auto flex-shrink-0 drop-shadow-[0_8px_16px_rgba(0,0,0,0.5)]"
          />
          <div class="space-y-1">
            <span class="text-[11px] font-extrabold text-wxm-zenith uppercase tracking-widest block">Step 1 · Bluetooth</span>
            <h2 class="text-lg font-bold">Connect to WS2001 (H2)</h2>
            <p class="text-xs text-wxm-mist">Make sure your station is powered on and within Bluetooth range.</p>
          </div>
        </div>

        <button
          id="btn-connect"
          type="button"
          class="w-full py-4 px-6 rounded-control text-base btn-primary-beacon flex items-center justify-center gap-3 cursor-pointer disabled:opacity-50 disabled:cursor-wait focus:outline-none focus-visible:ring-2 focus-visible:ring-wxm-zenith"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7l10 10-5 5V2l5 5L7 17" />
          </svg>
          <span id="btn-connect-label">Connect to WS2001 (H2)</span>
        </button>
        <button
          id="btn-cancel-connect"
          type="button"
          class="hidden w-full py-2 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-red-400/60 cursor-pointer"
        >
          Cancel and disconnect
        </button>
        <label class="flex items-start gap-2.5 text-xs text-wxm-mist leading-relaxed cursor-pointer select-none">
          <input id="chk-auto-update" type="checkbox" class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-beacon focus:ring-0 cursor-pointer" />
          <span><strong class="text-white">Update to the latest firmware as soon as I connect.</strong> Leave unchecked to review the station first and choose.</span>
        </label>
        <p id="connect-hint" class="hidden p-3 rounded-control bg-amber-500/10 border border-amber-400/40 text-xs text-amber-200 leading-relaxed" role="status"></p>
        <p id="connect-error" class="hidden text-xs text-red-300 leading-relaxed" role="alert"></p>
      </div>
    </div>

    <ol id="connect-steps" class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-3">
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">1</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Stand next to the station</h3>
          <p class="text-xs text-wxm-mist leading-relaxed">Stay within a few metres during the update. A laptop or an Android phone both work.</p>
        </div>
      </li>
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">2</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Press the station RESET button once <span class="block sm:inline text-xs font-medium text-wxm-mist">(first-time pairing only)</span></h3>
          <p class="text-xs text-wxm-mist leading-relaxed">
            If the station has never been paired before, press <strong class="text-white font-semibold">RESET</strong> once. You only need this for the initial pairing; new computers can pair during the first 5 minutes after the restart.
            <strong class="text-amber-300 font-semibold">Don't hold RESET:</strong> holding it for 10 seconds resets the station to factory settings.
          </p>
        </div>
      </li>
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">3</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Connect and pick "WeatherXM WS2001"</h3>
          <p class="text-xs text-wxm-mist leading-relaxed">Click Connect to WS2001 (H2) and select the station. If your computer asks to pair, accept it and let the pairing prompt finish.</p>
        </div>
      </li>
    </ol>
  </section>

  <!-- ===================== 2. Connected: station header, firmware, network choice ===================== -->
  <section id="view-device" class="hidden max-w-7xl mx-auto px-4 sm:px-8 space-y-5">
    <!-- Station header -->
    <div class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/30 backdrop-blur-md px-4 py-3 shadow-card flex flex-wrap items-center gap-x-6 gap-y-3">
      <div class="flex items-center gap-3 min-w-0">
        <img src="/h2.webp" alt="WS2001 (H2)" width="388" height="228" class="w-14 h-auto object-contain select-none" />
        <div class="space-y-1 min-w-0">
          <h2 id="dev-name" class="text-sm font-bold text-white leading-none truncate">WeatherXM WS2001 (H2)</h2>
          <span id="dev-link-pill" class="badge-status-green inline-flex items-center space-x-1.5">
            <span id="dev-link-dot" class="indicator-dot-green animate-pulse"></span>
            <span id="dev-link-text">Connected over Bluetooth</span>
          </span>
        </div>
      </div>

      <span class="hidden md:block w-px self-stretch bg-wxm-cloud/15"></span>

      <dl class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <div>
          <dt class="text-[11px] text-wxm-mist">DevEUI</dt>
          <dd class="flex items-center gap-1.5">
            <span id="stat-deveui" class="text-xs font-bold text-white font-mono select-all">–</span>
            <button
              id="btn-copy-deveui"
              type="button"
              title="Copy DevEUI"
              aria-label="Copy DevEUI"
              class="p-1 rounded text-wxm-mist hover:text-white hover:bg-wxm-storm/60 transition-colors cursor-pointer"
            >
              <svg id="icon-copy-deveui" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="label-copy-deveui" class="sr-only">Copy</span>
            </button>
          </dd>
        </div>
        <div>
          <dt class="text-[11px] text-wxm-mist">Firmware</dt>
          <dd id="stat-ver" class="text-xs font-bold text-white font-mono">–</dd>
        </div>
        <div>
          <dt class="text-[11px] text-wxm-mist">Active network</dt>
          <dd id="stat-mode" class="text-xs font-bold text-white">–</dd>
        </div>
        <div>
          <dt class="text-[11px] text-wxm-mist">LoRaWAN</dt>
          <dd id="stat-join" class="text-xs font-bold text-white">–</dd>
        </div>
        <div>
          <dt class="text-[11px] text-wxm-mist">Region</dt>
          <dd id="stat-band" class="text-xs font-bold text-white">–</dd>
        </div>
        <div>
          <dt class="text-[11px] text-wxm-mist">Upload interval</dt>
          <dd id="stat-interval" class="text-xs font-bold text-white">–</dd>
        </div>
        <div>
          <dt class="text-[11px] text-wxm-mist">Battery</dt>
          <dd id="stat-bat" class="text-xs font-bold text-white">–</dd>
        </div>
      </dl>

      <div class="ml-auto flex items-center gap-2">
        <button
          id="btn-refresh"
          type="button"
          title="Read the station's configuration and status again"
          class="px-3 py-2 rounded-control text-xs font-bold text-wxm-cloud border border-wxm-cloud/20 bg-wxm-midnight/80 hover:bg-wxm-storm/60 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg id="icon-refresh" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span id="label-refresh">Refresh</span>
        </button>
        <button
          id="btn-disconnect"
          type="button"
          title="Disconnect: the station restarts and rejoins its active network"
          class="px-3.5 py-2 rounded-control text-xs font-bold text-wxm-cloud border border-wxm-cloud/20 bg-wxm-midnight/80 hover:bg-wxm-error/20 hover:border-wxm-error/40 hover:text-wxm-error transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Disconnect</span>
        </button>
      </div>
    </div>

    <!-- Firmware strip -->
    <div id="fw-strip" class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/25 backdrop-blur-md shadow-card">
      <div class="px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-3">
        <div id="fw-strip-icon" class="w-9 h-9 shrink-0 rounded-control flex items-center justify-center bg-wxm-midnight/70 border border-wxm-cloud/20 text-wxm-mist">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p id="fw-strip-title" class="text-sm font-bold text-white">Checking for firmware updates...</p>
          <p id="fw-strip-sub" class="text-xs text-wxm-mist leading-relaxed mt-0.5"></p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            id="btn-fw-options"
            type="button"
            aria-expanded="false"
            aria-controls="fw-options"
            class="px-3 py-2 rounded-control text-xs font-bold text-wxm-cloud border border-wxm-cloud/20 bg-wxm-midnight/80 hover:bg-wxm-storm/60 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <span>Other versions</span>
            <svg id="fw-options-chevron" class="w-3.5 h-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <button
            id="btn-fw-update"
            type="button"
            disabled
            class="px-4 py-2 rounded-control text-xs btn-primary-beacon flex items-center gap-1.5 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
          >
            Update firmware
          </button>
        </div>
      </div>

      <div id="fw-options" class="hidden px-4 pb-4 pt-3 border-t border-wxm-cloud/10 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label for="cfg-fw-version" class="block text-[11px] font-bold text-wxm-cloud uppercase tracking-wider">Firmware version</label>
          <select
            id="cfg-fw-version"
            class="w-full bg-wxm-midnight border border-wxm-cloud/30 rounded-control py-2 px-3 text-xs text-white font-mono focus:outline-none focus:border-wxm-beacon"
          >
            <option value="latest">Latest release</option>
            <option value="custom">Custom signed package (-ble-dfu.zip)...</option>
          </select>
          <div id="fw-release-notes" class="hidden p-3 rounded-control bg-wxm-midnight/50 border border-wxm-cloud/10 space-y-1.5">
            <p id="fw-release-notes-title" class="text-[11px] font-bold text-wxm-cloud uppercase tracking-wider">–</p>
            <p id="fw-release-notes-summary" class="text-xs text-white leading-relaxed">–</p>
            <ul id="fw-release-notes-list" class="list-disc pl-4 text-[11px] text-wxm-mist leading-relaxed space-y-0.5"></ul>
            <p id="fw-release-notes-upgrade" class="hidden text-[11px] text-amber-200 leading-relaxed"></p>
            <a id="fw-release-notes-link" href="/ws2001/changelog" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[11px] font-semibold text-wxm-zenith hover:text-white underline underline-offset-2 decoration-wxm-cloud/30">
              Full release notes <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
          <div id="group-fw-custom" class="hidden space-y-1">
            <label for="cfg-fw-file" class="block text-xs font-semibold text-wxm-cloud">Signed DFU package (<span class="font-mono">-ble-dfu.zip</span>)</label>
            <input
              id="cfg-fw-file"
              type="file"
              accept=".zip,application/zip"
              class="w-full text-xs text-wxm-mist file:mr-3 file:py-1.5 file:px-3 file:rounded-control file:border file:border-wxm-cloud/20 file:text-xs file:font-semibold file:bg-wxm-storm/60 file:text-white hover:file:bg-wxm-storm cursor-pointer"
            />
          </div>
        </div>
        <div class="p-3 rounded-control bg-wxm-midnight/70 border border-wxm-cloud/10 text-[11px] text-wxm-mist leading-relaxed space-y-1.5">
          <p id="fw-version-note">The update keeps the station's settings, both network profiles and the rain total.</p>
          <p>The station's bootloader only accepts packages signed by WeatherXM and never installs an older version than the one it runs.</p>
        </div>
      </div>
    </div>

    <!-- Network setup tracker (Open Edition active, or right after switching to it) -->
    <div id="net-tracker" class="hidden rounded-card border-2 border-wxm-live/40 bg-wxm-storm/30 backdrop-blur-md shadow-card p-5" aria-live="polite">
      <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
        <div class="min-w-0">
          <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Open Edition</span>
          <h2 class="text-xl font-bold text-white tracking-tight">Your network setup</h2>
          <p id="tracker-sub" class="text-xs text-wxm-mist mt-0.5">–</p>
        </div>
        <span id="tracker-link" class="px-2.5 py-1 text-xs font-semibold rounded-full whitespace-nowrap border bg-wxm-live/15 border-wxm-live/50 text-wxm-live">Live over Bluetooth</span>
      </div>

      <p id="tracker-welcome" class="hidden mb-4 p-3 rounded-control bg-wxm-beacon/10 border border-wxm-beacon/30 text-xs text-wxm-cloud leading-relaxed"></p>

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)] gap-6">
        <ol id="tracker-steps" class="space-y-1">
          <li class="flex items-start gap-3 py-1.5"><span class="tstep-dot">1</span><div class="min-w-0"><p class="text-sm font-semibold text-white">Registered on your server</p><p class="tstep-sub text-[11px] text-wxm-mist">–</p></div></li>
          <li class="flex items-start gap-3 py-1.5"><span class="tstep-dot">2</span><div class="min-w-0"><p class="text-sm font-semibold text-white">Settings saved on the station</p><p class="tstep-sub text-[11px] text-wxm-mist">–</p></div></li>
          <li class="flex items-start gap-3 py-1.5"><span class="tstep-dot">3</span><div class="min-w-0"><p class="text-sm font-semibold text-white">Station restarted</p><p class="tstep-sub text-[11px] text-wxm-mist">–</p></div></li>
          <li class="flex items-start gap-3 py-1.5"><span class="tstep-dot">4</span><div class="min-w-0"><p class="text-sm font-semibold text-white">Joining your network</p><p class="tstep-sub text-[11px] text-wxm-mist">–</p></div></li>
          <li class="flex items-start gap-3 py-1.5"><span class="tstep-dot">5</span><div class="min-w-0"><p class="text-sm font-semibold text-white">Joined</p><p class="tstep-sub text-[11px] text-wxm-mist">–</p></div></li>
          <li class="flex items-start gap-3 py-1.5"><span class="tstep-dot">6</span><div class="min-w-0"><p class="text-sm font-semibold text-white">Data on your server</p><p class="tstep-sub text-[11px] text-wxm-mist">–</p></div></li>
        </ol>

        <div class="min-w-0">
          <div class="flex items-center gap-3">
            <div id="tracker-icon" class="w-9 h-9 shrink-0 rounded-full flex items-center justify-center border bg-wxm-beacon/15 border-wxm-beacon/40 text-wxm-zenith">
              <div id="tracker-spinner" class="w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"></div>
              <svg id="tracker-ok" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              <svg id="tracker-warn" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
            <div class="min-w-0">
              <h3 id="tracker-title" class="text-base font-bold text-white">–</h3>
              <p id="tracker-elapsed" class="text-xs text-wxm-mist">–</p>
            </div>
          </div>

          <div id="tracker-register" class="hidden mt-3 p-3.5 rounded-control bg-wxm-live/10 border border-wxm-live/40 space-y-2.5">
            <p class="text-sm font-bold text-white">Register the station on your network server</p>
            <p class="text-xs text-wxm-cloud leading-relaxed">
              The import file holds the settings you just saved on the station: DevEUI, JoinEUI, AppKey, LoRaWAN 1.0.4, the
              <span id="tracker-register-plan">frequency plan</span> and the payload decoder. In TTN open your application,
              <strong class="text-white">End devices &gt; Import end devices</strong>, choose <strong class="text-white">The Things Stack JSON</strong> and select the file.
              It joins as soon as it is registered. <span class="text-amber-300">The file holds your AppKey: keep it private.</span>
            </p>
            <button id="btn-tracker-register-ttn" type="button" class="px-4 py-2.5 rounded-control text-xs btn-primary-green inline-flex items-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-wait">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download TTN import file
            </button>
          </div>

          <p id="tracker-hint" class="mt-3 p-3 rounded-control bg-wxm-midnight/70 border border-wxm-cloud/10 text-xs text-wxm-cloud leading-relaxed">–</p>

          <dl class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2">
            <div class="p-2.5 rounded-control bg-wxm-abyss/60 border border-wxm-cloud/10"><dt class="text-[10px] uppercase tracking-wider text-wxm-mist font-semibold">LoRaWAN</dt><dd id="tm-lorawan" class="text-xs font-bold text-white mt-0.5">–</dd></div>
            <div class="p-2.5 rounded-control bg-wxm-abyss/60 border border-wxm-cloud/10"><dt id="tm-time-label" class="text-[10px] uppercase tracking-wider text-wxm-mist font-semibold">Since restart</dt><dd id="tm-time" class="text-xs font-bold text-white mt-0.5">–</dd></div>
