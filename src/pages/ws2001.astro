              class="w-full py-3 px-4 rounded-control text-sm btn-primary-green flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" /></svg>
              <span id="btn-apply-label">Switch to My Network</span>
            </button>
            <button id="btn-ttn-export-form" type="button" title="The Things Network: End devices > Import end devices > The Things Stack JSON. The file holds your AppKey: keep it private."
              class="w-full py-2 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-live/60 cursor-pointer inline-flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download TTN import file (.json, includes the decoder)
            </button>
          </div>
        </div>
      </div>

      <p id="form-error" class="hidden mt-4 p-3 rounded-control bg-red-500/10 border border-red-500/30 text-xs text-red-300 leading-relaxed font-semibold" role="alert"></p>
    </div>
  </section>

  <!-- ===================== 3. Operations in progress / results ===================== -->
  <section class="max-w-2xl mx-auto px-4 sm:px-8">
    <!-- Network switch progress -->
    <div id="view-progress" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin"></div>
        <div>
          <h3 class="text-sm font-bold text-white">Configuring the station...</h3>
          <p id="progress-step-text" class="text-xs text-wxm-mist">Applying LoRaWAN parameters over Bluetooth</p>
        </div>
      </div>
      <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
        <div id="progress-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
      </div>
    </div>

    <!-- Firmware update -->
    <div id="view-dfu" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
      <div class="flex items-center gap-3">
        <div id="dfu-spinner" class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin shrink-0"></div>
        <div class="min-w-0">
          <h3 id="dfu-title" class="text-sm font-bold text-white">Updating firmware</h3>
          <p id="dfu-step" class="text-xs text-wxm-mist leading-relaxed">Preparing...</p>
        </div>
      </div>
      <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
        <div id="dfu-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
      </div>
      <p id="dfu-detail" class="text-[11px] text-wxm-mist leading-relaxed">Keep the station powered and this device within a few metres until the update finishes.</p>
      <div id="dfu-name-hint" class="hidden p-3 rounded-control bg-wxm-abyss/80 border border-wxm-zenith/30 text-[11.5px] text-wxm-cloud leading-relaxed space-y-1">
        <p class="font-bold text-white">Look for a different name in the Bluetooth list</p>
        <p>
          In update mode the station is a separate Bluetooth device called
          <strong id="dfu-name-hint-value" class="font-mono text-wxm-zenith">DfuWX…</strong>
          (or <span class="font-mono">DfuTarg</span>), <strong>not</strong> "WeatherXM WS2001 …". Only update-mode devices are listed.
          It returns to its normal name after the update.
        </p>
      </div>
      <button id="btn-dfu-pick" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Continue: select the station's update mode</button>
      <button id="btn-dfu-reconnect" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Reconnect to the station</button>
      <button id="btn-dfu-close" type="button" class="hidden w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">Close</button>
    </div>

    <!-- Result -->
    <div id="view-success" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-emerald-500/50 backdrop-blur-md shadow-card space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        </div>
        <div>
          <h3 id="success-title" class="text-sm font-bold text-white">Connected to your network!</h3>
          <p id="success-sub" class="text-xs text-emerald-300">Settings written to flash. The station has rebooted to join your network.</p>
        </div>
      </div>
      <div id="success-steps" class="p-3.5 rounded-control bg-wxm-abyss/80 border border-wxm-cloud/10 text-xs text-wxm-mist space-y-2">
        <p><strong>Next steps:</strong></p>
        <ul class="list-disc pl-4 space-y-1">
          <li>Register the station in your network server (LoRaWAN 1.0.4, OTAA, Class A). On TTN, import the file below: <strong>End devices &gt; Import end devices &gt; The Things Stack JSON</strong>. It already includes the payload decoder.</li>
          <li>On ChirpStack, add the <strong>payload decoder</strong> to the device profile (Copy or Download below).</li>
          <li>Watch for the first Join-Request, typically within a minute after the restart. The station needs a reliable downlink to receive the Join-Accept.</li>
        </ul>
        <div class="flex flex-wrap items-center gap-1.5 pt-1">
          <span class="text-[11px] font-bold text-emerald-400 mr-1">Payload decoder:</span>
          <button id="btn-success-show-decoder" type="button" class="px-2.5 py-1 rounded-control text-[11px] font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-live/60 transition-all cursor-pointer inline-flex items-center gap-1">Show</button>
          <button id="btn-success-copy-decoder" type="button" class="px-2.5 py-1 rounded-control text-[11px] font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-live/60 transition-all cursor-pointer inline-flex items-center gap-1">Copy</button>
          <a href="/decoders/ws2001_uplink_decoder.js" download="ws2001_uplink_decoder.js" class="px-2.5 py-1 rounded-control text-[11px] font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-live/60 transition-all cursor-pointer inline-flex items-center gap-1">Download .js</a>
        </div>
      </div>
      <button id="btn-ttn-export-success" type="button" class="hidden w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith cursor-pointer inline-flex items-center justify-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
        Download TTN import file (.json)
      </button>
      <button id="btn-done" type="button" class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">
        Done
      </button>
    </div>
  </section>

  <dialog
    id="ttn-key-dialog"
    aria-labelledby="ttn-key-title"
    class="m-auto w-[min(32rem,calc(100vw-2rem))] rounded-card border border-wxm-cloud/20 bg-wxm-midnight p-0 text-white backdrop:bg-black/70"
  >
    <form id="ttn-key-form" method="dialog" class="p-5 space-y-4">
      <div>
        <h3 id="ttn-key-title" class="text-base font-bold">TTN import file for the saved settings</h3>
        <p class="text-xs text-wxm-mist leading-relaxed mt-1">
          The station never reveals its AppKey, so the file needs the AppKey you registered on your network server
          (in TTN: your end device &gt; Overview &gt; AppKey). Nothing is written to the station.
        </p>
      </div>
      <div>
        <label for="ttn-key-joineui" class="block text-xs font-semibold text-wxm-cloud mb-1">JoinEUI (read from the station)</label>
        <input id="ttn-key-joineui" type="text" maxlength="23" autocomplete="off" spellcheck="false"
          class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-live uppercase" />
      </div>
      <div>
        <label for="ttn-key-appkey" class="block text-xs font-semibold text-wxm-cloud mb-1">AppKey (32 hex)</label>
        <input id="ttn-key-appkey" type="text" maxlength="47" autocomplete="off" spellcheck="false" placeholder="00112233445566778899AABBCCDDEEFF"
          class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-live uppercase" />
        <p id="ttn-key-error" class="hidden text-xs text-red-300 mt-1" role="alert"></p>
      </div>
      <p class="text-[11px] text-wxm-mist leading-relaxed">
        Don't have it any more? <button id="btn-ttn-key-new" type="button" class="font-semibold text-emerald-300 hover:text-white underline underline-offset-2 cursor-pointer">Set a new AppKey instead</button>:
        the network settings form saves a new key on the station, and its import file carries the new key.
      </p>
      <div class="flex justify-end gap-2 pt-1">
        <button id="btn-ttn-key-cancel" type="button" class="px-4 py-2 rounded-control text-xs font-semibold text-wxm-cloud border border-wxm-cloud/20 bg-wxm-storm/50 hover:bg-wxm-storm cursor-pointer">Cancel</button>
        <button id="btn-ttn-key-download" type="submit" class="px-4 py-2 rounded-control text-xs btn-primary-green cursor-pointer">Download file</button>
      </div>
    </form>
  </dialog>

  <dialog
    id="decoder-dialog"
    aria-labelledby="decoder-dialog-title"
    class="m-auto w-[min(56rem,calc(100vw-2rem))] max-h-[85vh] rounded-card border border-wxm-cloud/20 bg-wxm-abyss p-0 text-white backdrop:bg-black/70"
  >
    <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-wxm-cloud/20">
      <h3 id="decoder-dialog-title" class="text-sm font-bold">ws2001_uplink_decoder.js</h3>
      <div class="flex items-center gap-2">
        <button id="btn-dialog-copy-decoder" type="button" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith cursor-pointer">Copy</button>
        <button id="btn-close-decoder" type="button" aria-label="Close" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">Close</button>
      </div>
    </div>
    <div class="overflow-auto max-h-[calc(85vh-3.5rem)] text-xs [&_pre]:p-4 [&_pre]:m-0">
      <Code code={WS2001_UPLINK_DECODER} lang="js" theme="github-dark" />
    </div>
  </dialog>

  <!-- ===================== Bluetooth console ===================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-8 mt-5">
    <div class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/25 backdrop-blur-md overflow-hidden shadow-card">
      <div class="px-5 py-3.5 bg-wxm-midnight/60 border-b border-wxm-cloud/15 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3 select-none">
          <button id="btn-toggle-log" type="button" aria-expanded="true" aria-controls="log-content-wrapper" class="flex items-center gap-2 text-xs font-bold text-white hover:text-wxm-zenith transition-colors cursor-pointer">
            <svg id="log-chevron" class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            <span class="whitespace-nowrap">Bluetooth &amp; Flasher Console</span>
          </button>
          <span class="text-xs text-wxm-mist font-mono whitespace-nowrap">(<span id="log-count">0</span> events)</span>
        </div>
        <div class="flex items-center gap-2.5">
          <button id="btn-clear-log" type="button" class="px-3 py-1.5 rounded-control text-xs font-bold text-wxm-mist hover:text-white border border-wxm-cloud/20 bg-wxm-storm/40 hover:bg-wxm-storm/80 transition-all flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            <span>Clear</span>
          </button>
          <button id="btn-download-log" type="button" class="px-3.5 py-1.5 rounded-control text-xs font-bold text-white border border-wxm-beacon/40 bg-wxm-beacon hover:bg-wxm-horizon transition-all flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Download .txt</span>
          </button>
        </div>
      </div>
      <div id="log-content-wrapper" class="p-4 bg-wxm-abyss/90">
        <div id="term-log" class="h-48 overflow-y-auto font-mono text-[11px] leading-relaxed text-wxm-cloud space-y-1">
          <div class="text-wxm-mist">[Ready] WS2001 Bluetooth configurator initialized. Waiting for a station connection...</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final Confirmation Modal -->
  <div id="modal-ws2001-confirm" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-wxm-ink/80 backdrop-blur-sm">
    <div class="max-w-md w-full rounded-modal border border-amber-500/40 bg-wxm-midnight p-6 shadow-2xl relative text-left space-y-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-control bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Confirm Network Migration</h3>
          <p class="text-xs text-amber-400 font-medium">Leaving the WeatherXM network</p>
        </div>
      </div>

      <div class="space-y-3 py-3 border-y border-wxm-cloud/15 text-xs text-wxm-cloud">
        <p class="text-[12px] text-white leading-relaxed">
          You are about to move <strong id="modal-confirm-deveui" class="font-mono text-wxm-zenith"></strong> from the WeatherXM network to your own LoRaWAN network server.
        </p>
        <div class="p-3 rounded-control bg-wxm-abyss/80 border border-amber-500/25 text-amber-200/90 text-[11.5px] space-y-1.5">
          <p class="font-bold text-amber-400">Please acknowledge before proceeding:</p>
          <ul class="list-disc list-inside space-y-1 text-amber-200/80">
            <li>While it is on your network, the station is off the WeatherXM network and does not earn $WXM token rewards.</li>
            <li id="modal-warn-keys">Checking whether this firmware can keep the WeatherXM keys...</li>
            <li>Its data does not appear in the WeatherXM app. The station can potentially return to the WeatherXM network later; contact WeatherXM support if needed.</li>
          </ul>
        </div>
      </div>

      <div class="flex items-start gap-2.5 pt-1">
        <input type="checkbox" id="chk-confirm-irreversible" class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-beacon focus:ring-0 cursor-pointer" />
        <label for="chk-confirm-irreversible" class="text-xs text-wxm-cloud cursor-pointer select-none leading-tight">
          I understand.
        </label>
      </div>

      <div class="pt-2 flex space-x-3 justify-end">
        <button
          id="btn-confirm-cancel"
          type="button"
          class="px-4 py-2.5 rounded-control text-xs font-semibold text-wxm-cloud hover:text-white border border-wxm-cloud/20 bg-wxm-storm/50 hover:bg-wxm-storm transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          id="btn-confirm-proceed"
          type="button"
          disabled
          class="px-5 py-2.5 rounded-control text-xs font-bold text-white bg-amber-600 hover:bg-amber-500 disabled:opacity-30 disabled:cursor-not-allowed shadow-card transition-all cursor-pointer"
        >
          Confirm & Switch
        </button>
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import { Ws2001AtClient, formatHexWithColons, type Ws2001DeviceConfig, type LoRaWanStatus, type StationMeasurements } from '../lib/ble/ws2001AtClient';
  import { WS2001_UPLINK_DECODER } from '../lib/ble/ws2001UplinkDecoder';
  import { trackTelemetry, redactTelemetryString } from '../lib/telemetry';
  import { ttnImportJson, ttnImportFileName, type TtnExportParams } from '../lib/ble/ws2001TtnExport';
  import { enterBootloader, requestBootloaderDevice, SecureDfuTransfer, makeBootloaderName, parseWs2001DfuPackage, type Ws2001DfuPackage } from '../lib/ble/ws2001Dfu';
  import { fetchWs2001Manifest, latestRelease, optInReleases, downloadWs2001Release, isOutdated, compareStationVersion, type Ws2001Release } from '../lib/ble/ws2001Firmware';
  import { ws2001ChangelogFor } from '../lib/ble/ws2001Changelog';

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };

  let client: Ws2001AtClient | null = null;
  let currentConfig: Ws2001DeviceConfig | null = null;
  let operationInFlight = false;

  // Published firmware releases (public/firmware/ws2001/manifest.json)
  let latest: Ws2001Release | null = null;
  let allReleases: Ws2001Release[] = [];
  let newerReleases: Ws2001Release[] = []; // published, but newer than latest: installed only when picked
  const fwVersionSelect = $<HTMLSelectElement>('cfg-fw-version');
  const fwFileInput = $<HTMLInputElement>('cfg-fw-file');

  const latestReady = fetchWs2001Manifest()
    .then((m) => {
      latest = latestRelease(m);
      allReleases = m.releases;
      newerReleases = optInReleases(m);
      fwVersionSelect.innerHTML = '';
      for (const r of m.releases) {
        const opt = document.createElement('option');
        opt.value = r.version;
        opt.textContent = r.version === m.latest
          ? `${r.label} (latest release)`
          : newerReleases.includes(r) ? `${r.label} (newer, opt-in)` : r.label;
        fwVersionSelect.appendChild(opt);
      }
      const customOpt = document.createElement('option');
      customOpt.value = 'custom';
      customOpt.textContent = 'Custom signed package (-ble-dfu.zip)...';
      fwVersionSelect.appendChild(customOpt);
      fwVersionSelect.value = m.latest;
    })
    .catch((e) => {
      latest = null;
      allReleases = [];
      newerReleases = [];
      console.warn('WS2001 firmware list unavailable', e);
    });

  // Demo data for layout work (dev server only, never in production builds): /ws2001?demo=old|wxm|custom|stored
  const demoMode = import.meta.env.DEV ? new URLSearchParams(location.search).get('demo') : null;

  const clearFormError = () => $('form-error').classList.add('hidden');

  // "Other versions" disclosure in the firmware strip
  const fwOptions = $('fw-options');
  const btnFwOptions = $<HTMLButtonElement>('btn-fw-options');
  function setFwOptionsOpen(open: boolean) {
    fwOptions.classList.toggle('hidden', !open);
    btnFwOptions.setAttribute('aria-expanded', open ? 'true' : 'false');
    $('fw-options-chevron').classList.toggle('rotate-180', open);
  }
  btnFwOptions.addEventListener('click', () => setFwOptionsOpen(fwOptions.classList.contains('hidden')));

  // Open Edition card on old firmware: update to the latest release first
  $('btn-goto-flash-v49').addEventListener('click', () => {
    if (latest) fwVersionSelect.value = latest.version;
    $('group-fw-custom').classList.add('hidden');
    if (currentConfig) updateFirmwarePanel(currentConfig);
    $<HTMLButtonElement>('btn-fw-update').click();
  });

  const termLog = $('term-log');
  const logCount = $('log-count');
  let logEvents = 0;

  const addLog = (msg: string, level = 'INFO') => {
    const row = document.createElement('div');
    const time = new Date().toTimeString().slice(0, 8);
    let color = 'text-wxm-mist';
    if (level === 'CMD') color = 'text-wxm-zenith font-bold';
    if (level === 'RESP') color = 'text-emerald-300';
    if (level === 'WARN') color = 'text-amber-300';
    if (level === 'ERROR') color = 'text-red-400 font-bold';

    row.className = color;
    row.textContent = `[${time}] ${redactTelemetryString(msg)}`;
    termLog.appendChild(row);
    termLog.scrollTop = termLog.scrollHeight;
    logCount.textContent = String(++logEvents);
  };

  // Payload decoder: Show / Copy in the Open Edition card, on the result screen and in the dialog.
  // Feedback goes on the clicked button itself.
  const copyDecoder = async (btn: HTMLElement): Promise<boolean> => {
    const label = btn.dataset.label ?? btn.textContent ?? 'Copy';
    btn.dataset.label = label;
    let ok = true;
    try {
      await navigator.clipboard.writeText(WS2001_UPLINK_DECODER);
      btn.textContent = 'Copied';
    } catch {
      ok = false;
      btn.textContent = 'Copy failed: use Download';
    }
    setTimeout(() => { btn.textContent = label; }, 2500);
    return ok;
  };
  const decoderDialog = $<HTMLDialogElement>('decoder-dialog');
  for (const id of ['btn-copy-decoder', 'btn-success-copy-decoder']) {
    $(id).addEventListener('click', (e) => void copyDecoder(e.currentTarget as HTMLElement));
  }
  for (const id of ['btn-show-decoder', 'btn-success-show-decoder']) {
    $(id).addEventListener('click', () => decoderDialog.showModal());
  }
  $('btn-close-decoder').addEventListener('click', () => decoderDialog.close());
  $('btn-dialog-copy-decoder').addEventListener('click', async (e) => {
    if (await copyDecoder(e.currentTarget as HTMLElement)) setTimeout(() => decoderDialog.close(), 600);
  });
  // Close when clicking the backdrop
  decoderDialog.addEventListener('click', (e) => {
    if (e.target === decoderDialog) decoderDialog.close();
  });

  $('btn-clear-log').addEventListener('click', () => {
    termLog.innerHTML = '<div class="text-wxm-mist">[Cleared]</div>';
    logEvents = 0;
    logCount.textContent = '0';
  });
  // Lines are already redacted by addLog (no AppKey or session keys)
  $('btn-download-log').addEventListener('click', () => {
    const text = Array.from(termLog.children).map((el) => el.textContent ?? '').join('\n') + '\n';
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
    a.download = `ws2001_log_${new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19)}.txt`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  $('btn-toggle-log').addEventListener('click', () => {
    const wrapper = $('log-content-wrapper');
    const collapsed = wrapper.classList.toggle('hidden');
    $('btn-toggle-log').setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    $('log-chevron').classList.toggle('-rotate-90', collapsed);
  });

  // Frequency band change handler (toggles sub-band selector)
  const bandSelect = $<HTMLSelectElement>('cfg-band');
  const groupSubband = $('group-subband');
  const updateSubbandVisibility = () => {
    const band = parseInt(bandSelect.value, 10);
    groupSubband.style.display = band === 8 || band === 1 ? 'block' : 'none';
  };
  bandSelect.addEventListener('change', updateSubbandVisibility);

  // Generate random 16-byte AppKey
  const generateRandomAppKey = () => {
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);
    const hex = Array.from(bytes)
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('')
      .toUpperCase();
    $<HTMLInputElement>('cfg-appkey').value = hex;
  };
  $('btn-gen-appkey').addEventListener('click', generateRandomAppKey);

  fwVersionSelect.addEventListener('change', () => {
    $('group-fw-custom').classList.toggle('hidden', fwVersionSelect.value !== 'custom');
    if (currentConfig) updateFirmwarePanel(currentConfig);
  });
  fwFileInput.addEventListener('change', () => {
    if (currentConfig) updateFirmwarePanel(currentConfig);
  });

  function getSelectedRelease(): Ws2001Release | null {
    const val = fwVersionSelect.value;
    if (val === 'custom') return null;
    return allReleases.find((r) => r.version === val) ?? latest;
  }

  const BADGE_BASE = 'px-2.5 py-1 text-xs font-semibold rounded-full whitespace-nowrap border ';
  const BADGE = {
    active: BADGE_BASE + 'bg-wxm-live/15 border-wxm-live/50 text-wxm-live',
    ready: BADGE_BASE + 'bg-wxm-midnight/70 border-wxm-cloud/25 text-wxm-cloud',
    warn: BADGE_BASE + 'bg-amber-500/15 border-amber-400/40 text-amber-300',
    off: BADGE_BASE + 'bg-wxm-midnight/70 border-wxm-cloud/15 text-wxm-mist',
  };
  const CARD_BASE = 'rounded-card border-2 bg-wxm-storm/30 p-5 flex flex-col justify-between transition-all shadow-card backdrop-blur-md ';
  const BTN_PRIMARY_BLUE = 'w-full py-3 px-4 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed';
  const BTN_SECONDARY = 'w-full py-3 px-4 rounded-control text-sm font-bold text-white bg-wxm-midnight/80 border border-wxm-cloud/25 hover:bg-wxm-storm/70 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed';

  function setBadge(id: string, text: string, tone: keyof typeof BADGE) {
    const el = $(id);
    el.textContent = text;
    el.className = BADGE[tone];
  }

  function updateModeDisplay(cfg: Ws2001DeviceConfig) {
    const profiles = cfg.netProfile;
    const onCustom = profiles ? profiles.active === 1 : cfg.testModeType === 1;
    const wxmStored = Boolean(profiles && (profiles.weatherxmStored || profiles.active === 0));
    const customStored = Boolean(profiles?.customStored);

    // Header readout
    const modeEl = $('stat-mode');
    if (profiles || cfg.testModeType !== null) {
      modeEl.textContent = onCustom ? 'Open Edition (your LoRaWAN)' : 'WeatherXM';
      modeEl.className = `text-xs font-bold ${onCustom ? 'text-wxm-live' : 'text-wxm-zenith'}`;
    } else {
      modeEl.textContent = 'Unknown';
      modeEl.className = 'text-xs font-bold text-wxm-mist';
    }
    if (cfg.testModeType === 1) modeEl.textContent += ' · legacy FPort 3';
    const joinEl = $('stat-join');
    const st = cfg.lorawanStatus;
    joinEl.textContent = st === 'JOINED' ? 'Joined' : st === 'JOINING' ? 'Joining...' : st ? st.charAt(0) + st.slice(1).toLowerCase() : 'Unknown';
    joinEl.className = `text-xs font-bold ${st === 'JOINED' ? 'text-wxm-live' : st === 'JOINING' ? 'text-amber-300' : 'text-wxm-mist'}`;

    // Highlight the card of the active network
    $('card-wxm').className = CARD_BASE + (onCustom ? 'border-wxm-cloud/15' : 'border-wxm-beacon/60');
    $('card-open').className = CARD_BASE + (onCustom ? 'border-wxm-live/60' : 'border-wxm-cloud/15');

    const keysText = profiles
      ? profiles.weatherxmStored
        ? 'The WeatherXM identity stays stored as profile 0; your settings go into profile 1.'
        : 'Switching saves the current WeatherXM identity as profile 0 before profile 1 is activated.'
      : 'This firmware has a single network identity: update it first so the WeatherXM identity is kept.';
    $('warn-keys').textContent = keysText;
    $('modal-warn-keys').textContent = keysText;

    // --- WeatherXM card ---
    const btnSwitchBack = $<HTMLButtonElement>('btn-switchback');
    const heliumTitle = $('helium-status-title');
    const heliumDesc = $('helium-status-desc');
    if (!profiles) {
      setBadge('badge-wxm-status', onCustom ? 'Not stored' : 'Active on station', onCustom ? 'warn' : 'active');
      heliumTitle.textContent = onCustom ? 'This station was moved with an older tool' : 'The station is on the WeatherXM network';
      heliumDesc.textContent = onCustom
        ? 'Its firmware keeps one network identity, so the WeatherXM keys may have been replaced. Update the firmware, then contact WeatherXM support if the WeatherXM profile is not available.'
        : `Firmware ${cfg.version} keeps a single network identity. Update the firmware before trying your own network, so this identity is kept.`;
      btnSwitchBack.disabled = true;
      btnSwitchBack.className = BTN_SECONDARY;
      btnSwitchBack.textContent = onCustom ? 'Update the firmware first' : 'Active — nothing to do';
    } else if (!wxmStored) {
      setBadge('badge-wxm-status', 'Not stored', 'warn');
      heliumTitle.textContent = 'No WeatherXM identity on this station';
      heliumDesc.textContent = 'Profile 0 is empty. Contact WeatherXM support to provision the station again.';
      btnSwitchBack.disabled = true;
      btnSwitchBack.className = BTN_SECONDARY;
      btnSwitchBack.textContent = 'WeatherXM profile unavailable';
    } else if (onCustom) {
      setBadge('badge-wxm-status', 'Stored · ready', 'ready');
      heliumTitle.textContent = 'Ready to switch back';
      heliumDesc.textContent = 'The original WeatherXM keys and 3-minute interval are stored in profile 0. Nothing needs to be entered; your own network settings stay saved in profile 1.';
      btnSwitchBack.disabled = false;
      btnSwitchBack.className = BTN_PRIMARY_BLUE;
      btnSwitchBack.textContent = 'Switch Back to WeatherXM';
    } else {
      setBadge('badge-wxm-status', 'Active on station', 'active');
      heliumTitle.textContent = 'The station reports to WeatherXM';
      heliumDesc.textContent = st === 'JOINED'
        ? 'It has joined the network. Nothing to do here.'
        : 'If it does not join, rejoin below: the station restarts and sends a fresh Join-Request.';
      btnSwitchBack.disabled = false;
      btnSwitchBack.className = BTN_SECONDARY;
      btnSwitchBack.textContent = 'Rejoin the WeatherXM Network';
    }

    // --- Open Edition card ---
    const oldFw = !profiles;
    $('open-old-fw-ver').textContent = cfg.version || 'this version';
    $('open-old-fw-banner').classList.toggle('hidden', !oldFw);
    $<HTMLFieldSetElement>('open-form').disabled = oldFw;
    const formDetails = $<HTMLDetailsElement>('open-form-details');
    $<HTMLButtonElement>('btn-apply').disabled = oldFw;
    $<HTMLButtonElement>('btn-ttn-export-form').disabled = oldFw;

    $('group-switch-open-stored').classList.toggle('hidden', !customStored);
    const btnSwitchOpenStored = $<HTMLButtonElement>('btn-switch-open-stored');
    btnSwitchOpenStored.disabled = !customStored;
    if (oldFw) {
      setBadge('badge-open-status', onCustom ? 'Active on station' : 'Needs update', onCustom ? 'active' : 'warn');
      formDetails.open = false;
    } else if (onCustom) {
      setBadge('badge-open-status', 'Active on station', 'active');
      $('open-stored-title').textContent = 'The station reports to your network';
      $('open-stored-desc').textContent = 'Rejoin with the saved settings, or change them below and save. You can download the TTN import file again: the station keeps its AppKey secret, so you enter it.';
      btnSwitchOpenStored.textContent = 'Rejoin My Network';
      formDetails.open = false;
    } else if (customStored) {
      setBadge('badge-open-status', 'Settings saved', 'ready');
      $('open-stored-title').textContent = 'Your network settings are saved on the station';
      $('open-stored-desc').textContent = 'Switch to them in one click, or change them below. After the switch you can download the TTN import file again by entering your AppKey.';
      btnSwitchOpenStored.textContent = 'Switch to My Saved Network';
      formDetails.open = false;
    } else {
      setBadge('badge-open-status', 'Ready to set up', 'off');
      formDetails.open = true;
    }
    $('btn-apply-label').textContent = onCustom ? 'Save Settings & Rejoin My Network' : customStored ? 'Save New Settings & Switch' : 'Switch to My Network';
    $('btn-open-stored-ttn').classList.toggle('hidden', !(onCustom && customStored));
    $('open-form-key-note').classList.toggle('hidden', !customStored);
    syncApplyArea();
  }

  // With settings already saved on the station, the form's submit buttons appear only when the form is opened,
  // so the one-click "saved network" button is never confused with replacing the saved keys.
  function syncApplyArea() {
    const customStored = Boolean(currentConfig?.netProfile?.customStored);
    const open = $<HTMLDetailsElement>('open-form-details').open;
    $('open-apply-area').classList.toggle('hidden', customStored && !open);
  }
  $('open-form-details').addEventListener('toggle', syncApplyArea);

  const FW_STRIP_BASE = 'rounded-card border backdrop-blur-md shadow-card ';
  const FW_ICON_BASE = 'w-9 h-9 shrink-0 rounded-control flex items-center justify-center border ';
  function setFwStripTone(tone: 'update' | 'ok' | 'neutral') {
    $('fw-strip').className = FW_STRIP_BASE + (tone === 'update'
      ? 'border-amber-400/40 bg-amber-500/10'
      : 'border-wxm-cloud/15 bg-wxm-storm/25');
    $('fw-strip-icon').className = FW_ICON_BASE + (tone === 'update'
      ? 'bg-amber-500/15 border-amber-400/40 text-amber-300'
      : tone === 'ok'
        ? 'bg-wxm-live/15 border-wxm-live/40 text-wxm-live'
        : 'bg-wxm-midnight/70 border-wxm-cloud/20 text-wxm-mist');
  }

  // Release notes for the version picked under "Other versions" (src/lib/ble/ws2001Changelog.ts)
  function renderReleaseNotes(r: Ws2001Release | null) {
    const entry = r ? ws2001ChangelogFor(r.version) : null;
    $('fw-release-notes').classList.toggle('hidden', !entry);
    if (!r || !entry) return;
    const optIn = newerReleases.includes(r);
    $('fw-release-notes-title').textContent = `What's in ${r.label}${optIn ? ' (preview)' : ''}`;
    $('fw-release-notes-summary').textContent = entry.summary;
    const list = $('fw-release-notes-list');
    list.replaceChildren(...entry.changes.map((c) => {
      const li = document.createElement('li');
      li.textContent = c.title;
      return li;
    }));
    const upgrade = $('fw-release-notes-upgrade');
    upgrade.textContent = entry.upgradeNote ? `Before you install: ${entry.upgradeNote}` : '';
    upgrade.classList.toggle('hidden', !entry.upgradeNote);
    $<HTMLAnchorElement>('fw-release-notes-link').href = `/ws2001/changelog#v${r.version.replace('.', '-')}`;
  }

  function updateFirmwarePanel(cfg: Ws2001DeviceConfig) {
    renderReleaseNotes(fwVersionSelect.value === 'custom' ? null : getSelectedRelease());
    const btn = $<HTMLButtonElement>('btn-fw-update');
    const title = $('fw-strip-title');
    const sub = $('fw-strip-sub');
    const note = $('fw-version-note');
    const BTN_UPDATE = 'px-4 py-2 rounded-control text-xs btn-primary-beacon flex items-center gap-1.5 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed';
    const BTN_QUIET = 'px-4 py-2 rounded-control text-xs font-bold text-white bg-wxm-midnight/80 border border-wxm-cloud/25 hover:bg-wxm-storm/70 flex items-center gap-1.5 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed';

    // Summary: the station against the latest published release
    const vsLatest = latest ? compareStationVersion(cfg.version, latest.version) : 'unknown';
    if (!latest) {
      setFwStripTone('neutral');
      title.textContent = `Firmware ${cfg.version}`;
      sub.textContent = 'The list of published firmware could not be loaded. Check your connection and reload the page.';
    } else if (vsLatest === 'older') {
      setFwStripTone('update');
      title.textContent = `Firmware update available: ${cfg.version} → ${latest.label}`;
      sub.textContent = cfg.netProfile
        ? 'Takes about a minute over Bluetooth. Settings, both network profiles and the rain total are kept.'
        : 'Needed before using your own network: it stores the WeatherXM identity as profile 0. Takes about a minute; settings and the rain total are kept.';
    } else if (vsLatest === 'equal') {
      setFwStripTone('ok');
      title.textContent = `Firmware ${cfg.version} is up to date`;
      sub.textContent = newerReleases.length
        ? `The station runs the latest release. ${newerReleases[0].label} is also available under Other versions.`
        : 'The station runs the latest published release.';
    } else if (vsLatest === 'newer') {
      setFwStripTone('ok');
      title.textContent = `Firmware ${cfg.version}`;
      sub.textContent = allReleases.some((r) => compareStationVersion(cfg.version, r.version) === 'equal')
        ? `A newer, opt-in release than the default ${latest.label}.`
        : `Newer than the published ${latest.label} (test build).`;
    } else {
      setFwStripTone('neutral');
      title.textContent = 'Firmware version unknown';
      sub.textContent = 'Click Refresh to read it again.';
    }

    // Action: whatever is selected under "Other versions" (the latest release by default)
    if (fwVersionSelect.value === 'custom') {
      const file = fwFileInput.files?.[0];
      btn.className = BTN_UPDATE;
      btn.textContent = file ? `Flash ${file.name}` : 'Choose a .zip file';
      btn.disabled = !file;
      note.textContent = 'A custom package must be signed with the WS2001 key and have a version equal to or higher than the station.';
      return;
    }
    const selected = getSelectedRelease();
    if (!selected) {
      btn.className = BTN_QUIET;
      btn.textContent = 'Update firmware';
      btn.disabled = true;
      return;
    }
    const cmp = compareStationVersion(cfg.version, selected.version);
    if (cmp === 'older') {
      btn.className = BTN_UPDATE;
      btn.textContent = `Update to ${selected.label}`;
      btn.disabled = false;
      note.textContent = 'The update keeps the station\'s settings, both network profiles and the rain total.';
    } else if (cmp === 'equal') {
      btn.className = BTN_QUIET;
      btn.textContent = `Reinstall ${selected.label}`;
      btn.disabled = false;
      note.textContent = 'Reinstalling the same version keeps the network profiles and the rain total.';
    } else if (cmp === 'newer') {
      btn.className = BTN_QUIET;
      btn.textContent = `${selected.label} is older`;
      btn.disabled = true;
      note.textContent = 'The bootloader does not install an older version than the one the station runs.';
    } else {
      btn.className = BTN_QUIET;
      btn.textContent = `Update to ${selected.label}`;
      btn.disabled = true;
    }
  }

  // What the WeatherXM backend needs to unprovision / re-provision the station on its LNS
  // (Helium ChirpStack / LoneStar). serial_number on the event is the DevEUI.
  function networkSwitchDetails(cfg: Ws2001DeviceConfig | null) {
    const wxmActive = cfg?.netProfile ? cfg.netProfile.active === 0 : cfg?.testModeType !== 1;
    return {
      model: cfg?.deviceModel || 'H2',
      bleName: cfg?.bleName,
      defEui: cfg?.formattedDefEui || cfg?.defEui,
      devAddr: cfg?.devAddr,
      hardwareVersion: cfg?.hardwareVersion,
      lorawanVersion: cfg?.lorawanVersion,
      firmwareVersion: cfg?.version,
      keysKept: Boolean(cfg?.netProfile && (cfg.netProfile.weatherxmStored || cfg.netProfile.active === 0)),
      fromNetwork: wxmActive ? 'weatherxm' : 'open_lorawan',
      wxmJoinEui: wxmActive ? cfg?.appEui ?? null : null,
    };
  }

  // GNSS on a customer network needs V4.7+ (DeviceTimeReq, no FPort 199 services)
  function gnssAllowed(): boolean {
    if (!currentConfig) return false;
    const cmp = compareStationVersion(currentConfig.version, '4.7');
    return cmp === 'equal' || cmp === 'newer';
  }

  function populateDeviceView(cfg: Ws2001DeviceConfig) {
    currentConfig = cfg;
    const gnssBox = $<HTMLInputElement>('cfg-gnss');
    gnssBox.disabled = !gnssAllowed();
    gnssBox.checked = gnssAllowed() && cfg.gnssSwitch === true;
    $('cfg-gnss-note').classList.toggle('hidden', gnssAllowed());
    updateFirmwarePanel(cfg);

    // Populate Device Status Card
    const devLabel = client?.deviceName || 'Station';
    $('dev-name').textContent = devLabel;
    $('stat-deveui').textContent = cfg.formattedDevEui;
    $('stat-band').textContent = cfg.frequencyName;
    $('stat-ver').textContent = cfg.version;
    $('stat-bat').textContent = cfg.battery;
    $('stat-interval').textContent = cfg.uploadInterval !== null ? `${cfg.uploadInterval} min` : 'Unknown';

    updateModeDisplay(cfg);

    clearFormError();

    // Open Edition active: show the live network setup tracker (revisit); otherwise stop it
    const onOpenEdition = cfg.netProfile?.active === 1;
    if (onOpenEdition && tracker.phase === 'off') startTracker('revisit');
    else if (!onOpenEdition && tracker.phase !== 'off') stopTracker();
    else if (tracker.phase !== 'off') renderTracker();

    if (!demoMode) trackTelemetry({
      device_type: 'ws2001',
      serial_number: cfg.formattedDevEui || cfg.deviceEui,
      action: 'connected',
      firmware_source: cfg.version,
      status: 'success',
      details: {
        model: cfg.deviceModel,
        bleName: cfg.bleName,
        bleId: cfg.bleId,
        defEui: cfg.formattedDefEui || cfg.defEui,
        devAddr: cfg.devAddr,
        appEui: cfg.appEui,
        hardwareVersion: cfg.hardwareVersion,
        lorawanVersion: cfg.lorawanVersion,
        classType: cfg.classType,
        joinType: cfg.joinType,
        battery: cfg.battery,
        intervalMinutes: cfg.uploadInterval,
        mode: cfg.testModeType === 0 ? 'weatherxm' : cfg.testModeType === 1 ? 'open_lorawan' : 'unknown',
        netProfile: cfg.netProfile ? cfg.netProfile.active : null,
        band: cfg.frequencyName,
      },
    });

    // Prepopulate form with device current band
    if (cfg.frequencyBand !== null) {
      bandSelect.value = String(cfg.frequencyBand);
    }
    if (cfg.subBand !== null) {
      $<HTMLSelectElement>('cfg-subband').value = String(cfg.subBand);
    }
    updateSubbandVisibility();

    // Keep the TTN-friendly default unless the station is already on the customer's network
    const alreadyCustom = cfg.netProfile ? cfg.netProfile.active === 1 : cfg.testModeType === 1;
    if (cfg.uploadInterval !== null && alreadyCustom) {
      const intervalSelect = $<HTMLSelectElement>('cfg-interval');
      const val = String(cfg.uploadInterval);
      const hasOption = Array.from(intervalSelect.options).some((opt) => opt.value === val);
      if (!hasOption) {
        const customOpt = document.createElement('option');
        customOpt.value = val;
        const fairUseNote = cfg.uploadInterval < 5 ? ' — exceeds TTN fair use' : '';
        customOpt.textContent = `${cfg.uploadInterval} minutes (current${fairUseNote})`;
        intervalSelect.appendChild(customOpt);
      }
      intervalSelect.value = val;
    }

    // Never pre-fill the WeatherXM JoinEUI into a form meant for the customer's network
    if (alreadyCustom && cfg.appEui && cfg.appEui.length === 16) {
      $<HTMLInputElement>('cfg-joineui').value = cfg.appEui;
    } else {
      $<HTMLInputElement>('cfg-joineui').value = '0000000000000000';
    }

    // Pre-generate a random 16-byte AppKey if empty so first-time Open LoRaWAN setup requires zero typing
    const appKeyInput = $<HTMLInputElement>('cfg-appkey');
    if (!appKeyInput.value.trim()) {
      generateRandomAppKey();
    }
  }

  // Connect button handler
  const btnConnect = $<HTMLButtonElement>('btn-connect');
  const connectError = $('connect-error');

  // Cancel a connect that hangs (e.g. the OS stuck mid-pairing): drops the link so the next try starts clean
  const btnCancelConnect = $<HTMLButtonElement>('btn-cancel-connect');
  let cancelConnect: (() => void) | null = null;
  btnCancelConnect.addEventListener('click', () => cancelConnect?.());

  btnConnect.addEventListener('click', async () => {
    connectError.classList.add('hidden');
    btnConnect.disabled = true;
    $('btn-connect-label').textContent = 'Connecting...';
    btnCancelConnect.classList.remove('hidden');

    client = new Ws2001AtClient((msg, lvl) => addLog(msg, lvl));
    const connectHint = $('connect-hint');
    client.onHint = (text) => {
      connectHint.textContent = text ?? '';
      connectHint.classList.toggle('hidden', !text);
    };
    const cancelled = new Promise<never>((_, reject) => {
      cancelConnect = () => reject(new Error('Connection cancelled. Wait a few seconds, then connect again.'));
    });

    try {
      const cfg = await Promise.race([
        (async () => {
          await client!.connect();
          addLog('Connection established. Querying station info...');
          return client!.readFullConfig();
        })(),
        cancelled,
      ]);
      await latestReady;
      populateDeviceView(cfg);

      // Show device view
      $('view-connect').classList.add('hidden');
      $('connect-steps').classList.add('hidden');
      $('view-device').classList.remove('hidden');

      if (chkAutoUpdate.checked && latest && isOutdated(cfg.version, latest.version)) {
        addLog(`Station runs ${cfg.version}; updating to ${latest.label} automatically (option enabled).`, 'INFO');
        void runFirmwareUpdate('auto');
      }
    } catch (err) {
      addLog((err as Error).message, 'ERROR');
      connectError.textContent = (err as Error).message;
      connectError.classList.remove('hidden');
      // Release a half-open link so the next attempt starts clean
      await client?.disconnect().catch(() => {});
      client = null;
    } finally {
      cancelConnect = null;
      $('connect-hint').classList.add('hidden');
      btnCancelConnect.classList.add('hidden');
      btnConnect.disabled = false;
      $('btn-connect-label').textContent = 'Connect to WS2001 (H2)';
    }
  });

  // Copy DevEUI button with local inline feedback
  let copyDevEuiTimer: ReturnType<typeof setTimeout> | null = null;
  $('btn-copy-deveui').addEventListener('click', async () => {
    if (currentConfig?.deviceEui && currentConfig.deviceEui !== 'Unknown') {
      await navigator.clipboard.writeText(currentConfig.deviceEui);
      const btn = $<HTMLButtonElement>('btn-copy-deveui');
      const label = $('label-copy-deveui');
      const icon = $('icon-copy-deveui');

      label.textContent = 'Copied!';
      btn.classList.add('text-emerald-400', 'border-emerald-500/40');
      btn.classList.remove('text-wxm-mist');
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />';

      if (copyDevEuiTimer) clearTimeout(copyDevEuiTimer);
      copyDevEuiTimer = setTimeout(() => {
        label.textContent = 'Copy';
        btn.classList.remove('text-emerald-400', 'border-emerald-500/40');
        btn.classList.add('text-wxm-mist');
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />';
      }, 2000);
    }
  });

  // Refresh button handler
  $('btn-refresh').addEventListener('click', async () => {
    if (!client || !client.isConnected || operationInFlight) return;
    operationInFlight = true;
    const btnRefresh = $<HTMLButtonElement>('btn-refresh');
    const iconRefresh = $('icon-refresh');
    const labelRefresh = $('label-refresh');

    btnRefresh.disabled = true;
    iconRefresh.classList.add('animate-spin');
    labelRefresh.textContent = 'Refreshing...';

    try {
      addLog('Refreshing station configuration (AT+CONFIG=?, AT+TESTMODE_TYPE=?)...', 'INFO');
      const cfg = await client.readFullConfig();
      populateDeviceView(cfg);
      addLog('Station info refreshed successfully.', 'SUCCESS');
    } catch (err) {
      addLog(`Failed to refresh station info: ${(err as Error).message}`, 'WARN');
    } finally {
      operationInFlight = false;
      btnRefresh.disabled = false;
      iconRefresh.classList.remove('animate-spin');
      labelRefresh.textContent = 'Refresh';
    }
  });

  // Disconnect button handler
  $('btn-disconnect').addEventListener('click', async () => {
    stopTracker();
    operationInFlight = false;
    addLog('Disconnecting Bluetooth... Station will reboot and send a fresh LoRaWAN Join-Request.', 'INFO');
    if (client) {
      await client.disconnect();
      client = null;
    }
    currentConfig = null;
    $('view-device').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
  });

  // Apply configuration button
  const btnApply = $<HTMLButtonElement>('btn-apply');
  const formError = $('form-error');

  const modalConfirm = $('modal-ws2001-confirm');
  const modalConfirmDevEui = $('modal-confirm-deveui');
  const chkConfirm = $<HTMLInputElement>('chk-confirm-irreversible');
  const btnConfirmCancel = $<HTMLButtonElement>('btn-confirm-cancel');
  const btnConfirmProceed = $<HTMLButtonElement>('btn-confirm-proceed');

  // TTN import file (generated in the browser only, it contains the AppKey)
  let lastTtnExport: TtnExportParams | null = null;
  function downloadTtnImport(params: TtnExportParams): void {
    const blob = new Blob([ttnImportJson(params)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = ttnImportFileName(params);
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    addLog(`Saved ${a.download} for The Things Network import (contains the AppKey).`, 'INFO');
    saveSetup(params.devEui, { ttnFileAt: Date.now() });
    if (tracker.phase !== 'off') renderTracker();
  }
  function ttnExportFromForm(): TtnExportParams {
    const devEui = currentConfig?.deviceEui || currentConfig?.formattedDevEui;
    if (!devEui || devEui === 'Unknown') throw new Error('Connect to a station first: its DevEUI is needed.');
    return {
      devEui,
      joinEui: $<HTMLInputElement>('cfg-joineui').value.trim(),
      appKey: $<HTMLInputElement>('cfg-appkey').value.trim(),
      band: parseInt(bandSelect.value, 10),
      subBand: parseInt($<HTMLSelectElement>('cfg-subband').value, 10),
    };
  }
  $('btn-ttn-export-form').addEventListener('click', () => {
    formError.classList.add('hidden');
    try {
      downloadTtnImport(ttnExportFromForm());
    } catch (e) {
      formError.textContent = (e as Error).message;
      formError.classList.remove('hidden');
    }
  });
  /**
   * TTN import file for the network settings the station runs now (profile 1). Uses this visit's form
   * values when they belong to this station. Otherwise (e.g. after "Rejoin my network", which writes
   * no keys) the JoinEUI comes from the station and the user enters the AppKey: the firmware never
   * reveals it (AT+APPKEY=? is disabled).
   */
  const ttnKeyDialog = $<HTMLDialogElement>('ttn-key-dialog');
  const ttnKeyError = $('ttn-key-error');
  async function downloadTtnImportFromStation(btn: HTMLButtonElement) {
    const devEui = currentConfig?.deviceEui;
    if (!devEui || devEui === 'Unknown') return;
    if (lastTtnExport && lastTtnExport.devEui.replace(/[^0-9a-fA-F]/g, '').toUpperCase() === devEui.toUpperCase()) {
      downloadTtnImport(lastTtnExport);
      return;
    }
    if (currentConfig?.netProfile?.active !== 1) {
      addLog('Switch the station to your network first: the file describes the settings it runs.', 'WARN');
      return;
    }
    let joinEui = (currentConfig.appEui ?? '').replace(/[^0-9a-fA-F]/g, '').toUpperCase();
    if (joinEui.length !== 16 && client?.isConnected && !operationInFlight) {
      operationInFlight = true;
      btn.disabled = true;
      try {
        joinEui = await client.readActiveJoinEui();
      } catch (e) {
        addLog(`${(e as Error).message} Enter it below.`, 'WARN');
      } finally {
        operationInFlight = false;
        btn.disabled = false;
      }
    }
    $<HTMLInputElement>('ttn-key-joineui').value = joinEui.length === 16 ? joinEui : '';
    $<HTMLInputElement>('ttn-key-appkey').value = '';
    ttnKeyError.classList.add('hidden');
    ttnKeyDialog.showModal();
    $<HTMLInputElement>('ttn-key-appkey').focus();
  }
  $('ttn-key-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const devEui = currentConfig?.deviceEui;
    if (!devEui || !currentConfig) { ttnKeyDialog.close(); return; }
    const joinEui = $<HTMLInputElement>('ttn-key-joineui').value.replace(/[^0-9a-fA-F]/g, '').toUpperCase();
    const appKey = $<HTMLInputElement>('ttn-key-appkey').value.replace(/[^0-9a-fA-F]/g, '').toUpperCase();
    const fail = (msg: string) => { ttnKeyError.textContent = msg; ttnKeyError.classList.remove('hidden'); };
    if (joinEui.length !== 16) return fail('The JoinEUI needs 16 hexadecimal characters.');
    if (appKey.length !== 32) return fail('The AppKey needs 32 hexadecimal characters.');
    lastTtnExport = { devEui, joinEui, appKey, band: currentConfig.frequencyBand ?? parseInt(bandSelect.value, 10), subBand: currentConfig.subBand ?? 1 };
    ttnKeyDialog.close();
    downloadTtnImport(lastTtnExport);
  });
  for (const id of ['ttn-key-joineui', 'ttn-key-appkey']) {
    $(id).addEventListener('input', () => ttnKeyError.classList.add('hidden'));
  }
  $('btn-ttn-key-cancel').addEventListener('click', () => ttnKeyDialog.close());
  ttnKeyDialog.addEventListener('click', (e) => { if (e.target === ttnKeyDialog) ttnKeyDialog.close(); });
  $('btn-ttn-key-new').addEventListener('click', () => {
    ttnKeyDialog.close();
    setNetworkChoiceCollapsed(false);
    const details = $<HTMLDetailsElement>('open-form-details');
    details.open = true;
    details.scrollIntoView({ behavior: 'smooth', block: 'start' });
    $<HTMLInputElement>('cfg-appkey').focus({ preventScroll: true });
  });
  $('btn-open-stored-ttn').addEventListener('click', (e) => void downloadTtnImportFromStation(e.currentTarget as HTMLButtonElement));

  $('btn-ttn-export-success').addEventListener('click', () => {
    if (lastTtnExport) downloadTtnImport(lastTtnExport);
  });

  let pendingMigrationParams: {
    band: number;
    subBand: number;
    joinEui: string;
    appKey: string;
    intervalMinutes: number;
    gnss: boolean;
  } | null = null;

  // Toggle proceed button based on checkbox acknowledgment
  chkConfirm.addEventListener('change', () => {
    btnConfirmProceed.disabled = !chkConfirm.checked;
  });

  // Cancel modal
  btnConfirmCancel.addEventListener('click', () => {
    modalConfirm.classList.add('hidden');
    pendingMigrationParams = null;
  });

  // Apply button clicked -> validate and show confirmation modal
  btnApply.addEventListener('click', () => {
    if (!client || !client.isConnected || operationInFlight) {
      alert('Station is not connected.');
      return;
    }

    formError.classList.add('hidden');

    if (!currentConfig?.netProfile) {
      formError.textContent = 'This station runs firmware that is too old for your own network. Update the firmware first (bar at the top), then apply your settings.';
      formError.classList.remove('hidden');
      return;
    }

    const band = parseInt(bandSelect.value, 10);
    const subBand = parseInt($<HTMLSelectElement>('cfg-subband').value, 10);
    const joinEuiRaw = $<HTMLInputElement>('cfg-joineui').value.trim();
    const appKeyRaw = $<HTMLInputElement>('cfg-appkey').value.trim();
    const interval = parseInt($<HTMLSelectElement>('cfg-interval').value, 10);

    if (isNaN(band)) {
      formError.textContent = 'Please select a valid frequency region.';
      formError.classList.remove('hidden');
      return;
    }

    // Validate JoinEUI
    let formattedJoinEui = '';
    try {
      formattedJoinEui = formatHexWithColons(joinEuiRaw, 8);
    } catch {
      formError.textContent = 'Invalid JoinEUI: must be exactly 16 hexadecimal characters (8 bytes).';
      formError.classList.remove('hidden');
      return;
    }

    // Validate AppKey
    let formattedAppKey = '';
    try {
      formattedAppKey = formatHexWithColons(appKeyRaw, 16);
    } catch {
      formError.textContent = 'Invalid AppKey: must be exactly 32 hexadecimal characters (16 bytes).';
      formError.classList.remove('hidden');
      return;
    }

    // Store parameters pending user confirmation
    pendingMigrationParams = {
      band,
      subBand,
      joinEui: formattedJoinEui,
      appKey: formattedAppKey,
      intervalMinutes: interval,
      gnss: gnssAllowed() && $<HTMLInputElement>('cfg-gnss').checked,
    };

    // Open confirmation modal
    modalConfirmDevEui.textContent = currentConfig?.formattedDevEui || currentConfig?.deviceEui || 'WS2001 Station';
    chkConfirm.checked = false;
    btnConfirmProceed.disabled = true;
    modalConfirm.classList.remove('hidden');
  });

  // Final confirmation proceed -> execute migration
  btnConfirmProceed.addEventListener('click', async () => {
    if (!pendingMigrationParams || !client || !client.isConnected || operationInFlight) {
      modalConfirm.classList.add('hidden');
      return;
    }

    operationInFlight = true;
    modalConfirm.classList.add('hidden');

    // Begin progress view
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const progressBar = $('progress-bar');
    const stepText = $('progress-step-text');

    const params = pendingMigrationParams;
    pendingMigrationParams = null;

    const serialNum = currentConfig?.formattedDevEui || currentConfig?.deviceEui;
    const fwVer = currentConfig?.version;
    const switchDetails = {
      ...networkSwitchDetails(currentConfig),
      band: params.band,
      subBand: params.subBand,
      intervalMinutes: params.intervalMinutes,
      gnss: params.gnss,
    };

    trackTelemetry({
      device_type: 'ws2001',
      serial_number: serialNum,
      action: 'network_switch_started',
      firmware_target: 'open_lorawan',
      firmware_source: fwVer,
      status: 'in_progress',
      details: switchDetails,
    });

    try {
      await client.configureOpenLoRaWan(
        params,
        (stepDesc, current, total) => {
          stepText.textContent = stepDesc;
          const percent = Math.round((current / total) * 100);
          progressBar.style.width = `${percent}%`;
          addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
        },
        // V4.5+ only (older firmware is blocked above): the keys go into the custom profile
        { useProfiles: true, allowOverwrite: false },
      );
      try {
        lastTtnExport = ttnExportFromForm();
      } catch {
        lastTtnExport = null;
      }
      progressBar.style.width = '100%';
      $('view-progress').classList.add('hidden');
      // Stay with the station: it restarts now; the tracker reconnects and shows the join progress
      openTracker('apply');

      trackTelemetry({
        device_type: 'ws2001',
        serial_number: serialNum,
        action: 'network_switch_completed',
        firmware_target: 'open_lorawan',
        firmware_source: fwVer,
        status: 'success',
        details: switchDetails,
      });
    } catch (err) {
      const safeErr = redactTelemetryString((err as Error).message);
      addLog(`Configuration failed: ${safeErr}`, 'ERROR');
      if (client?.isConnected) {
        const refreshed = await client.readFullConfig().catch(() => null);
        if (refreshed) populateDeviceView(refreshed);
      } else {
        currentConfig = null;
      }
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = safeErr;
      formError.classList.remove('hidden');

      trackTelemetry({
        device_type: 'ws2001',
        serial_number: serialNum,
        action: 'network_switch_failed',
        firmware_target: 'open_lorawan',
        firmware_source: fwVer,
        status: 'failed',
        details: { ...switchDetails, error: safeErr },
      });
    } finally {
      operationInFlight = false;
    }
  });

  // --- Firmware update (auto on connect if enabled, or manual version selection) ---
  const chkAutoUpdate = $<HTMLInputElement>('chk-auto-update');
  try {
    chkAutoUpdate.checked = localStorage.getItem('ws2001-auto-update') === '1';
  } catch { /* storage unavailable: keep default (off so user chooses action on connect) */ }
  chkAutoUpdate.addEventListener('change', () => {
    try { localStorage.setItem('ws2001-auto-update', chkAutoUpdate.checked ? '1' : '0'); } catch { /* ignore */ }
  });

  let dfuName = '';
  let dfuPackage: Ws2001DfuPackage | null = null;
  let dfuTargetLabel = '';
  let dfuFrom = '';
  let dfuSerial: string | undefined;

  function setDfu(step: string, percent: number, title = 'Updating firmware') {
    $('dfu-title').textContent = title;
    $('dfu-step').textContent = step;
    $('dfu-bar').style.width = `${Math.max(0, Math.min(100, percent))}%`;
  }
  function showDfuButtons(which: Array<'pick' | 'reconnect' | 'close'>) {
    $('btn-dfu-pick').classList.toggle('hidden', !which.includes('pick'));
    $('btn-dfu-reconnect').classList.toggle('hidden', !which.includes('reconnect'));
    $('btn-dfu-close').classList.toggle('hidden', !which.includes('close'));
    $('dfu-spinner').classList.toggle('hidden', which.length > 0);
    // Whenever the user has to pick the bootloader, explain that it has a different name
    $('dfu-name-hint-value').textContent = dfuName || 'DfuWX…';
    $('dfu-name-hint').classList.toggle('hidden', !which.includes('pick'));
  }
  function dfuFailed(err: unknown, canResume: boolean) {
    const msg = redactTelemetryString((err as Error).message);
    addLog(`Firmware update failed: ${msg}`, 'ERROR');
    setDfu(msg, 0, 'Firmware update failed');
    $('dfu-detail').textContent = canResume
      ? 'The station stays in update mode for about 2 minutes and keeps its current firmware. Try again to resume.'
      : 'The station was not changed.';
    $('btn-dfu-pick').textContent = 'Try again';
    showDfuButtons(canResume ? ['pick', 'close'] : ['close']);
    trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_failed', firmware_target: dfuTargetLabel,
      firmware_source: dfuFrom, status: 'failed', details: { error: msg } });
  }

  async function runFirmwareUpdate(trigger: 'auto' | 'manual', customFile?: File) {
    if (!client || !client.gattServer || !currentConfig || operationInFlight) return;
    const targetRel = trigger === 'auto' ? latest : getSelectedRelease();
    if (!customFile && !targetRel) return;

    if (!customFile && targetRel) {
      const cmp = compareStationVersion(currentConfig.version, targetRel.version);
      if (cmp !== 'older' && cmp !== 'equal') return;
    }

    stopTracker();
    operationInFlight = true;
    dfuTargetLabel = customFile ? customFile.name : targetRel!.label;
    dfuFrom = currentConfig.version;
    dfuSerial = currentConfig.formattedDevEui || currentConfig.deviceEui;
    $('view-device').classList.add('hidden');
    $('view-dfu').classList.remove('hidden');
    $('dfu-detail').textContent = 'Keep the station powered and this device within a few metres until the update finishes.';
    showDfuButtons([]);
    setDfu(`Preparing and verifying ${dfuTargetLabel}...`, 1);
    trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_started', firmware_target: dfuTargetLabel,
      firmware_source: dfuFrom, status: 'in_progress', details: { trigger } });
    try {
      if (customFile) {
        const bytes = new Uint8Array(await customFile.arrayBuffer());
        dfuPackage = await parseWs2001DfuPackage(bytes);
        if (dfuPackage.initPacket.fwVersion !== null) {
          dfuTargetLabel = `V${Math.floor(dfuPackage.initPacket.fwVersion / 10)}.${dfuPackage.initPacket.fwVersion % 10}`;
        }
      } else {
        dfuPackage = await downloadWs2001Release(targetRel!);
      }
      addLog(`${dfuTargetLabel} verified: signed for the WS2001 bootloader (${dfuPackage.firmware.length} bytes).`);
    } catch (e) {
      operationInFlight = false;
      dfuFailed(e, false);
      return;
    }
    try {
      dfuName = makeBootloaderName();
      setDfu('Restarting the station into update mode...', 3);
      client.detachForBootloader();
      await enterBootloader(client.gattServer, dfuName, addLog);
      currentConfig = null;
      client = null;
      await new Promise((r) => setTimeout(r, 2500));
    } catch (e) {
      operationInFlight = false;
      dfuFailed(e, false);
      return;
    }
    operationInFlight = false;
    // Browsers need a click to connect to the bootloader, which is a new Bluetooth device.
    setDfu(`The station is in update mode. Click Continue and pick "${dfuName}" in the Bluetooth list.`, 5);
    $('btn-dfu-pick').textContent = `Continue: select "${dfuName}"`;
    showDfuButtons(['pick']);
  }

  $('btn-fw-update').addEventListener('click', () => {
    if (!currentConfig || operationInFlight) return;
    if (fwVersionSelect.value === 'custom') {
      const file = fwFileInput.files?.[0];
      if (!file) return;
      if (confirm(`Flash custom firmware package "${file.name}" onto this station? Settings and network profiles are kept.`)) {
        void runFirmwareUpdate('manual', file);
      }
      return;
    }
    const selected = getSelectedRelease();
    if (!selected) return;
    const cmp = compareStationVersion(currentConfig.version, selected.version);
    if (cmp !== 'older' && cmp !== 'equal') return;
    const question = cmp === 'older'
      ? `Flash ${selected.label} onto this station (currently ${currentConfig.version})? It takes about a minute; settings and network profiles are kept.`
      : `Reinstall ${selected.label} on this station? It takes about a minute; settings and network profiles are kept.`;
    if (confirm(question)) void runFirmwareUpdate('manual');
  });

  $('btn-dfu-pick').addEventListener('click', async () => {
    if (!dfuPackage || !dfuTargetLabel) return;
    showDfuButtons([]);
    let server: BluetoothRemoteGATTServer | null = null;
    try {
      const dev = await requestBootloaderDevice(dfuName);
      setDfu(`Connecting to ${dev.name ?? 'the bootloader'}...`, 6);
      const onProgress = (p: { stage: string; sent: number; total: number; kbPerSec: number }) => {
        if (p.stage === 'firmware') {
          const pct = 8 + (92 * p.sent) / p.total;
          setDfu(`Installing ${dfuTargetLabel}: ${Math.floor((100 * p.sent) / p.total)}% (${p.kbPerSec.toFixed(1)} KB/s)`, pct);
        }
      };
      // The first connection to a freshly rebooted bootloader often drops right away
      // ("GATT Server is disconnected"): retry a few times before asking the user.
      let transfer: SecureDfuTransfer | null = null;
      for (let attempt = 1; !transfer; attempt++) {
        try {
          server = await dev.gatt!.connect();
          transfer = await SecureDfuTransfer.open(server, addLog, onProgress);
        } catch (e) {
          if (attempt >= 3 || (e as Error).name === 'DfuError') throw e;
          addLog(`Bootloader connection dropped (${(e as Error).message}); retrying ${attempt}/2...`, 'WARN');
          try { server?.disconnect(); } catch { /* ignore */ }
          await new Promise((r) => setTimeout(r, 1500));
        }
      }
      const t0 = performance.now();
      setDfu('Sending the signed update header...', 7);
      await transfer.sendInit(dfuPackage.init);
      await transfer.sendFirmware(dfuPackage.firmware);
      addLog(`Transferred ${(dfuPackage.firmware.length / 1024).toFixed(1)} KB in ${((performance.now() - t0) / 1000).toFixed(0)} s.`);
      setDfu(`${dfuTargetLabel} installed. The station is restarting (about 10 seconds).`, 100, 'Firmware updated');
      $('dfu-detail').textContent = 'Reconnect to check the new version and continue setting up the station.';
      showDfuButtons(['reconnect', 'close']);
      trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_completed', firmware_target: dfuTargetLabel,
        firmware_source: dfuFrom, status: 'success' });
    } catch (e) {
      if ((e as Error).name === 'NotFoundError') {
        // Chooser cancelled: offer the button again
        setDfu(`Pick "${dfuName}" in the Bluetooth list to continue.`, 5);
        showDfuButtons(['pick', 'close']);
        return;
      }
      dfuFailed(e, true);
    } finally {
      try { server?.disconnect(); } catch { /* ignore */ }
    }
  });

  $('btn-dfu-reconnect').addEventListener('click', () => {
    $('view-dfu').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
    btnConnect.click(); // same user gesture opens the chooser
  });
  $('btn-dfu-close').addEventListener('click', () => {
    $('view-dfu').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
  });

  // 1-Click Switch to Stored Open LoRaWAN Profile (firmware V4.5+ when customStored is true)
  $('btn-switch-open-stored').addEventListener('click', async () => {
    if (!client || !client.isConnected || !currentConfig?.netProfile?.customStored || operationInFlight) return;
    if (!confirm('Switch this station to your saved network (profile 1)? The WeatherXM identity stays stored in profile 0.')) return;
    operationInFlight = true;
    const btn = $<HTMLButtonElement>('btn-switch-open-stored');
    btn.disabled = true;
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const serialNum = currentConfig.formattedDevEui || currentConfig.deviceEui;
    const fwVer = currentConfig.version;
    const openDetails = networkSwitchDetails(currentConfig);
    trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_started', firmware_target: 'open_lorawan',
      firmware_source: fwVer, status: 'in_progress', details: { ...openDetails, storedProfile: true } });
    try {
      await client.switchToStoredOpenLoRaWan((stepDesc, current, total) => {
        $('progress-step-text').textContent = stepDesc;
        $('progress-bar').style.width = `${Math.round((current / total) * 100)}%`;
        addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
      });
      $('view-progress').classList.add('hidden');
      lastTtnExport = null;
      openTracker('stored');
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_completed', firmware_target: 'open_lorawan',
        firmware_source: fwVer, status: 'success', details: { ...openDetails, storedProfile: true } });
    } catch (err) {
      const safeErr = redactTelemetryString((err as Error).message);
      addLog(`Switch to stored Open LoRaWAN failed: ${safeErr}`, 'ERROR');
      if (client?.isConnected) {
        const refreshed = await client.readFullConfig().catch(() => null);
        if (refreshed) populateDeviceView(refreshed);
      } else {
        currentConfig = null;
      }
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_failed', firmware_target: 'open_lorawan',
        firmware_source: fwVer, status: 'failed', details: { ...openDetails, storedProfile: true, error: safeErr } });
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = safeErr;
      formError.classList.remove('hidden');
    } finally {
      operationInFlight = false;
      btn.disabled = false;
    }
  });

  // Switch back to Helium / WeatherXM (firmware V4.5+)
  $('btn-switchback').addEventListener('click', async () => {
    const canSwitchHelium = Boolean(currentConfig?.netProfile && (currentConfig.netProfile.weatherxmStored || currentConfig.netProfile.active === 0));
    if (!client || !client.isConnected || !canSwitchHelium || operationInFlight) return;
    if (!confirm(currentConfig?.netProfile?.active === 1
      ? 'Switch this station back to the WeatherXM network (profile 0)? Your own network settings stay saved in profile 1.'
      : 'Restart the station on the WeatherXM network (profile 0)? It sends a fresh Join-Request.')) return;
    operationInFlight = true;
    const btn = $<HTMLButtonElement>('btn-switchback');
    btn.disabled = true;
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const serialNum = currentConfig!.formattedDevEui || currentConfig!.deviceEui;
    const fwVer = currentConfig!.version;
    const backDetails = networkSwitchDetails(currentConfig);
    trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_started', firmware_target: 'weatherxm',
      firmware_source: fwVer, status: 'in_progress', details: backDetails });
    try {
      await client.switchBackToWeatherXm((stepDesc, current, total) => {
        $('progress-step-text').textContent = stepDesc;
        $('progress-bar').style.width = `${Math.round((current / total) * 100)}%`;
        addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
      });
      currentConfig = null;
      client = null;
      $('view-progress').classList.add('hidden');
      stopTracker();
      $('success-title').textContent = 'Back on the WeatherXM network!';
      $('success-sub').textContent = 'The station restarted with its WeatherXM identity (profile 0). It shows up in the WeatherXM app once it has joined and sent data.';
      $('success-steps').classList.add('hidden');
      $('btn-ttn-export-success').classList.add('hidden');
      $('view-success').classList.remove('hidden');
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_completed', firmware_target: 'weatherxm',
        firmware_source: fwVer, status: 'success', details: backDetails });
    } catch (err) {
      const safeErr = redactTelemetryString((err as Error).message);
      addLog(`Switch back failed: ${safeErr}`, 'ERROR');
      if (client?.isConnected) {
        const refreshed = await client.readFullConfig().catch(() => null);
        if (refreshed) populateDeviceView(refreshed);
      } else {
        currentConfig = null;
      }
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'network_switch_failed', firmware_target: 'weatherxm',
        firmware_source: fwVer, status: 'failed', details: { ...backDetails, error: safeErr } });
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = safeErr;
      formError.classList.remove('hidden');
    } finally {
      operationInFlight = false;
      btn.disabled = false;
    }
  });

  // Done button
  $('btn-done').addEventListener('click', () => {
    stopTracker();
    currentConfig = null;
    $('view-success').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    $('connect-steps').classList.remove('hidden');
  });

  // ===================== Open Edition join tracker =====================
  // After switching to the customer's network the station restarts (ATZ). The page reconnects to the
  // same station without the chooser, then polls AT+LW_MODEM_STATUS=? every 10 s (which also keeps the
  // Bluetooth session alive; the station drops a session after 10 min without commands) and AT+MEA=?
  // once a minute. Progress per station (dates only, never keys) is remembered in this browser so a
  // later visit shows where the setup stands.
  type TrackerPhase = 'off' | 'restarting' | 'reconnecting' | 'live' | 'lost';
  type TrackerOrigin = 'apply' | 'stored' | 'retry' | 'revisit';
  type StepState = 'done' | 'active' | 'warn' | 'todo';
  interface SetupRecord { configuredAt?: number; ttnFileAt?: number; joinedAt?: number; dataConfirmedAt?: number }
  const SETUP_KEY = 'ws2001-open-setup';
  const JOIN_SLOW_MS = 5 * 60 * 1000;
  const POLL_MS = 10000;
  const MEA_EVERY_POLLS = 6;

  const tracker = {
    phase: 'off' as TrackerPhase,
    origin: 'revisit' as TrackerOrigin,
    devEui: '',
    restartAt: 0,
    liveAt: 0,
    reconnectedIn: 0,
    joinedAt: 0,
    attempt: 0,
    polls: 0,
    status: null as LoRaWanStatus | null,
    readings: null as StationMeasurements | null,
    pollTimer: 0,
    tickTimer: 0,
  };

  const euiKey = (eui: string | undefined) => (eui ?? '').replace(/[^0-9a-fA-F]/g, '').toUpperCase();
  function loadSetup(devEui: string): SetupRecord {
    try { return (JSON.parse(localStorage.getItem(SETUP_KEY) || '{}') as Record<string, SetupRecord>)[euiKey(devEui)] ?? {}; } catch { return {}; }
  }
  function saveSetup(devEui: string, patch: Partial<SetupRecord>) {
    const key = euiKey(devEui);
    if (!key) return;
    try {
      const all = JSON.parse(localStorage.getItem(SETUP_KEY) || '{}') as Record<string, SetupRecord>;
      all[key] = { ...(all[key] ?? {}), ...patch };
      localStorage.setItem(SETUP_KEY, JSON.stringify(all));
    } catch { /* storage unavailable: the tracker still works for this visit */ }
  }
  function fmtDuration(ms: number): string {
    const sec = Math.max(0, Math.round(ms / 1000));
    if (sec < 60) return `${sec} s`;
    const min = Math.floor(sec / 60);
    if (min < 60) return `${min} min ${sec % 60} s`;
    return `${Math.floor(min / 60)} h ${min % 60} min`;
  }
  const fmtDate = (t: number) => new Date(t).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

  /** Step 2 collapses while the setup tracker is shown; the toggle opens it on demand. */
  function setNetworkChoiceCollapsed(collapsed: boolean) {
    $('network-choice-body').classList.toggle('hidden', collapsed);
    $('network-choice-desc').classList.toggle('hidden', collapsed);
    $('network-choice-collapsed-note').classList.toggle('hidden', !collapsed);
    $('btn-toggle-network-choice').setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    $('network-choice-toggle-label').textContent = collapsed ? 'Show options' : 'Hide options';
    $('network-choice-chevron').classList.toggle('rotate-180', !collapsed);
  }
  function setNetworkChoiceToggleAvailable(available: boolean) {
    const btn = $('btn-toggle-network-choice');
    btn.classList.toggle('hidden', !available);
    btn.classList.toggle('inline-flex', available);
    if (!available) setNetworkChoiceCollapsed(false);
  }
  $('btn-toggle-network-choice').addEventListener('click', () => {
    setNetworkChoiceCollapsed(!$('network-choice-body').classList.contains('hidden'));
  });

  function setDeviceSectionsVisible(visible: boolean) {
    $('fw-strip').classList.toggle('hidden', !visible);
    $('network-choice').classList.toggle('hidden', !visible);
  }

  function startTracker(origin: TrackerOrigin) {
    tracker.origin = origin;
    tracker.devEui = euiKey(currentConfig?.deviceEui) || tracker.devEui;
    tracker.joinedAt = 0;
    tracker.attempt = 0;
    tracker.polls = 0;
    tracker.status = null;
    tracker.readings = null;
    if (origin === 'revisit') {
      tracker.phase = 'live';
      tracker.restartAt = 0;
      tracker.liveAt = Date.now();
    } else {
      tracker.phase = 'restarting';
      tracker.restartAt = Date.now();
      tracker.liveAt = 0;
    }
    if (origin === 'apply' || origin === 'stored') {
      const rec = loadSetup(tracker.devEui);
      saveSetup(tracker.devEui, { configuredAt: Date.now(), ttnFileAt: origin === 'stored' ? rec.ttnFileAt : rec.ttnFileAt && Date.now() - rec.ttnFileAt < 3600000 ? rec.ttnFileAt : undefined, joinedAt: undefined, dataConfirmedAt: undefined });
    }
    $('net-tracker').classList.remove('hidden');
    setNetworkChoiceToggleAvailable(true);
    setNetworkChoiceCollapsed(true);
    window.clearInterval(tracker.tickTimer);
    tracker.tickTimer = window.setInterval(renderTracker, 1000);
    renderTracker();
    if (tracker.phase === 'live') schedulePoll(0);
  }

  function stopTracker() {
    if (tracker.phase === 'off') return;
    tracker.phase = 'off';
    $('dev-link-pill').className = 'badge-status-green inline-flex items-center space-x-1.5';
    $('dev-link-dot').classList.remove('hidden');
    $('dev-link-text').textContent = 'Connected over Bluetooth';
    window.clearInterval(tracker.tickTimer);
    window.clearTimeout(tracker.pollTimer);
    $('net-tracker').classList.add('hidden');
    setNetworkChoiceToggleAvailable(false);
    setDeviceSectionsVisible(true);
  }

  /** After a network switch: show the dashboard with the tracker while the station restarts, then reconnect. */
  function openTracker(origin: TrackerOrigin) {
    $('view-device').classList.remove('hidden');
    setDeviceSectionsVisible(false);
    startTracker(origin);
    // Let the calling handler finish (it clears operationInFlight) before the reconnect takes over
    window.setTimeout(() => void reconnectAfterRestart(), 0);
  }

  async function reconnectAfterRestart() {
    if (!client || demoMode || tracker.phase === 'off') return;
    const station = client;
    window.clearTimeout(tracker.pollTimer);
    tracker.phase = 'reconnecting';
    renderTracker();
    operationInFlight = true;
    // The station may drop the first link again while it finishes booting: keep trying until the deadline.
    const deadline = Date.now() + 60000;
    let lastError: Error | null = null;
    try {
      while (tracker.phase === 'reconnecting' && Date.now() < deadline) {
        try {
          await station.reconnect({ timeoutMs: Math.max(1000, deadline - Date.now()), onAttempt: (n) => { tracker.attempt = n; renderTracker(); } });
          const cfg = await station.readFullConfig();
          if (tracker.phase !== 'reconnecting') {
            // Stopped meanwhile (Finish, Disconnect): don't leave a link open behind the start screen
            if (client !== station) void station.disconnect().catch(() => {});
            return;
          }
          tracker.reconnectedIn = tracker.restartAt ? Date.now() - tracker.restartAt : 0;
          addLog(tracker.restartAt ? `Reconnected to the station ${fmtDuration(tracker.reconnectedIn)} after its restart.` : 'Reconnected to the station.', 'INFO');
          tracker.phase = 'live';
          tracker.liveAt = Date.now();
          operationInFlight = false;
          populateDeviceView(cfg);
          setDeviceSectionsVisible(true);
          schedulePoll(0);
          return;
        } catch (e) {
          lastError = e as Error;
          if (tracker.phase !== 'reconnecting') return;
          if (Date.now() < deadline) {
            addLog(`Reconnect attempt failed (${lastError.message}); trying again...`, 'WARN');
            await new Promise((r) => setTimeout(r, 2000));
          }
        }
      }
      if (tracker.phase === 'reconnecting') {
        tracker.phase = 'lost';
        addLog(`${lastError?.message ?? 'Could not reconnect to the station'}. The station joins on its own; reconnect to watch it.`, 'WARN');
      }
    } finally {
      operationInFlight = false;
      renderTracker();
    }
  }

  function schedulePoll(ms: number) {
    window.clearTimeout(tracker.pollTimer);
    tracker.pollTimer = window.setTimeout(() => void pollTracker(), ms);
  }

  async function pollTracker() {
    if (tracker.phase !== 'live') return;
    if (demoMode) { renderTracker(); return; }
    if (operationInFlight) { schedulePoll(POLL_MS); return; }
    if (!client || !client.isConnected) {
      tracker.phase = 'lost';
      setDeviceSectionsVisible(false);
      renderTracker();
      return;
    }
    try {
      tracker.status = await client.readLoRaWanStatus();
      if (tracker.polls % MEA_EVERY_POLLS === 0) {
        tracker.readings = await client.readMeasurements().catch(() => tracker.readings);
      }
      tracker.polls++;
    } catch {
      if (!client?.isConnected) {
        tracker.phase = 'lost';
        setDeviceSectionsVisible(false);
        renderTracker();
        return;
      }
    }
    if (tracker.status?.state === 'joined' && !tracker.joinedAt) {
      tracker.joinedAt = Date.now();
      const rec = loadSetup(tracker.devEui);
      if (!rec.joinedAt || (rec.configuredAt && rec.joinedAt < rec.configuredAt)) saveSetup(tracker.devEui, { joinedAt: tracker.joinedAt });
      addLog(tracker.restartAt ? `Joined your network ${fmtDuration(tracker.joinedAt - tracker.restartAt)} after the restart.` : 'The station is joined to your network.', 'INFO');
    }
    renderTracker();
    schedulePoll(POLL_MS);
  }

  const STEP_DOT: Record<StepState, string> = {
    done: 'tstep-dot w-6 h-6 shrink-0 rounded-full flex items-center justify-center text-[11px] font-bold border bg-wxm-live/15 border-wxm-live/50 text-wxm-live',
    active: 'tstep-dot w-6 h-6 shrink-0 rounded-full flex items-center justify-center text-[11px] font-bold border bg-wxm-beacon/20 border-wxm-zenith text-wxm-zenith animate-pulse',
    warn: 'tstep-dot w-6 h-6 shrink-0 rounded-full flex items-center justify-center text-[11px] font-bold border bg-amber-500/15 border-amber-400/50 text-amber-300',
    todo: 'tstep-dot w-6 h-6 shrink-0 rounded-full flex items-center justify-center text-[11px] font-bold border bg-wxm-midnight/70 border-wxm-cloud/20 text-wxm-mist',
  };
  const CHECK_SVG = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>';

  function readingsText(r: StationMeasurements | null): string {
    if (!r) return 'Live readings: waiting for the station...';
    const parts: string[] = [];
    if (r.temperature != null) parts.push(`${r.temperature.toFixed(1)} °C`);
    if (r.humidity != null) parts.push(`${Math.round(r.humidity)} % RH`);
    if (r.windSpeed != null) parts.push(`wind ${r.windSpeed.toFixed(1)} m/s${r.windDirection != null ? ` from ${Math.round(r.windDirection)}°` : ''}`);
    if (r.windGust != null) parts.push(`gust ${r.windGust.toFixed(1)} m/s`);
    if (r.pressure != null) parts.push(`${r.pressure.toFixed(1)} hPa`);
    return parts.length ? `Live readings: ${parts.join(' · ')}` : 'Live readings: the sensor is not answering right now.';
  }

  function renderTracker() {
    if (tracker.phase === 'off') return;
    $('net-tracker').classList.remove('hidden');
    const cfg = currentConfig;
    const rec = loadSetup(tracker.devEui);
    const now = Date.now();
    const st = tracker.status?.state ?? null;
    const live = tracker.phase === 'live';
    const joined = live && st === 'joined';
    const since = tracker.restartAt || tracker.liveAt;
    const elapsed = since ? now - since : 0;
    const slow = live && st === 'joining' && elapsed > JOIN_SLOW_MS;
    const afterConfig = (t?: number) => Boolean(t && (!rec.configuredAt || t >= rec.configuredAt));
    const registered = joined || afterConfig(rec.ttnFileAt) || afterConfig(rec.joinedAt);
    const dataOk = afterConfig(rec.dataConfirmedAt);
    const interval = cfg?.uploadInterval;
    // Keys from this visit's form (switch to my network): the TTN file can be built without asking
    const ttnReady = Boolean(lastTtnExport && euiKey(lastTtnExport.devEui) === tracker.devEui);

    $('tracker-sub').textContent = `${client?.deviceName || cfg?.bleName || 'Station'} · ${cfg?.frequencyName ?? '–'} · DevEUI ${cfg?.formattedDevEui ?? '–'}`;
    const link = $('tracker-link');
    const LINK = 'px-2.5 py-1 text-xs font-semibold rounded-full whitespace-nowrap border ';
    if (live) { link.textContent = 'Live over Bluetooth'; link.className = LINK + 'bg-wxm-live/15 border-wxm-live/50 text-wxm-live'; }
    else if (tracker.phase === 'lost') { link.textContent = 'Not connected'; link.className = LINK + 'bg-wxm-midnight/70 border-wxm-cloud/20 text-wxm-mist'; }
    else { link.textContent = 'Reconnecting...'; link.className = LINK + 'bg-amber-500/15 border-amber-400/40 text-amber-300'; }

    const welcome = $('tracker-welcome');
    if (tracker.origin === 'revisit') {
      welcome.textContent = rec.configuredAt
        ? `Welcome back. You set up this station for your network on ${fmtDate(rec.configuredAt)}. Its status is read live while this page is connected.`
        : 'This station reports to your own network. Its status is read live while this page is connected.';
      welcome.classList.remove('hidden');
    } else {
      welcome.classList.add('hidden');
    }

    // Steps
    const restartStep: [StepState, string] = tracker.origin === 'revisit'
      ? (tracker.phase === 'lost' ? ['warn', 'Bluetooth link lost'] : ['done', rec.configuredAt ? `Earlier, ${fmtDate(rec.configuredAt)}` : 'Earlier'])
      : tracker.phase === 'restarting' ? ['active', 'Waiting for the station']
      : tracker.phase === 'reconnecting' ? ['active', `Reconnecting, attempt ${tracker.attempt || 1}`]
      : tracker.phase === 'lost' ? ['warn', 'Could not reconnect']
      : ['done', tracker.reconnectedIn ? `Reconnected in ${fmtDuration(tracker.reconnectedIn)}` : 'Reconnected'];
    const joinStep: [StepState, string] = !live ? ['todo', tracker.phase === 'lost' ? 'Status unknown while disconnected' : 'Starts right after the restart']
      : joined ? ['done', tracker.joinedAt && tracker.restartAt ? `Joined in ${fmtDuration(tracker.joinedAt - tracker.restartAt)}` : 'Joined']
      : st === 'joining' ? (slow ? ['warn', `No Join-Accept after ${fmtDuration(elapsed)}`] : ['active', 'Sending Join-Requests'])
      : st === 'idle' ? ['warn', 'Not joining'] : ['active', 'Checking...'];
    const steps: Array<[StepState, string]> = [
      registered ? ['done', joined || afterConfig(rec.joinedAt) ? 'Your server accepted the join' : 'TTN import file downloaded']
        : [slow ? 'warn' : ttnReady ? 'active' : 'todo', ttnReady ? 'Download the TTN import file' : 'Add DevEUI, JoinEUI and AppKey'],
      ['done', rec.configuredAt ? `Profile 1 · ${fmtDate(rec.configuredAt)}` : 'Profile 1 active'],
      restartStep,
      joinStep,
      joined ? ['done', 'Keys and downlink work'] : ['todo', 'Waits for the Join-Accept'],
      dataOk ? ['done', 'You confirmed data arrives'] : joined ? ['active', 'Check Live data on your server'] : ['todo', 'After joining'],
    ];
    document.querySelectorAll<HTMLLIElement>('#tracker-steps > li').forEach((li, i) => {
      const [state, sub] = steps[i];
      const dot = li.querySelector<HTMLElement>('.tstep-dot')!;
      dot.className = STEP_DOT[state];
      dot.innerHTML = state === 'done' ? CHECK_SVG : state === 'warn' ? '!' : String(i + 1);
      li.querySelector<HTMLElement>('.tstep-sub')!.textContent = sub;
    });

    // Status panel
    let tone: 'busy' | 'ok' | 'warn' = 'busy';
    let title = '';
    let sub = '';
    let hint = '';
    if (tracker.phase === 'restarting' || tracker.phase === 'reconnecting') {
      title = tracker.phase === 'restarting' ? 'Restarting the station' : `Reconnecting (attempt ${tracker.attempt || 1})`;
      sub = `Settings saved ${fmtDuration(elapsed)} ago`;
      hint = 'Your settings are saved. The station restarts to load them and starts joining right away. This page reconnects by itself, usually within 15 seconds: keep it open.';
    } else if (tracker.phase === 'lost') {
      tone = 'warn';
      title = 'Not connected to the station';
      sub = since ? `${fmtDuration(elapsed)} since ${tracker.restartAt ? 'the restart' : 'connecting'}` : '';
      hint = 'The station runs on its own and keeps trying to join your network. Reconnect to watch its status, or close this page: nothing else is needed.';
    } else if (joined) {
      tone = 'ok';
      title = 'Joined your network';
      sub = tracker.joinedAt && tracker.restartAt ? `Joined ${fmtDuration(tracker.joinedAt - tracker.restartAt)} after the restart` : 'The station is joined';
      hint = dataOk
        ? 'Done: your server receives the station\'s data. You can finish now; the station restarts once and joins again by itself.'
        : `Your server accepted the station. It sends a weather uplink right after joining and then every ${interval ?? '?'} min on FPort 99. Open Live data on your server: you should see decoded values such as temperature and wind (the TTN import file includes the decoder). Then confirm below.`;
    } else if (st === 'joining' && slow) {
      tone = 'warn';
      title = `Not joined after ${fmtDuration(elapsed)}`;
      sub = 'The station keeps retrying';
      hint = `Check on your server that DevEUI ${cfg?.formattedDevEui ?? ''}, the JoinEUI and the AppKey match this station, the frequency plan matches ${cfg?.frequencyName ?? 'its region'}, and the LoRaWAN version is 1.0.4. If the server shows Join requests and accepts them, the Join-Accept does not reach the station: move it closer to a gateway or outdoors. Retries slow down over time; Restart and retry join starts a fresh cycle.`;
    } else if (st === 'joining') {
      title = 'Joining your network';
      sub = `${fmtDuration(elapsed)} since ${tracker.restartAt ? 'the restart' : 'connecting'}`;
      hint = (registered || ttnReady ? '' : 'Not registered yet? Add the station to your network server now (on TTN the import file does it in one step); it keeps retrying. ')
        + 'The station sends a Join-Request and listens for the Join-Accept 5 seconds later. On TTN, open Live data in your application: each request appears as a Join request event; nothing there means no gateway hears the station.';
    } else if (st === 'idle') {
      tone = 'warn';
      title = 'The station is not joining';
      sub = `${fmtDuration(elapsed)} since ${tracker.restartAt ? 'the restart' : 'connecting'}`;
      hint = 'Its LoRaWAN modem reports neither joining nor joined. Restart and retry join; if it stays like this, check the network settings below.';
    } else {
      title = 'Checking the LoRaWAN status...';
      sub = 'Reading from the station';
      hint = 'Reading the join status from the station over Bluetooth.';
    }
    const ICON = 'w-9 h-9 shrink-0 rounded-full flex items-center justify-center border ';
    $('tracker-icon').className = ICON + (tone === 'ok' ? 'bg-wxm-live/15 border-wxm-live/50 text-wxm-live'
      : tone === 'warn' ? 'bg-amber-500/15 border-amber-400/50 text-amber-300' : 'bg-wxm-beacon/15 border-wxm-beacon/40 text-wxm-zenith');
    $('tracker-spinner').classList.toggle('hidden', tone !== 'busy');
    $('tracker-ok').classList.toggle('hidden', tone !== 'ok');
    $('tracker-warn').classList.toggle('hidden', tone !== 'warn');
    $('tracker-title').textContent = title;
    $('tracker-elapsed').textContent = sub;
    $('tracker-hint').textContent = hint;

    // Header follows the link and the live status
    const pill = $('dev-link-pill');
    pill.className = `${live ? 'badge-status-green' : 'badge-status-warn'} inline-flex items-center space-x-1.5`;
    $('dev-link-dot').classList.toggle('hidden', !live);
    $('dev-link-text').textContent = live ? 'Connected over Bluetooth' : tracker.phase === 'lost' ? 'Not connected' : 'Reconnecting...';
    if (!live) {
      const joinEl = $('stat-join');
      joinEl.textContent = tracker.phase === 'lost' ? 'Unknown' : 'Restarting...';
      joinEl.className = 'text-xs font-bold text-wxm-mist';
    }
    if (live && st && st !== 'unknown') {
      if (cfg) cfg.lorawanStatus = st === 'joined' ? 'JOINED' : st === 'joining' ? 'JOINING' : cfg.lorawanStatus;
      const joinEl = $('stat-join');
      joinEl.textContent = st === 'joined' ? 'Joined' : st === 'joining' ? 'Joining...' : 'Not joining';
      joinEl.className = `text-xs font-bold ${st === 'joined' ? 'text-wxm-live' : st === 'joining' ? 'text-amber-300' : 'text-wxm-mist'}`;
    }

    // Readout
    const flags = (tracker.status?.flags ?? []).filter((f) => f === 'MUTE' || f === 'SUSPEND');
    $('tm-lorawan').textContent = !live ? '–' : (st === 'joined' ? 'Joined' : st === 'joining' ? 'Joining...' : st === 'idle' ? 'Not joining' : '...') + (flags.length ? ` · ${flags.join(', ').toLowerCase()}` : '');
    $('tm-time-label').textContent = joined ? 'Time to join' : tracker.restartAt ? 'Since restart' : 'Watching for';
    $('tm-time').textContent = joined ? (tracker.joinedAt && tracker.restartAt ? fmtDuration(tracker.joinedAt - tracker.restartAt) : 'Before this visit') : since ? fmtDuration(elapsed) : '–';
    $('tm-bat').textContent = cfg?.battery ?? '–';
    $('tm-region').textContent = cfg ? `${cfg.frequencyName}${cfg.subBand != null && (cfg.frequencyBand === 8 || cfg.frequencyBand === 1) ? ` · FSB ${cfg.subBand + 1}` : ''}` : '–';
    $('tm-interval').textContent = interval != null ? `${interval} min` : '–';
    $('tm-fw').textContent = cfg?.version ?? '–';
    $('tracker-readings').textContent = readingsText(tracker.readings);

    // Actions
    $('btn-tracker-data-ok').classList.toggle('hidden', !(joined && !dataOk));
    $('btn-tracker-reconnect').classList.toggle('hidden', !(tracker.phase === 'lost' && client));
    $<HTMLButtonElement>('btn-tracker-retry').disabled = !live;
    $('btn-tracker-ttn').classList.toggle('hidden', !(ttnReady || (live && client)));
    // Right after a successful configuration: the TTN file is the user's next step until it is downloaded or the station joined
    $('tracker-register').classList.toggle('hidden', !(ttnReady && !registered));
    if (ttnReady && lastTtnExport) {
      $('tracker-register-plan').textContent = `${cfg?.frequencyName ?? 'region'} frequency plan`;
    }
  }

  $('btn-tracker-data-ok').addEventListener('click', () => {
    saveSetup(tracker.devEui, { dataConfirmedAt: Date.now() });
    addLog('You confirmed that your server receives the station\'s data.', 'INFO');
    renderTracker();
  });
  $('btn-tracker-reconnect').addEventListener('click', () => void reconnectAfterRestart());
  $('btn-tracker-ttn').addEventListener('click', (e) => void downloadTtnImportFromStation(e.currentTarget as HTMLButtonElement));
  $('btn-tracker-register-ttn').addEventListener('click', (e) => void downloadTtnImportFromStation(e.currentTarget as HTMLButtonElement));
  $('btn-tracker-finish').addEventListener('click', () => $<HTMLButtonElement>('btn-disconnect').click());
  $('btn-tracker-retry').addEventListener('click', async () => {
    if (!client || !client.isConnected || operationInFlight || tracker.phase !== 'live') return;
    if (!confirm('Restart the station? It sends a fresh Join-Request right away; this page reconnects by itself.')) return;
    operationInFlight = true;
    try {
      addLog('Restarting the station to retry the join...', 'INFO');
      await client.restartStation();
    } catch (e) {
      operationInFlight = false;
      addLog(`Restart failed: ${redactTelemetryString((e as Error).message)}`, 'ERROR');
      return;
    }
    operationInFlight = false;
    setDeviceSectionsVisible(false);
    startTracker('retry');
    void reconnectAfterRestart();
  });

  if (demoMode) {
    const variants: Record<string, Partial<Ws2001DeviceConfig>> = {
      old: { version: 'V4.3', netProfile: null, testModeType: 0, lorawanStatus: 'JOINED', uploadInterval: 3 },
      wxm: { version: 'V4.7', netProfile: { active: 0, weatherxmStored: true, customStored: false }, lorawanStatus: 'JOINED', uploadInterval: 3 },
      stored: { version: 'V4.10', netProfile: { active: 0, weatherxmStored: true, customStored: true }, lorawanStatus: 'JOINING', uploadInterval: 3 },
      custom: { version: 'V4.10', netProfile: { active: 1, weatherxmStored: true, customStored: true }, lorawanStatus: 'JOINED', uploadInterval: 5, appEui: '70B3D57ED0000000' },
    };
    // Tracker states: ?demo=tracker-restart | tracker-joining | tracker-stuck | tracker-joined | custom (revisit)
    const trackerDemo = demoMode.startsWith('tracker-') ? demoMode.slice(8) : demoMode === 'custom' ? 'revisit' : null;
    if (trackerDemo) variants[demoMode] = variants.custom;
    const demoCfg: Ws2001DeviceConfig = {
      deviceModel: 'H2', deviceEui: '2CF7F1C06150000C', formattedDevEui: '2C:F7:F1:C0:61:50:00:0C', appEui: '0000000000000000',
      version: 'V4.10', battery: '92%', uploadInterval: 3, frequencyBand: 5, frequencyName: 'EU868', subBand: null,
      testModeType: 0, netProfile: null, lorawanStatus: 'JOINED', gnssSwitch: false, rawConfig: '', bleName: 'WeatherXM WS2001 50000C',
      ...(variants[demoMode] ?? variants.wxm),
    } as Ws2001DeviceConfig;
    void latestReady.then(() => {
      addLog(`Demo data (${demoMode}): no station is connected.`, 'WARN');
      populateDeviceView(demoCfg);
      $('dev-name').textContent = demoCfg.bleName ?? 'WeatherXM WS2001';
      $('view-connect').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      if (!trackerDemo) return;
      const demoReadings = { temperature: 23.4, humidity: 56, windSpeed: 3.1, windDirection: 270, windGust: 5.2, pressure: 1013.2 };
      if (trackerDemo === 'revisit') {
        tracker.status = { state: 'joined', flags: ['JOINED'] };
        tracker.readings = demoReadings;
      } else {
        lastTtnExport = { devEui: demoCfg.deviceEui, joinEui: '0000000000000000', appKey: '00'.repeat(16), band: 5 };
        startTracker('apply');
        if (trackerDemo === 'restart') { setDeviceSectionsVisible(false); tracker.phase = 'reconnecting'; tracker.attempt = 2; }
        else {
          tracker.phase = 'live';
          tracker.restartAt = Date.now() - (trackerDemo === 'stuck' ? 400000 : trackerDemo === 'joined' ? 140000 : 102000);
          tracker.reconnectedIn = 9000;
          tracker.liveAt = tracker.restartAt + 9000;
          tracker.readings = demoReadings;
          tracker.status = { state: trackerDemo === 'joined' ? 'joined' : 'joining', flags: [trackerDemo === 'joined' ? 'JOINED' : 'JOINING'] };
          if (trackerDemo === 'joined') tracker.joinedAt = tracker.restartAt + 130000;
        }
      }
      renderTracker();
    });
  }
</script>
