            <div id="open-old-fw-banner" class="hidden mt-3 p-3.5 rounded-control bg-amber-500/15 border border-amber-400/40 text-xs space-y-2.5 leading-relaxed">
              <p class="font-bold text-amber-300">Update the firmware first</p>
              <p class="text-amber-200/90">
                The station runs <span id="open-old-fw-ver" class="font-mono">V4.3</span>, which has a single network identity.
                The update stores the WeatherXM identity as profile 0, so setting up your own network never overwrites it.
              </p>
              <button
                id="btn-goto-flash-v49"
                type="button"
                class="w-full py-2.5 px-4 rounded-control text-xs font-bold text-white bg-amber-600 hover:bg-amber-500 cursor-pointer"
              >
                Update firmware now
              </button>
            </div>

            <!-- Saved custom network -->
            <div id="group-switch-open-stored" class="hidden mt-3 p-3.5 rounded-control bg-emerald-500/10 border border-emerald-500/30 text-xs space-y-2.5 leading-relaxed">
              <p id="open-stored-title" class="font-bold text-emerald-300">Your network settings are saved on the station</p>
              <p id="open-stored-desc" class="text-emerald-200/80">Switch to them in one click, or change them below.</p>
              <button
                id="btn-switch-open-stored"
                type="button"
                class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-emerald-700/80 border border-emerald-500/40 hover:bg-emerald-600 cursor-pointer disabled:opacity-50 disabled:cursor-wait"
              >
                Switch to my saved network
              </button>
            </div>

            <!-- Network settings form -->
            <details id="open-form-details" class="mt-3 pt-3 border-t border-wxm-cloud/10 group" open>
              <summary class="flex items-center justify-between cursor-pointer select-none list-none">
                <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Network settings</span>
                <span class="text-[11px] text-wxm-mist flex items-center gap-1">
                  LoRaWAN 1.0.4 · OTAA · FPort 99
                  <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>

              <fieldset id="open-form" class="mt-3 space-y-3 disabled:opacity-40">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="cfg-band" class="block text-xs font-semibold text-wxm-cloud mb-1">Frequency region</label>
                    <select id="cfg-band" class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-live">
                      <option value="5">EU868 (Europe 868 MHz)</option>
                      <option value="8">US915 (North America 915 MHz)</option>
                      <option value="1">AU915 (Australia 915 MHz)</option>
                      <option value="15">AS923-1 (Asia 923 MHz)</option>
                      <option value="7">IN865 (India 865 MHz)</option>
                      <option value="6">KR920 (Korea 920 MHz)</option>
                      <option value="9">RU864 (Russia 864 MHz)</option>
                    </select>
                  </div>
                  <div>
                    <label for="cfg-interval" class="block text-xs font-semibold text-wxm-cloud mb-1">Upload interval</label>
                    <select id="cfg-interval" class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-live">
                      <option value="5" selected>5 minutes (recommended for TTN)</option>
                      <option value="10">10 minutes (weak signal, SF9+)</option>
                      <option value="15">15 minutes (battery saving)</option>
                      <option value="30">30 minutes</option>
                      <option value="3">3 minutes (private ChirpStack only)</option>
                    </select>
                  </div>
                </div>

                <div id="group-subband">
                  <label for="cfg-subband" class="block text-xs font-semibold text-wxm-cloud mb-1">Channel sub-band (FSB)</label>
                  <select id="cfg-subband" class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-live">
                    <option value="1">Sub-band 2 (channels 8-15) — standard for TTN and ChirpStack</option>
                    <option value="0">Sub-band 1 (channels 0-7)</option>
                    <option value="2">Sub-band 3 (channels 16-23)</option>
                    <option value="3">Sub-band 4 (channels 24-31)</option>
                    <option value="4">Sub-band 5 (channels 32-39)</option>
                    <option value="5">Sub-band 6 (channels 40-47)</option>
                    <option value="6">Sub-band 7 (channels 48-55)</option>
                    <option value="7">Sub-band 8 (channels 56-63)</option>
                  </select>
                </div>

                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="cfg-joineui" class="text-xs font-semibold text-wxm-cloud">JoinEUI / AppEUI (16 hex)</label>
                    <span class="text-[10px] text-wxm-mist font-mono">MSB</span>
                  </div>
                  <input id="cfg-joineui" type="text" maxlength="23" placeholder="0000000000000000" autocomplete="off" spellcheck="false"
                    class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-live uppercase" />
                </div>

                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="cfg-appkey" class="text-xs font-semibold text-wxm-cloud">AppKey (32 hex)</label>
                    <button id="btn-gen-appkey" type="button" class="text-[11px] font-semibold text-emerald-300 hover:text-white cursor-pointer">Generate random</button>
                  </div>
                  <input id="cfg-appkey" type="text" maxlength="47" placeholder="00112233445566778899AABBCCDDEEFF" autocomplete="off" spellcheck="false"
                    class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-live uppercase" />
                </div>

                <label class="flex items-start gap-2.5 text-[11px] text-wxm-mist leading-relaxed cursor-pointer select-none">
                  <input id="cfg-gnss" type="checkbox" class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-live focus:ring-0 cursor-pointer" />
                  <span>
                    <strong class="text-white">Send GNSS location scans</strong> (optional). About once a day a raw satellite scan
                    (<span class="font-mono">0xF3</span> on FPort 99) that you can resolve later. Needs your server to answer LoRaWAN DeviceTimeReq (TTN and ChirpStack do).
                    <span id="cfg-gnss-note" class="hidden text-amber-300">Needs the latest firmware: update the station first.</span>
                  </span>
                </label>

                <p id="open-form-key-note" class="hidden text-[11px] text-amber-300 leading-relaxed">
                  Saving replaces the network settings stored on the station. The AppKey above is new: register it on your network server, or paste the one you already use.
                </p>
                <p class="text-[11px] text-wxm-mist leading-relaxed">
                  TTN allows 30 s of airtime per device per day; a 24-byte uplink takes about 82 ms at SF7, so use 5 minutes or more on TTN.
                </p>
              </fieldset>
            </details>

            <div class="mt-3 p-3 rounded-control bg-amber-500/10 border border-amber-500/30 text-[11px] text-amber-200/90 leading-relaxed">
              <ul class="list-disc list-inside space-y-1">
                <li>On your network the station earns no $WXM rewards and its data is not in the WeatherXM app.</li>
                <li id="warn-keys">Checking whether this firmware can keep the WeatherXM keys...</li>
              </ul>
            </div>
          </div>

          <div id="open-apply-area" class="mt-4 pt-4 border-t border-wxm-cloud/15 space-y-2">
            <button
              id="btn-apply"
              type="button"
              class="w-full py-3 px-4 rounded-control text-sm btn-primary-green flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" /></svg>
              <span id="btn-apply-label">Switch to My Network</span>
            </button>
            <button id="btn-ttn-export-form" type="button" title="The Things Network: End devices > Import end devices > The Things Stack JSON. The file holds your AppKey: keep it private."
              class="w-full py-2 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-live/60 cursor-pointer inline-flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download TTN import file (.json, includes the decoder)
            </button>
          </div>
        </div>
      </div>

      <p id="form-error" class="hidden mt-4 p-3 rounded-control bg-red-500/10 border border-red-500/30 text-xs text-red-300 leading-relaxed font-semibold" role="alert"></p>
    </div>
  </section>

  <!-- ===================== 3. Operations in progress / results ===================== -->
  <section class="max-w-2xl mx-auto px-4 sm:px-8">
    <!-- Network switch progress -->
    <div id="view-progress" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin"></div>
        <div>
          <h3 class="text-sm font-bold text-white">Configuring the station...</h3>
          <p id="progress-step-text" class="text-xs text-wxm-mist">Applying LoRaWAN parameters over Bluetooth</p>
        </div>
      </div>
      <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
        <div id="progress-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
      </div>
    </div>

    <!-- Firmware update -->
    <div id="view-dfu" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
      <div class="flex items-center gap-3">
        <div id="dfu-spinner" class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin shrink-0"></div>
        <div class="min-w-0">
          <h3 id="dfu-title" class="text-sm font-bold text-white">Updating firmware</h3>
          <p id="dfu-step" class="text-xs text-wxm-mist leading-relaxed">Preparing...</p>
        </div>
      </div>
      <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
        <div id="dfu-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
      </div>
      <p id="dfu-detail" class="text-[11px] text-wxm-mist leading-relaxed">Keep the station powered and this device within a few metres until the update finishes.</p>
      <div id="dfu-name-hint" class="hidden p-3 rounded-control bg-wxm-abyss/80 border border-wxm-zenith/30 text-[11.5px] text-wxm-cloud leading-relaxed space-y-1">
        <p class="font-bold text-white">Look for a different name in the Bluetooth list</p>
        <p>
          In update mode the station is a separate Bluetooth device called
          <strong id="dfu-name-hint-value" class="font-mono text-wxm-zenith">DfuWX…</strong>
          (or <span class="font-mono">DfuTarg</span>), <strong>not</strong> "WeatherXM WS2001 …". Only update-mode devices are listed.
          It returns to its normal name after the update.
        </p>
      </div>
      <button id="btn-dfu-pick" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Continue: select the station's update mode</button>
      <button id="btn-dfu-reconnect" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Reconnect to the station</button>
      <button id="btn-dfu-close" type="button" class="hidden w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">Close</button>
    </div>

    <!-- Result -->
    <div id="view-success" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-emerald-500/50 backdrop-blur-md shadow-card space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        </div>
        <div>
          <h3 id="success-title" class="text-sm font-bold text-white">Connected to your network!</h3>
          <p id="success-sub" class="text-xs text-emerald-300">Settings written to flash. The station has rebooted to join your network.</p>
        </div>
      </div>
      <div id="success-steps" class="p-3.5 rounded-control bg-wxm-abyss/80 border border-wxm-cloud/10 text-xs text-wxm-mist space-y-2">
        <p><strong>Next steps:</strong></p>
        <ul class="list-disc pl-4 space-y-1">
          <li>Register the station in your network server (LoRaWAN 1.0.4, OTAA, Class A). On TTN, import the file below: <strong>End devices &gt; Import end devices &gt; The Things Stack JSON</strong>. It already includes the payload decoder.</li>
          <li>On ChirpStack, add the <strong>payload decoder</strong> below to the device profile.</li>
          <li>Watch for the first Join-Request, typically within a minute after the restart. The station needs a reliable downlink to receive the Join-Accept.</li>
        </ul>
      </div>
      <button id="btn-ttn-export-success" type="button" class="hidden w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith cursor-pointer inline-flex items-center justify-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
        Download TTN import file (.json)
      </button>
      <button id="btn-done" type="button" class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">
        Done
      </button>
    </div>
  </section>

  <!-- ===================== Payload decoder ===================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-8 mt-6">
    <div class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/25 backdrop-blur-md shadow-card px-5 py-4 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex items-start gap-3 min-w-0 flex-1">
        <div class="w-10 h-10 shrink-0 rounded-control bg-wxm-midnight/70 border border-wxm-cloud/20 flex items-center justify-center text-wxm-zenith">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
        </div>
        <div class="min-w-0">
          <h3 class="text-sm font-bold text-white">Payload decoder</h3>
          <p class="text-xs text-wxm-mist leading-relaxed">
            One script for The Things Stack v3, ChirpStack v4 and v3. It decodes the 24-byte frame on FPort 99, labels the modem messages on FPort 199 and reads the legacy FPort 3 format.
            Paste it into TTN (Payload formatters &gt; Uplink &gt; Custom Javascript) or ChirpStack (Device profile &gt; Codec).
          </p>
          <span id="decoder-copy-toast" class="hidden text-[11px] font-semibold text-emerald-300 block mt-1"></span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 shrink-0">
        <button id="btn-show-decoder" type="button" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5">Show</button>
        <button id="btn-copy-decoder" type="button" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5">Copy decoder</button>
        <a href="/decoders/ws2001_uplink_decoder.js" download="ws2001_uplink_decoder.js" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5">Download .js</a>
      </div>
      <dialog
        id="decoder-dialog"
        aria-labelledby="decoder-dialog-title"
        class="m-auto w-[min(56rem,calc(100vw-2rem))] max-h-[85vh] rounded-card border border-wxm-cloud/20 bg-wxm-abyss p-0 text-white backdrop:bg-black/70"
      >
        <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-wxm-cloud/20">
          <h3 id="decoder-dialog-title" class="text-sm font-bold">ws2001_uplink_decoder.js</h3>
          <div class="flex items-center gap-2">
            <button id="btn-dialog-copy-decoder" type="button" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith cursor-pointer">Copy</button>
            <button id="btn-close-decoder" type="button" aria-label="Close" class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">Close</button>
          </div>
        </div>
        <div class="overflow-auto max-h-[calc(85vh-3.5rem)] text-xs [&_pre]:p-4 [&_pre]:m-0">
          <Code code={WS2001_UPLINK_DECODER} lang="js" theme="github-dark" />
        </div>
      </dialog>
    </div>
  </section>

  <!-- ===================== Bluetooth console ===================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-8 mt-5">
    <div class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/25 backdrop-blur-md overflow-hidden shadow-card">
