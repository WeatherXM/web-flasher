---
import SiteLayout from '../layouts/SiteLayout.astro';
import BleBrowserNotice from '../components/ws1300/BleBrowserNotice.astro';
---

<SiteLayout
  title="WS2001 (H2) Open LoRaWAN Configurator — WeatherXM"
  description="Configure your WeatherXM WS2001 (H2) weather station for The Things Network, ChirpStack, or generic LoRaWAN networks over Bluetooth."
  device="ws2001"
>
  <BleBrowserNotice />

  <section class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-start">
      <!-- Left: introduction & documentation -->
      <div class="space-y-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-wxm-storm/40 border border-wxm-cloud/20 text-xs font-semibold text-white">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Your own LoRaWAN network · TTN · ChirpStack
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight text-balance">
          Configure WS2001 (H2) for Any LoRaWAN Network
        </h1>
        <p class="text-sm sm:text-base text-wxm-mist leading-relaxed">
          The H2 starts on the <strong>WeatherXM network</strong>. You can point it at The Things Network (TTN), ChirpStack or any other LoRaWAN network server.
          The hardware is the same as Seeed Studio's SenseCAP S2120 8-in-1 station, but it runs <strong>WeatherXM's own firmware</strong>, which does more:
          it samples every 12 seconds and sends one compact 24-byte frame with temperature, humidity, pressure, wind speed and direction,
          <strong>wind gust</strong>, rain rate, <strong>rain total</strong>, light and UV, signed by the station's secure element.
          On firmware V4.5 and later the WeatherXM keys are kept, so you can switch back at any time.
        </p>

        <p class="text-sm">
          <a href="https://weatherxm.com/stations/" class="inline-flex items-center gap-1.5 font-semibold text-wxm-zenith hover:text-white underline underline-offset-4 decoration-wxm-cloud/30">
            Explore WeatherXM stations <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>

      <!-- Right: Action card -->
      <div class="space-y-4">
        <!-- 1. Connect view -->
        <div id="view-connect" class="p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-beacon/40 backdrop-blur-md shadow-card space-y-5">
          <div class="flex items-center gap-5">
            <img
              src="/h2.webp"
              alt="WeatherXM WS2001 (H2) Weather Station"
              width="388"
              height="228"
              class="w-24 sm:w-28 h-auto flex-shrink-0 drop-shadow-[0_8px_16px_rgba(0,0,0,0.5)]"
            />
            <div class="space-y-1">
              <span class="text-[11px] font-extrabold text-wxm-zenith uppercase tracking-widest block">Bluetooth connection</span>
              <h2 class="text-lg font-bold">Connect to WS2001 (H2)</h2>
              <p class="text-xs text-wxm-mist">Make sure your station is powered on and within Bluetooth range.</p>
            </div>
          </div>

          <button
            id="btn-connect"
            type="button"
            class="w-full py-4 px-6 rounded-control text-base btn-primary-beacon flex items-center justify-center gap-3 cursor-pointer disabled:opacity-50 disabled:cursor-wait focus:outline-none focus-visible:ring-2 focus-visible:ring-wxm-zenith"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7l10 10-5 5V2l5 5L7 17" />
            </svg>
            <span id="btn-connect-label">Connect to WS2001 (H2)</span>
          </button>
          <label class="flex items-start gap-2.5 text-xs text-wxm-mist leading-relaxed cursor-pointer select-none">
            <input id="chk-auto-update" type="checkbox" checked class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-beacon focus:ring-0 cursor-pointer" />
            <span><strong class="text-white">Update the station firmware automatically</strong> when a newer WeatherXM release is available (recommended). Settings, keys and rain data are kept. During the update you pick the station a second time, when it appears as <span class="font-mono text-wxm-cloud">DfuWX…</span>.</span>
          </label>
          <p id="connect-error" class="hidden text-xs text-red-300 leading-relaxed" role="alert"></p>
        </div>

        <!-- 2. Device info card (unhides when connected) -->
        <div id="view-device" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-cloud/20 backdrop-blur-md shadow-card space-y-5">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <span class="text-[11px] font-extrabold text-wxm-live uppercase tracking-widest flex items-center gap-1.5">
                <span class="indicator-dot-green"></span> Connected
              </span>
              <h2 id="dev-name" class="text-lg font-bold mt-0.5 truncate">WeatherXM WS2001 (H2)</h2>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button
                id="btn-refresh"
                type="button"
                title="Refresh station configuration and status"
                class="px-2.5 py-1 rounded-control text-xs font-semibold text-wxm-mist hover:text-white border border-wxm-cloud/20 hover:bg-wxm-storm/40 transition-colors flex items-center gap-1.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <svg id="icon-refresh" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span id="label-refresh">Refresh</span>
              </button>
              <button
                id="btn-disconnect"
                type="button"
                title="Disconnect from station"
                class="px-2.5 py-1 rounded-control text-xs font-semibold text-wxm-mist hover:text-red-300 hover:border-red-500/40 hover:bg-red-500/10 border border-wxm-cloud/20 transition-colors flex items-center gap-1.5 cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span>Disconnect</span>
              </button>
            </div>
          </div>

          <!-- DevEUI full-width banner (guarantees full 23-char DevEUI is always visible) -->
          <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">DevEUI</span>
              <span id="stat-deveui" class="font-mono font-bold text-white text-xs sm:text-sm tracking-wide select-all block mt-0.5">–</span>
            </div>
            <button
              id="btn-copy-deveui"
              type="button"
              title="Copy DevEUI"
              class="px-2.5 py-1 rounded-control text-xs font-semibold text-wxm-mist hover:text-white border border-wxm-cloud/20 hover:bg-wxm-storm/40 transition-colors flex items-center gap-1.5 shrink-0 cursor-pointer"
            >
              <svg id="icon-copy-deveui" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="label-copy-deveui">Copy</span>
            </button>
          </div>

          <!-- Device stats grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10 col-span-2 sm:col-span-2">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Network</span>
              <span id="stat-mode" class="font-semibold text-white mt-0.5 block truncate text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Region / Band</span>
              <span id="stat-band" class="font-semibold text-white mt-0.5 block truncate text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Firmware</span>
              <span id="stat-ver" class="font-mono text-white mt-0.5 block text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Battery</span>
              <span id="stat-bat" class="font-semibold text-white mt-0.5 block text-[11px]">–</span>
            </div>

            <div class="p-2.5 rounded-control bg-wxm-abyss/70 border border-wxm-cloud/10">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Interval</span>
              <span id="stat-interval" class="font-semibold text-white mt-0.5 block text-[11px]">–</span>
            </div>
          </div>

          <!-- Firmware update (manual) -->
          <div id="group-fwupdate" class="p-3 rounded-control bg-wxm-abyss/60 border border-wxm-cloud/15 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="text-[10px] uppercase tracking-wider text-wxm-mist block font-semibold">Firmware update</span>
              <span id="fw-update-text" class="font-semibold text-white block mt-0.5 text-[11px]">Checking for updates...</span>
            </div>
            <button
              id="btn-fw-update"
              type="button"
              disabled
              class="px-3 py-1.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm hover:border-wxm-zenith shrink-0 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Update
            </button>
          </div>

          <!-- Disconnect / Reboot notice -->
          <div class="p-3 rounded-control bg-wxm-abyss/60 border border-wxm-cloud/15 text-xs text-wxm-mist space-y-1.5 leading-relaxed">
            <div class="flex items-center gap-2 font-bold text-white text-xs">
              <svg class="w-3.5 h-3.5 text-wxm-zenith shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Note</span>
            </div>
            <ul class="list-disc list-inside text-[11px] text-wxm-mist space-y-1 ml-0.5">
              <li>Disconnecting reboots the station and triggers a LoRaWAN <code class="text-wxm-zenith bg-wxm-abyss px-1 py-0.5 rounded">Join-Request</code>.</li>
              <li>Click <code class="text-wxm-zenith bg-wxm-abyss px-1 py-0.5 rounded">Refresh</code> to reload any <strong class="text-white">Unknown</strong> values.</li>
            </ul>
          </div>

          <!-- Switch back to WeatherXM (firmware V4.5+, custom profile active) -->
          <div id="group-switchback" class="hidden p-3.5 rounded-control bg-emerald-500/10 border border-emerald-500/30 text-xs space-y-2 leading-relaxed">
            <p class="font-bold text-emerald-300">This station is on your own LoRaWAN network.</p>
            <p class="text-emerald-200/80">Its WeatherXM keys are stored on the station. Switch back to rejoin the WeatherXM network (3-minute uplinks); your network keys stay stored for later.</p>
            <button
              id="btn-switchback"
              type="button"
              class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-emerald-700/70 border border-emerald-500/40 hover:bg-emerald-600 cursor-pointer disabled:opacity-50 disabled:cursor-wait"
            >
              Switch back to WeatherXM
            </button>
          </div>

          <!-- Configuration Form -->
          <div class="border-t border-wxm-cloud/15 pt-5 space-y-4">
            <div>
              <h3 class="text-sm font-bold text-white">LoRaWAN Network Configuration</h3>
              <p class="text-xs text-wxm-mist mt-1">
                LoRaWAN 1.0.4 · OTAA · Class A · WeatherXM 24-byte frame on FPort 99
              </p>
            </div>

            <div class="space-y-3">
              <!-- Frequency Region -->
              <div>
                <label for="cfg-band" class="block text-xs font-semibold text-wxm-cloud mb-1">Frequency Region</label>
                <select
                  id="cfg-band"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-zenith"
                >
                  <option value="5">EU868 (Europe 868 MHz)</option>
                  <option value="8">US915 (North America 915 MHz)</option>
                  <option value="1">AU915 (Australia 915 MHz)</option>
                  <option value="15">AS923-1 (Asia 923 MHz)</option>
                  <option value="7">IN865 (India 865 MHz)</option>
                  <option value="6">KR920 (Korea 920 MHz)</option>
                  <option value="9">RU864 (Russia 864 MHz)</option>
                </select>
              </div>

              <!-- Sub-band (US915 / AU915) -->
              <div id="group-subband">
                <label for="cfg-subband" class="block text-xs font-semibold text-wxm-cloud mb-1">
                  Channel Sub-Band (FSB)
                </label>
                <select
                  id="cfg-subband"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-zenith"
                >
                  <option value="1">Sub-Band 2 (Channels 8-15) — Standard for TTN & ChirpStack</option>
                  <option value="0">Sub-Band 1 (Channels 0-7)</option>
                  <option value="2">Sub-Band 3 (Channels 16-23)</option>
                  <option value="3">Sub-Band 4 (Channels 24-31)</option>
                  <option value="4">Sub-Band 5 (Channels 32-39)</option>
                  <option value="5">Sub-Band 6 (Channels 40-47)</option>
                  <option value="6">Sub-Band 7 (Channels 48-55)</option>
                  <option value="7">Sub-Band 8 (Channels 56-63)</option>
                </select>
              </div>

              <!-- JoinEUI / AppEUI -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="cfg-joineui" class="text-xs font-semibold text-wxm-cloud">JoinEUI / AppEUI (16 hex chars)</label>
                  <span class="text-[10px] text-wxm-mist font-mono">MSB</span>
                </div>
                <input
                  id="cfg-joineui"
                  type="text"
                  maxlength="23"
                  placeholder="0000000000000000"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-zenith uppercase"
                />
              </div>

              <!-- AppKey -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="cfg-appkey" class="text-xs font-semibold text-wxm-cloud">AppKey (32 hex chars)</label>
                  <button
                    id="btn-gen-appkey"
                    type="button"
                    class="text-[11px] font-semibold text-wxm-zenith hover:text-white cursor-pointer"
                  >
                    Generate Random
                  </button>
                </div>
                <input
                  id="cfg-appkey"
                  type="text"
                  maxlength="47"
                  placeholder="00112233445566778899AABBCCDDEEFF"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white font-mono text-xs focus:outline-none focus:border-wxm-zenith uppercase"
                />
              </div>

              <!-- Upload Interval -->
              <div>
                <label for="cfg-interval" class="block text-xs font-semibold text-wxm-cloud mb-1">Upload Interval</label>
                <select
                  id="cfg-interval"
                  class="w-full px-3 py-2 rounded-control bg-wxm-abyss border border-wxm-cloud/20 text-white text-xs font-semibold focus:outline-none focus:border-wxm-zenith"
                >
                  <option value="5" selected>5 minutes (recommended, within TTN fair use)</option>
                  <option value="10">10 minutes (weak signal, SF9 or slower on TTN)</option>
                  <option value="15">15 minutes (battery saving)</option>
                  <option value="30">30 minutes</option>
                  <option value="3">3 minutes (private ChirpStack only)</option>
                </select>
                <p class="text-[11px] text-wxm-mist mt-1 leading-relaxed">
                  TTN allows 30 s of airtime per device per day. A 24-byte uplink takes about 82 ms at SF7, so 3-minute uplinks exceed it; use 5 minutes or more.
                </p>
              </div>
            </div>

            <!-- Warning Banner -->
            <div class="p-3.5 rounded-control bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs space-y-2 leading-relaxed">
              <div class="flex items-center gap-2 font-bold text-amber-400">
                <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>Warning</span>
              </div>
              <ul class="list-disc list-inside text-[11px] text-amber-300 space-y-1.5 ml-0.5">
                <li>While it is on your network, the station is off the WeatherXM network and does not earn $WXM token rewards.</li>
                <li id="warn-keys">Checking whether this firmware can keep the WeatherXM keys...</li>
                <li>Switching back to WeatherXM may affect proofs, QoD, and $WXM token rewards.</li>
              </ul>
            </div>

            <!-- Validation alert -->
            <p id="form-error" class="hidden text-xs text-red-300 leading-relaxed font-semibold"></p>

            <!-- Submit button -->
            <button
              id="btn-apply"
              type="button"
              class="w-full py-3.5 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Apply &amp; Connect to My Network</span>
            </button>
          </div>
        </div>

        <!-- 3. Progress card (during write) -->
        <div id="view-progress" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin"></div>
            <div>
              <h3 class="text-sm font-bold text-white">Configuring Station...</h3>
              <p id="progress-step-text" class="text-xs text-wxm-mist">Applying LoRaWAN parameters over Bluetooth</p>
            </div>
          </div>
          <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
            <div id="progress-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
          </div>
        </div>

        <!-- 3b. Firmware update card -->
        <div id="view-dfu" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-wxm-zenith/40 backdrop-blur-md shadow-card space-y-4">
          <div class="flex items-center gap-3">
            <div id="dfu-spinner" class="w-5 h-5 border-2 border-wxm-zenith border-t-transparent rounded-full animate-spin shrink-0"></div>
            <div class="min-w-0">
              <h3 id="dfu-title" class="text-sm font-bold text-white">Updating firmware</h3>
              <p id="dfu-step" class="text-xs text-wxm-mist leading-relaxed">Preparing...</p>
            </div>
          </div>
          <div class="w-full bg-wxm-abyss rounded-full h-2 overflow-hidden border border-wxm-cloud/10">
            <div id="dfu-bar" class="bg-wxm-zenith h-full transition-all duration-300 w-0"></div>
          </div>
          <p id="dfu-detail" class="text-[11px] text-wxm-mist leading-relaxed">Keep the station powered and this device within a few metres until the update finishes.</p>
          <div id="dfu-name-hint" class="hidden p-3 rounded-control bg-wxm-abyss/80 border border-wxm-zenith/30 text-[11.5px] text-wxm-cloud leading-relaxed space-y-1">
            <p class="font-bold text-white">Look for a different name in the Bluetooth list</p>
            <p>
              In update mode the station is a separate Bluetooth device called
              <strong id="dfu-name-hint-value" class="font-mono text-wxm-zenith">DfuWX…</strong>
              (or <span class="font-mono">DfuTarg</span>), <strong>not</strong> "WeatherXM WS2001 …". Only update-mode devices are listed.
              It returns to its normal name after the update.
            </p>
          </div>
          <button id="btn-dfu-pick" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Continue: select the station's update mode</button>
          <button id="btn-dfu-reconnect" type="button" class="hidden w-full py-3 px-5 rounded-control text-sm btn-primary-beacon flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-wait">Reconnect to the station</button>
          <button id="btn-dfu-close" type="button" class="hidden w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer">Close</button>
        </div>

        <!-- 4. Success card -->
        <div id="view-success" class="hidden p-6 rounded-card bg-wxm-midnight/90 border-2 border-emerald-500/50 backdrop-blur-md shadow-card space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <h3 id="success-title" class="text-sm font-bold text-white">Connected to your network!</h3>
              <p id="success-sub" class="text-xs text-emerald-300">Settings written to flash. The station has rebooted to join your network.</p>
            </div>
          </div>
          <div class="p-3.5 rounded-control bg-wxm-abyss/80 border border-wxm-cloud/10 text-xs text-wxm-mist space-y-2">
            <p><strong>Next steps:</strong></p>
            <ul id="success-steps" class="list-disc pl-4 space-y-1">
              <li>Register the <strong>DevEUI</strong>, <strong>JoinEUI</strong> and <strong>AppKey</strong> in your TTN or ChirpStack application (LoRaWAN 1.0.4, OTAA, Class A).</li>
              <li>Install the <strong>WeatherXM decoder</strong> below: one script for TTN v3, ChirpStack v4 and v3 that decodes the 24-byte frame on FPort 99, including wind gust and rain total.</li>
              <li>Wait for the device's first Join-Request (typically within 30-60 seconds after boot).</li>
            </ul>
          </div>
          <button
            id="btn-done"
            type="button"
            class="w-full py-2.5 rounded-control text-xs font-bold text-white bg-wxm-storm/60 border border-wxm-cloud/20 hover:bg-wxm-storm cursor-pointer"
          >
            Configure Another Device
          </button>
        </div>

        <!-- Payload Decoders -->
        <div class="rounded-card border border-wxm-cloud/20 bg-wxm-abyss/60 p-4 space-y-2.5">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">Payload Decoder</h3>
          <p class="text-[11px] text-wxm-mist leading-relaxed">
            One script decodes the WeatherXM 24-byte frame (FPort 99) and the legacy FPort 3 format. Paste it into TTN (Payload formatters &gt; Custom JavaScript) or ChirpStack (Device profile &gt; Codec), or
            <a href="/decoders/ws2001_uplink_decoder.js" download class="text-wxm-zenith underline hover:text-white">download ws2001_uplink_decoder.js</a>.
          </p>
          <div class="flex flex-wrap gap-2">
            <button
              id="btn-copy-ttn-decoder"
              type="button"
              title="Copy TTN v3 payload decoder"
              class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>
              TTN v3
            </button>
            <button
              id="btn-copy-chirpstack-decoder"
              type="button"
              title="Copy ChirpStack v4 payload decoder"
              class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>
              ChirpStack v4
            </button>
            <button
              id="btn-copy-chirpstack-v3-decoder"
              type="button"
              title="Copy ChirpStack v3 payload decoder"
              class="px-3 py-1.5 rounded-control text-xs font-bold bg-wxm-storm/60 border border-wxm-cloud/20 text-white hover:bg-wxm-storm hover:border-wxm-zenith transition-all cursor-pointer inline-flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>
              ChirpStack v3
            </button>
          </div>
          <span id="decoder-copy-toast" class="hidden text-[11px] font-semibold text-emerald-300 block"></span>
        </div>
      </div>
    </div>

    <ol class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-3">
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">1</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Stand next to the station</h3>
          <p class="text-xs text-wxm-mist leading-relaxed">Stay within a few metres during the update. A laptop or an Android phone both work.</p>
        </div>
      </li>
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">2</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Press the station RESET button once <span class="block sm:inline text-xs font-medium text-wxm-mist">(first-time pairing only)</span></h3>
          <p class="text-xs text-wxm-mist leading-relaxed">
            If the station has never been paired before, press <strong class="text-white font-semibold">RESET</strong> once. You only need this for the initial pairing; the station then stays visible over Bluetooth for 15 minutes.
            <strong class="text-amber-300 font-semibold">Don't hold RESET:</strong> holding it for 15 seconds resets the station's settings.
          </p>
        </div>
      </li>
      <li class="flex gap-3.5 p-4 rounded-card bg-wxm-midnight/60 border border-wxm-cloud/10">
        <span class="w-7 h-7 flex-shrink-0 rounded-full bg-wxm-beacon/20 border border-wxm-beacon/40 text-wxm-zenith text-xs font-bold flex items-center justify-center">3</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold">Connect and pick "WeatherXM WS2001"</h3>
          <p class="text-xs text-wxm-mist leading-relaxed">Click Connect to WS2001 (H2) and select the station. If your computer asks to pair, accept it and let the pairing prompt finish.</p>
        </div>
      </li>
    </ol>

    <!-- Communication Log -->
    <div class="mt-6 p-4 rounded-card bg-wxm-abyss/80 border border-wxm-cloud/15 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-wxm-cloud uppercase tracking-wider text-[10px]">Communication Log</span>
        <button id="btn-clear-log" type="button" class="text-wxm-mist hover:text-white text-[11px] cursor-pointer">Clear</button>
      </div>
      <div
        id="term-log"
        class="h-36 overflow-y-auto font-mono text-[11px] space-y-1 p-2 rounded bg-black/40 border border-wxm-cloud/10 text-wxm-mist"
      >
        <div>[READY] Waiting for Bluetooth connection...</div>
      </div>
    </div>
  </section>

  <!-- Final Confirmation Modal -->
  <div id="modal-ws2001-confirm" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-wxm-ink/80 backdrop-blur-sm">
    <div class="max-w-md w-full rounded-modal border border-amber-500/40 bg-wxm-midnight p-6 shadow-2xl relative text-left space-y-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-control bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Confirm Network Migration</h3>
          <p class="text-xs text-amber-400 font-medium">Leaving the WeatherXM network</p>
        </div>
      </div>

      <div class="space-y-3 py-3 border-y border-wxm-cloud/15 text-xs text-wxm-cloud">
        <p class="text-[12px] text-white leading-relaxed">
          You are about to move <strong id="modal-confirm-deveui" class="font-mono text-wxm-zenith"></strong> from the WeatherXM network to your own LoRaWAN network server.
        </p>
        <div class="p-3 rounded-control bg-wxm-abyss/80 border border-amber-500/25 text-amber-200/90 text-[11.5px] space-y-1.5">
          <p class="font-bold text-amber-400">Please acknowledge before proceeding:</p>
          <ul class="list-disc list-inside space-y-1 text-amber-200/80">
            <li>While it is on your network, the station is off the WeatherXM network and does not earn $WXM token rewards.</li>
            <li id="modal-warn-keys">Checking whether this firmware can keep the WeatherXM keys...</li>
            <li>Switching back to WeatherXM may affect proofs, QoD, and $WXM token rewards.</li>
          </ul>
        </div>
      </div>

      <div class="flex items-start gap-2.5 pt-1">
        <input type="checkbox" id="chk-confirm-irreversible" class="w-4 h-4 mt-0.5 rounded border-wxm-cloud/30 bg-wxm-abyss text-wxm-beacon focus:ring-0 cursor-pointer" />
        <label for="chk-confirm-irreversible" class="text-xs text-wxm-cloud cursor-pointer select-none leading-tight">
          I understand.
        </label>
      </div>

      <div class="pt-2 flex space-x-3 justify-end">
        <button
          id="btn-confirm-cancel"
          type="button"
          class="px-4 py-2.5 rounded-control text-xs font-semibold text-wxm-cloud hover:text-white border border-wxm-cloud/20 bg-wxm-storm/50 hover:bg-wxm-storm transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          id="btn-confirm-proceed"
          type="button"
          disabled
          class="px-5 py-2.5 rounded-control text-xs font-bold text-white bg-amber-600 hover:bg-amber-500 disabled:opacity-30 disabled:cursor-not-allowed shadow-card transition-all cursor-pointer"
        >
          Confirm & Switch
        </button>
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import { Ws2001AtClient, formatHexWithColons, type Ws2001DeviceConfig } from '../lib/ble/ws2001AtClient';
  import { TTN_PAYLOAD_DECODER, CHIRPSTACK_PAYLOAD_DECODER, CHIRPSTACK_V3_PAYLOAD_DECODER } from '../lib/ble/ws2001Decoder';
  import { trackTelemetry } from '../lib/telemetry';
  import { enterBootloader, requestBootloaderDevice, SecureDfuTransfer, makeBootloaderName, type Ws2001DfuPackage } from '../lib/ble/ws2001Dfu';
  import { fetchWs2001Manifest, latestRelease, downloadWs2001Release, isOutdated, type Ws2001Release } from '../lib/ble/ws2001Firmware';

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };

  let client: Ws2001AtClient | null = null;
  let currentConfig: Ws2001DeviceConfig | null = null;

  // Latest published firmware (public/firmware/ws2001/manifest.json)
  let latest: Ws2001Release | null = null;
  const latestReady = fetchWs2001Manifest()
    .then((m) => { latest = latestRelease(m); })
    .catch((e) => { latest = null; console.warn('WS2001 firmware list unavailable', e); });

  const termLog = $('term-log');

  const addLog = (msg: string, level = 'INFO') => {
    const row = document.createElement('div');
    const time = new Date().toTimeString().slice(0, 8);
    let color = 'text-wxm-mist';
    if (level === 'CMD') color = 'text-wxm-zenith font-bold';
    if (level === 'RESP') color = 'text-emerald-300';
    if (level === 'WARN') color = 'text-amber-300';
    if (level === 'ERROR') color = 'text-red-400 font-bold';

    row.className = color;
    row.textContent = `[${time}] ${msg}`;
    termLog.appendChild(row);
    termLog.scrollTop = termLog.scrollHeight;
  };

  // Setup decoders copy buttons
  const decoderToast = $('decoder-copy-toast');
  const showDecoderToast = (text: string) => {
    decoderToast.textContent = text;
    decoderToast.classList.remove('hidden');
    setTimeout(() => decoderToast.classList.add('hidden'), 3500);
  };

  $('btn-copy-ttn-decoder').addEventListener('click', async () => {
    await navigator.clipboard.writeText(TTN_PAYLOAD_DECODER);
    showDecoderToast('Copied TTN v3 payload decoder to clipboard!');
  });

  $('btn-copy-chirpstack-decoder').addEventListener('click', async () => {
    await navigator.clipboard.writeText(CHIRPSTACK_PAYLOAD_DECODER);
    showDecoderToast('Copied ChirpStack v4 payload decoder to clipboard!');
  });

  $('btn-copy-chirpstack-v3-decoder').addEventListener('click', async () => {
    await navigator.clipboard.writeText(CHIRPSTACK_V3_PAYLOAD_DECODER);
    showDecoderToast('Copied ChirpStack v3 payload decoder to clipboard!');
  });

  $('btn-clear-log').addEventListener('click', () => {
    termLog.innerHTML = '<div>[CLEARED]</div>';
  });

  // Frequency band change handler (toggles sub-band selector)
  const bandSelect = $<HTMLSelectElement>('cfg-band');
  const groupSubband = $('group-subband');
  const updateSubbandVisibility = () => {
    const band = parseInt(bandSelect.value, 10);
    groupSubband.style.display = band === 8 || band === 1 ? 'block' : 'none';
  };
  bandSelect.addEventListener('change', updateSubbandVisibility);

  // Generate random 16-byte AppKey
  $('btn-gen-appkey').addEventListener('click', () => {
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);
    const hex = Array.from(bytes)
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('')
      .toUpperCase();
    $<HTMLInputElement>('cfg-appkey').value = hex;
  });



  function updateModeDisplay(cfg: Ws2001DeviceConfig) {
    const modeEl = $('stat-mode');
    const format = cfg.testModeType === 1 ? 'legacy FPort 3 format' : cfg.testModeType === 0 ? '24-byte frame' : 'format unknown';
    const onCustom = cfg.netProfile ? cfg.netProfile.active === 1 : cfg.testModeType === 1;
    const join = cfg.lorawanStatus === 'JOINED' ? ' · joined' : cfg.lorawanStatus === 'JOINING' ? ' · joining...' : '';
    if (onCustom) {
      modeEl.textContent = `Your network (${format})${join}`;
      modeEl.className = 'font-bold text-emerald-400 inline-block text-[11px]';
    } else if (cfg.netProfile || cfg.testModeType === 0) {
      modeEl.textContent = `WeatherXM (${format})${join}`;
      modeEl.className = 'font-bold text-amber-400 inline-block text-[11px]';
    } else {
      modeEl.textContent = 'Unknown';
      modeEl.className = 'font-bold text-zinc-400 inline-block text-[11px]';
    }

    const keysText = cfg.netProfile
      ? 'This firmware keeps the WeatherXM keys in a separate profile: you can switch back at any time.'
      : 'This firmware (older than V4.5) has a single key set: your network keys REPLACE the WeatherXM keys. Update the station to V4.5 first to keep them.';
    $('warn-keys').textContent = keysText;
    $('modal-warn-keys').textContent = keysText;
    $('group-switchback').classList.toggle('hidden', !(cfg.netProfile && cfg.netProfile.active === 1 && cfg.netProfile.weatherxmStored));
  }

  function updateFirmwarePanel(cfg: Ws2001DeviceConfig) {
    const btn = $<HTMLButtonElement>('btn-fw-update');
    const txt = $('fw-update-text');
    if (!latest) {
      txt.textContent = 'Firmware list unavailable';
      btn.disabled = true;
      return;
    }
    const outdated = isOutdated(cfg.version, latest.version);
    txt.textContent = outdated ? `${cfg.version} → ${latest.label} available` : `Up to date (${latest.label})`;
    txt.className = `font-semibold block mt-0.5 text-[11px] ${outdated ? 'text-amber-300' : 'text-emerald-300'}`;
    btn.textContent = outdated ? `Update to ${latest.label}` : `Reinstall ${latest.label}`;
    btn.disabled = false;
  }

  function populateDeviceView(cfg: Ws2001DeviceConfig) {
    currentConfig = cfg;
    updateFirmwarePanel(cfg);

    // Populate Device Status Card
    const devLabel = client?.deviceName || 'Station';
    $('dev-name').textContent = cfg.deviceModel !== 'Unknown' ? `${cfg.deviceModel} (${devLabel})` : devLabel;
    $('stat-deveui').textContent = cfg.formattedDevEui;
    $('stat-band').textContent = cfg.frequencyName;
    $('stat-ver').textContent = cfg.version;
    $('stat-bat').textContent = cfg.battery;
    $('stat-interval').textContent = cfg.uploadInterval !== null ? `${cfg.uploadInterval} min` : 'Unknown';

    updateModeDisplay(cfg);

    trackTelemetry({
      device_type: 'ws2001',
      serial_number: cfg.formattedDevEui || cfg.deviceEui,
      action: 'connected',
      firmware_source: cfg.version,
      status: 'success',
      details: {
        model: cfg.deviceModel,
        bleName: cfg.bleName,
        bleId: cfg.bleId,
        defEui: cfg.formattedDefEui || cfg.defEui,
        devCode: cfg.devCode,
        devAddr: cfg.devAddr,
        appEui: cfg.appEui,
        hardwareVersion: cfg.hardwareVersion,
        lorawanVersion: cfg.lorawanVersion,
        classType: cfg.classType,
        joinType: cfg.joinType,
        battery: cfg.battery,
        intervalMinutes: cfg.uploadInterval,
        mode: cfg.testModeType === 0 ? 'weatherxm' : cfg.testModeType === 1 ? 'open_lorawan' : 'unknown',
        netProfile: cfg.netProfile ? cfg.netProfile.active : null,
        band: cfg.frequencyName,
      },
    });

    // Prepopulate form with device current band
    if (cfg.frequencyBand !== null) {
      bandSelect.value = String(cfg.frequencyBand);
    }
    if (cfg.subBand !== null) {
      $<HTMLSelectElement>('cfg-subband').value = String(cfg.subBand);
    }
    updateSubbandVisibility();

    // Keep the TTN-friendly default unless the station is already on the customer's network
    const alreadyCustom = cfg.netProfile ? cfg.netProfile.active === 1 : cfg.testModeType === 1;
    if (cfg.uploadInterval !== null && alreadyCustom) {
      const intervalSelect = $<HTMLSelectElement>('cfg-interval');
      const val = String(cfg.uploadInterval);
      const hasOption = Array.from(intervalSelect.options).some((opt) => opt.value === val);
      if (!hasOption) {
        const customOpt = document.createElement('option');
        customOpt.value = val;
        customOpt.textContent = `${cfg.uploadInterval} minutes (current)`;
        intervalSelect.appendChild(customOpt);
      }
      intervalSelect.value = val;
    }

    // Never pre-fill the WeatherXM JoinEUI into a form meant for the customer's network
    if (alreadyCustom && cfg.appEui && cfg.appEui.length === 16) {
      $<HTMLInputElement>('cfg-joineui').value = cfg.appEui;
    } else {
      $<HTMLInputElement>('cfg-joineui').value = '0000000000000000';
    }
  }

  // Connect button handler
  const btnConnect = $<HTMLButtonElement>('btn-connect');
  const connectError = $('connect-error');

  btnConnect.addEventListener('click', async () => {
    connectError.classList.add('hidden');
    btnConnect.disabled = true;
    $('btn-connect-label').textContent = 'Connecting...';

    client = new Ws2001AtClient((msg, lvl) => addLog(msg, lvl));

    try {
      await client.connect();
      addLog('Connection established. Querying station info...');

      const cfg = await client.readFullConfig();
      await latestReady;
      populateDeviceView(cfg);

      // Show device view
      $('view-connect').classList.add('hidden');
      $('view-device').classList.remove('hidden');

      if (chkAutoUpdate.checked && latest && isOutdated(cfg.version, latest.version)) {
        addLog(`Station runs ${cfg.version}; updating to ${latest.label} automatically (option enabled).`, 'INFO');
        void runFirmwareUpdate('auto');
      }
    } catch (err) {
      addLog((err as Error).message, 'ERROR');
      connectError.textContent = (err as Error).message;
      connectError.classList.remove('hidden');
      // Release a half-open link so the next attempt starts clean
      await client?.disconnect().catch(() => {});
      client = null;
    } finally {
      btnConnect.disabled = false;
      $('btn-connect-label').textContent = 'Connect to WS2001 (H2)';
    }
  });

  // Copy DevEUI button with local inline feedback
  let copyDevEuiTimer: ReturnType<typeof setTimeout> | null = null;
  $('btn-copy-deveui').addEventListener('click', async () => {
    if (currentConfig?.deviceEui && currentConfig.deviceEui !== 'Unknown') {
      await navigator.clipboard.writeText(currentConfig.deviceEui);
      const btn = $<HTMLButtonElement>('btn-copy-deveui');
      const label = $('label-copy-deveui');
      const icon = $('icon-copy-deveui');

      label.textContent = 'Copied!';
      btn.classList.add('text-emerald-400', 'border-emerald-500/40');
      btn.classList.remove('text-wxm-mist');
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />';

      if (copyDevEuiTimer) clearTimeout(copyDevEuiTimer);
      copyDevEuiTimer = setTimeout(() => {
        label.textContent = 'Copy';
        btn.classList.remove('text-emerald-400', 'border-emerald-500/40');
        btn.classList.add('text-wxm-mist');
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />';
      }, 2000);
    }
  });

  // Refresh button handler
  $('btn-refresh').addEventListener('click', async () => {
    if (!client || !client.isConnected) return;
    const btnRefresh = $<HTMLButtonElement>('btn-refresh');
    const iconRefresh = $('icon-refresh');
    const labelRefresh = $('label-refresh');

    btnRefresh.disabled = true;
    iconRefresh.classList.add('animate-spin');
    labelRefresh.textContent = 'Refreshing...';

    try {
      addLog('Refreshing station configuration (AT+CONFIG=?, AT+TESTMODE_TYPE=?)...', 'INFO');
      const cfg = await client.readFullConfig();
      populateDeviceView(cfg);
      addLog('Station info refreshed successfully.', 'SUCCESS');
    } catch (err) {
      addLog(`Failed to refresh station info: ${(err as Error).message}`, 'WARN');
    } finally {
      btnRefresh.disabled = false;
      iconRefresh.classList.remove('animate-spin');
      labelRefresh.textContent = 'Refresh';
    }
  });

  // Disconnect button handler
  $('btn-disconnect').addEventListener('click', async () => {
    addLog('Disconnecting Bluetooth... Station will reboot and send a fresh LoRaWAN Join-Request.', 'INFO');
    if (client) {
      await client.disconnect();
      client = null;
    }
    $('view-device').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
  });

  // Apply configuration button
  const btnApply = $<HTMLButtonElement>('btn-apply');
  const formError = $('form-error');

  const modalConfirm = $('modal-ws2001-confirm');
  const modalConfirmDevEui = $('modal-confirm-deveui');
  const chkConfirm = $<HTMLInputElement>('chk-confirm-irreversible');
  const btnConfirmCancel = $<HTMLButtonElement>('btn-confirm-cancel');
  const btnConfirmProceed = $<HTMLButtonElement>('btn-confirm-proceed');

  let pendingMigrationParams: {
    band: number;
    subBand: number;
    joinEui: string;
    appKey: string;
    intervalMinutes: number;
  } | null = null;

  // Toggle proceed button based on checkbox acknowledgment
  chkConfirm.addEventListener('change', () => {
    btnConfirmProceed.disabled = !chkConfirm.checked;
  });

  // Cancel modal
  btnConfirmCancel.addEventListener('click', () => {
    modalConfirm.classList.add('hidden');
    pendingMigrationParams = null;
  });

  // Apply button clicked -> validate and show confirmation modal
  btnApply.addEventListener('click', () => {
    if (!client || !client.isConnected) {
      alert('Station is not connected.');
      return;
    }

    formError.classList.add('hidden');

    const band = parseInt(bandSelect.value, 10);
    const subBand = parseInt($<HTMLSelectElement>('cfg-subband').value, 10);
    const joinEuiRaw = $<HTMLInputElement>('cfg-joineui').value.trim();
    const appKeyRaw = $<HTMLInputElement>('cfg-appkey').value.trim();
    const interval = parseInt($<HTMLSelectElement>('cfg-interval').value, 10);

    if (isNaN(band)) {
      formError.textContent = 'Please select a valid frequency region.';
      formError.classList.remove('hidden');
      return;
    }

    // Validate JoinEUI
    let formattedJoinEui = '';
    try {
      formattedJoinEui = formatHexWithColons(joinEuiRaw, 8);
    } catch {
      formError.textContent = 'Invalid JoinEUI: must be exactly 16 hexadecimal characters (8 bytes).';
      formError.classList.remove('hidden');
      return;
    }

    // Validate AppKey
    let formattedAppKey = '';
    try {
      formattedAppKey = formatHexWithColons(appKeyRaw, 16);
    } catch {
      formError.textContent = 'Invalid AppKey: must be exactly 32 hexadecimal characters (16 bytes).';
      formError.classList.remove('hidden');
      return;
    }

    // Store parameters pending user confirmation
    pendingMigrationParams = {
      band,
      subBand,
      joinEui: formattedJoinEui,
      appKey: formattedAppKey,
      intervalMinutes: interval,
    };

    // Open confirmation modal
    modalConfirmDevEui.textContent = currentConfig?.formattedDevEui || currentConfig?.deviceEui || 'WS2001 Station';
    chkConfirm.checked = false;
    btnConfirmProceed.disabled = true;
    modalConfirm.classList.remove('hidden');
  });

  // Final confirmation proceed -> execute migration
  btnConfirmProceed.addEventListener('click', async () => {
    if (!pendingMigrationParams || !client || !client.isConnected) {
      modalConfirm.classList.add('hidden');
      return;
    }

    modalConfirm.classList.add('hidden');

    // Begin progress view
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const progressBar = $('progress-bar');
    const stepText = $('progress-step-text');

    const params = pendingMigrationParams;
    pendingMigrationParams = null;

    const serialNum = currentConfig?.formattedDevEui || currentConfig?.deviceEui;

    trackTelemetry({
      device_type: 'ws2001',
      serial_number: serialNum,
      action: 'flash_started',
      firmware_target: 'open_lorawan',
      status: 'in_progress',
      details: {
        model: currentConfig?.deviceModel || 'H2',
        bleName: currentConfig?.bleName,
        defEui: currentConfig?.formattedDefEui || currentConfig?.defEui,
        devCode: currentConfig?.devCode,
        devAddr: currentConfig?.devAddr,
        hardwareVersion: currentConfig?.hardwareVersion,
        lorawanVersion: currentConfig?.lorawanVersion,
        band: params.band,
        subBand: params.subBand,
        intervalMinutes: params.intervalMinutes,
      },
    });

    try {
      await client.configureOpenLoRaWan(
        params,
        (stepDesc, current, total) => {
          stepText.textContent = stepDesc;
          const percent = Math.round((current / total) * 100);
          progressBar.style.width = `${percent}%`;
          addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
        },
        // V4.5+: keys go into the custom profile. Older firmware: the user confirmed the overwrite in the modal.
        { useProfiles: Boolean(currentConfig?.netProfile), allowOverwrite: true },
      );
      $('success-title').textContent = 'Connected to your network!';
      $('success-sub').textContent = 'Settings written to flash. The station has rebooted to join your network.';
      $('success-steps').classList.remove('hidden');

      progressBar.style.width = '100%';
      $('view-progress').classList.add('hidden');
      $('view-success').classList.remove('hidden');

      trackTelemetry({
        device_type: 'ws2001',
        serial_number: serialNum,
        action: 'flash_completed',
        firmware_target: 'open_lorawan',
        status: 'success',
        details: {
          model: currentConfig?.deviceModel || 'H2',
          bleName: currentConfig?.bleName,
          defEui: currentConfig?.formattedDefEui || currentConfig?.defEui,
          devCode: currentConfig?.devCode,
          devAddr: currentConfig?.devAddr,
          hardwareVersion: currentConfig?.hardwareVersion,
          lorawanVersion: currentConfig?.lorawanVersion,
          previousVersion: currentConfig?.version,
          band: params.band,
          subBand: params.subBand,
          intervalMinutes: params.intervalMinutes,
          appEui: params.joinEui,
        },
      });
    } catch (err) {
      addLog(`Configuration failed: ${(err as Error).message}`, 'ERROR');
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = (err as Error).message;
      formError.classList.remove('hidden');

      trackTelemetry({
        device_type: 'ws2001',
        serial_number: serialNum,
        action: 'flash_failed',
        firmware_target: 'open_lorawan',
        status: 'failed',
        details: {
          model: currentConfig?.deviceModel || 'H2',
          bleName: currentConfig?.bleName,
          defEui: currentConfig?.formattedDefEui || currentConfig?.defEui,
          devCode: currentConfig?.devCode,
          devAddr: currentConfig?.devAddr,
          hardwareVersion: currentConfig?.hardwareVersion,
          lorawanVersion: currentConfig?.lorawanVersion,
          error: (err as Error).message,
        },
      });
    }
  });

  // --- Firmware update (auto on connect, or manual) ---
  const chkAutoUpdate = $<HTMLInputElement>('chk-auto-update');
  try {
    chkAutoUpdate.checked = localStorage.getItem('ws2001-auto-update') !== '0';
  } catch { /* storage unavailable: keep the default (on) */ }
  chkAutoUpdate.addEventListener('change', () => {
    try { localStorage.setItem('ws2001-auto-update', chkAutoUpdate.checked ? '1' : '0'); } catch { /* ignore */ }
  });

  let dfuName = '';
  let dfuPackage: Ws2001DfuPackage | null = null;
  let dfuRelease: Ws2001Release | null = null;
  let dfuFrom = '';
  let dfuSerial: string | undefined;

  function setDfu(step: string, percent: number, title = 'Updating firmware') {
    $('dfu-title').textContent = title;
    $('dfu-step').textContent = step;
    $('dfu-bar').style.width = `${Math.max(0, Math.min(100, percent))}%`;
  }
  function showDfuButtons(which: Array<'pick' | 'reconnect' | 'close'>) {
    $('btn-dfu-pick').classList.toggle('hidden', !which.includes('pick'));
    $('btn-dfu-reconnect').classList.toggle('hidden', !which.includes('reconnect'));
    $('btn-dfu-close').classList.toggle('hidden', !which.includes('close'));
    $('dfu-spinner').classList.toggle('hidden', which.length > 0);
    // Whenever the user has to pick the bootloader, explain that it has a different name
    $('dfu-name-hint-value').textContent = dfuName || 'DfuWX…';
    $('dfu-name-hint').classList.toggle('hidden', !which.includes('pick'));
  }
  function dfuFailed(err: unknown, canResume: boolean) {
    const msg = (err as Error).message;
    addLog(`Firmware update failed: ${msg}`, 'ERROR');
    setDfu(msg, 0, 'Firmware update failed');
    $('dfu-detail').textContent = canResume
      ? 'The station stays in update mode for about 2 minutes and keeps its current firmware. Try again to resume.'
      : 'The station was not changed.';
    $('btn-dfu-pick').textContent = 'Try again';
    showDfuButtons(canResume ? ['pick', 'close'] : ['close']);
    trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_failed', firmware_target: dfuRelease?.label,
      firmware_source: dfuFrom, status: 'failed', details: { error: msg } });
  }

  async function runFirmwareUpdate(trigger: 'auto' | 'manual') {
    if (!client || !client.gattServer || !latest || !currentConfig) return;
    dfuRelease = latest;
    dfuFrom = currentConfig.version;
    dfuSerial = currentConfig.formattedDevEui || currentConfig.deviceEui;
    $('view-device').classList.add('hidden');
    $('view-dfu').classList.remove('hidden');
    $('dfu-detail').textContent = 'Keep the station powered and this device within a few metres until the update finishes.';
    showDfuButtons([]);
    setDfu(`Downloading and verifying ${dfuRelease.label}...`, 1);
    trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_started', firmware_target: dfuRelease.label,
      firmware_source: dfuFrom, status: 'in_progress', details: { trigger } });
    try {
      dfuPackage = await downloadWs2001Release(dfuRelease);
      addLog(`${dfuRelease.label} verified: signed for the WS2001 bootloader (${dfuPackage.firmware.length} bytes).`);
    } catch (e) {
      dfuFailed(e, false);
      return;
    }
    try {
      dfuName = makeBootloaderName();
      setDfu('Restarting the station into update mode...', 3);
      await enterBootloader(client.gattServer, dfuName, addLog);
      await new Promise((r) => setTimeout(r, 2500));
    } catch (e) {
      dfuFailed(e, false);
      return;
    }
    // Browsers need a click to connect to the bootloader, which is a new Bluetooth device.
    setDfu(`The station is in update mode. Click Continue and pick "${dfuName}" in the Bluetooth list.`, 5);
    $('btn-dfu-pick').textContent = `Continue: select "${dfuName}"`;
    showDfuButtons(['pick']);
  }

  $('btn-fw-update').addEventListener('click', () => {
    if (!latest || !currentConfig) return;
    const outdated = isOutdated(currentConfig.version, latest.version);
    const question = outdated
      ? `Update this station from ${currentConfig.version} to ${latest.label}? It takes about a minute; settings and keys are kept.`
      : `Reinstall ${latest.label} on this station? It takes about a minute; settings and keys are kept.`;
    if (confirm(question)) void runFirmwareUpdate('manual');
  });

  $('btn-dfu-pick').addEventListener('click', async () => {
    if (!dfuPackage || !dfuRelease) return;
    showDfuButtons([]);
    let server: BluetoothRemoteGATTServer | null = null;
    try {
      const dev = await requestBootloaderDevice(dfuName);
      setDfu(`Connecting to ${dev.name ?? 'the bootloader'}...`, 6);
      const onProgress = (p: { stage: string; sent: number; total: number; kbPerSec: number }) => {
        if (p.stage === 'firmware') {
          const pct = 8 + (92 * p.sent) / p.total;
          setDfu(`Installing ${dfuRelease!.label}: ${Math.floor((100 * p.sent) / p.total)}% (${p.kbPerSec.toFixed(1)} KB/s)`, pct);
        }
      };
      // The first connection to a freshly rebooted bootloader often drops right away
      // ("GATT Server is disconnected"): retry a few times before asking the user.
      let transfer: SecureDfuTransfer | null = null;
      for (let attempt = 1; !transfer; attempt++) {
        try {
          server = await dev.gatt!.connect();
          transfer = await SecureDfuTransfer.open(server, addLog, onProgress);
        } catch (e) {
          if (attempt >= 3 || (e as Error).name === 'DfuError') throw e;
          addLog(`Bootloader connection dropped (${(e as Error).message}); retrying ${attempt}/2...`, 'WARN');
          try { server?.disconnect(); } catch { /* ignore */ }
          await new Promise((r) => setTimeout(r, 1500));
        }
      }
      const t0 = performance.now();
      setDfu('Sending the signed update header...', 7);
      await transfer.sendInit(dfuPackage.init);
      await transfer.sendFirmware(dfuPackage.firmware);
      addLog(`Transferred ${(dfuPackage.firmware.length / 1024).toFixed(1)} KB in ${((performance.now() - t0) / 1000).toFixed(0)} s.`);
      setDfu(`${dfuRelease.label} installed. The station is restarting (about 10 seconds).`, 100, 'Firmware updated');
      $('dfu-detail').textContent = 'Reconnect to check the new version and continue setting up the station.';
      showDfuButtons(['reconnect', 'close']);
      trackTelemetry({ device_type: 'ws2001', serial_number: dfuSerial, action: 'flash_completed', firmware_target: dfuRelease.label,
        firmware_source: dfuFrom, status: 'success' });
    } catch (e) {
      if ((e as Error).name === 'NotFoundError') {
        // Chooser cancelled: offer the button again
        setDfu(`Pick "${dfuName}" in the Bluetooth list to continue.`, 5);
        showDfuButtons(['pick', 'close']);
        return;
      }
      dfuFailed(e, true);
    } finally {
      try { server?.disconnect(); } catch { /* ignore */ }
    }
  });

  $('btn-dfu-reconnect').addEventListener('click', () => {
    $('view-dfu').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
    btnConnect.click(); // same user gesture opens the chooser
  });
  $('btn-dfu-close').addEventListener('click', () => {
    $('view-dfu').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
  });

  // Switch back to WeatherXM (firmware V4.5+)
  $('btn-switchback').addEventListener('click', async () => {
    if (!client || !client.isConnected || !currentConfig?.netProfile) return;
    if (!confirm('Switch this station back to the WeatherXM network? Your network keys stay stored on the station.')) return;
    const btn = $<HTMLButtonElement>('btn-switchback');
    btn.disabled = true;
    $('view-device').classList.add('hidden');
    $('view-progress').classList.remove('hidden');
    const serialNum = currentConfig.formattedDevEui || currentConfig.deviceEui;
    try {
      await client.switchBackToWeatherXm((stepDesc, current, total) => {
        $('progress-step-text').textContent = stepDesc;
        $('progress-bar').style.width = `${Math.round((current / total) * 100)}%`;
        addLog(`[${current}/${total}] ${stepDesc}`, 'RESP');
      });
      $('view-progress').classList.add('hidden');
      $('success-title').textContent = 'Back on the WeatherXM network!';
      $('success-sub').textContent = 'The station rebooted with its WeatherXM keys and will rejoin the WeatherXM network.';
      $('success-steps').classList.add('hidden');
      $('view-success').classList.remove('hidden');
      trackTelemetry({ device_type: 'ws2001', serial_number: serialNum, action: 'flash_completed', firmware_target: 'weatherxm', status: 'success', details: { model: currentConfig.deviceModel } });
    } catch (err) {
      addLog(`Switch back failed: ${(err as Error).message}`, 'ERROR');
      $('view-progress').classList.add('hidden');
      $('view-device').classList.remove('hidden');
      formError.textContent = (err as Error).message;
      formError.classList.remove('hidden');
    } finally {
      btn.disabled = false;
    }
  });

  // Done button
  $('btn-done').addEventListener('click', () => {
    $('view-success').classList.add('hidden');
    $('view-connect').classList.remove('hidden');
  });
</script>
