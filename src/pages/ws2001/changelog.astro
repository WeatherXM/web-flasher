---
import SiteLayout from '../../layouts/SiteLayout.astro';
import manifest from '../../../public/firmware/ws2001/manifest.json';
import { WS2001_CHANGELOG } from '../../lib/ble/ws2001Changelog';

// Default / opt-in comes from the published manifest (latest, latest_pinned), so it follows every publish
const latestFw = manifest.releases.find((r) => r.version === manifest.latest)?.fw_version ?? 0;
const published = new Map(manifest.releases.map((r) => [r.version, r]));
function status(version: string): { label: string; tone: string } {
  const r = published.get(version);
  if (!r) return { label: 'Earlier release', tone: 'bg-wxm-midnight/70 border-wxm-cloud/20 text-wxm-mist' };
  if (r.version === manifest.latest) return { label: 'Default release', tone: 'bg-wxm-live/15 border-wxm-live/50 text-wxm-live' };
  if (r.fw_version > latestFw) return { label: 'Preview · opt-in', tone: 'bg-amber-500/10 border-amber-400/40 text-amber-200' };
  return { label: 'Available', tone: 'bg-wxm-midnight/70 border-wxm-cloud/20 text-wxm-cloud' };
}
const anchor = (version: string) => `v${version.replace('.', '-')}`;
const formatDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// V4.10 against V5.1, the two releases the web flasher offers today
const compare: [string, string, string][] = [
  ['Status', status('4.10').label, status('5.1').label],
  ['Open Edition uplink (FPort 99)', '16 bytes', '20 bytes'],
  ['Wind direction', 'Mean direction', 'Mean direction, spread (σθ), range, gust direction'],
  ['Payload decoder', 'Any WS2001 decoder from V4.9 on', 'The latest decoder (reads both frames)'],
  ['Airtime at SF7', '67 ms, about 19 s a day at 5 min', '72 ms, about 21 s a day at 5 min'],
  ['WeatherXM network frame', '24 bytes', '24 bytes, unchanged'],
];
---

<SiteLayout
  title="WS2001 (H2) Firmware Changelog — WeatherXM"
  description="Release notes for the WeatherXM WS2001 (H2) station firmware: what changed in each version, and V4.10 compared with V5.1."
  device="ws2001"
>
  <section class="max-w-4xl mx-auto px-4 sm:px-8 space-y-6">
    <div class="space-y-3">
      <a href="/ws2001" class="inline-flex items-center gap-1.5 text-xs font-semibold text-wxm-zenith hover:text-white">
        <span aria-hidden="true">&larr;</span> WS2001 (H2) configurator
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">WS2001 (H2) firmware changelog</h1>
      <p class="text-sm text-wxm-mist leading-relaxed">
        When a station with an older version connects, the configurator installs the <strong class="text-white">default release</strong>
        (if automatic updates are on). Newer <strong class="text-white">preview</strong> releases are opt-in: connect to the station and pick
        them under <strong class="text-white">Other versions</strong> in the firmware panel. Every update keeps the station's settings, both
        network profiles and the rain total.
      </p>
    </div>

    <div class="rounded-card border border-wxm-cloud/15 bg-wxm-storm/25 backdrop-blur-md shadow-card p-5 space-y-3">
      <h2 class="text-lg font-bold text-white">V4.10 and V5.1 at a glance</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead>
            <tr class="border-b border-wxm-cloud/15 text-wxm-cloud">
              <th class="py-2 pr-4 font-semibold"></th>
              <th class="py-2 pr-4 font-semibold"><a href={`#${anchor('4.10')}`} class="hover:text-white">V4.10</a></th>
              <th class="py-2 font-semibold"><a href={`#${anchor('5.1')}`} class="hover:text-white">V5.1</a></th>
            </tr>
          </thead>
          <tbody>
            {compare.map(([row, a, b]) => (
              <tr class="border-b border-wxm-cloud/10 last:border-0 align-top">
                <th scope="row" class="py-2 pr-4 font-semibold text-wxm-cloud whitespace-nowrap">{row}</th>
                <td class="py-2 pr-4 text-wxm-mist">{a}</td>
                <td class="py-2 text-white">{b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[11px] text-wxm-mist leading-relaxed">
        <strong class="text-white">Upload interval.</strong> Both frames stay within the EU868 legal duty cycle (1 % per
        sub-band) at a 3-minute interval at every spreading factor, and the station enforces it. On The Things Network the
        fair-use limit of 30 s of airtime a day is stricter: keep 5 minutes or more at SF7, and longer at slower spreading
        factors (about 6 min at SF8, 11–12 min at SF9, 20–22 min at SF10). Private servers such as ChirpStack only have
        the duty cycle limit.
      </p>
    </div>

    {WS2001_CHANGELOG.map((e) => {
      const s = status(e.version);
      return (
        <article id={anchor(e.version)} class="rounded-card border border-wxm-cloud/15 bg-wxm-midnight/60 p-5 space-y-3 scroll-mt-24">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-xl font-bold text-white">V{e.version}</h2>
            <span class={`px-2.5 py-0.5 text-[11px] font-semibold rounded-full border whitespace-nowrap ${s.tone}`}>{s.label}</span>
            <span class="text-xs text-wxm-mist">{formatDate(e.date)}</span>
          </div>
          <p class="text-sm text-white leading-relaxed">{e.summary}</p>
          {e.upgradeNote && (
            <p class="p-3 rounded-control bg-amber-500/10 border border-amber-400/40 text-xs text-amber-200 leading-relaxed">
              <strong class="font-semibold">Before you install:</strong> {e.upgradeNote}{' '}
              <a href="/decoders/ws2001_uplink_decoder.js" download="ws2001_uplink_decoder.js" class="underline underline-offset-2 hover:text-white">Download the decoder</a>.
            </p>
          )}
          <ul class="space-y-2">
            {e.changes.map((c) => (
              <li class="text-xs text-wxm-mist leading-relaxed">
                <strong class="text-white font-semibold">{c.title}.</strong> {c.detail}
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </section>
</SiteLayout>
