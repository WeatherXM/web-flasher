---
import SiteLayout from '../layouts/SiteLayout.astro';
import wg1200Manifest from '../../public/firmware/manifest.json';
import ws1300Manifest from '../../public/firmware/ws1300/manifest.json';

const wg1200Version = wg1200Manifest.firmwares.weatherxm.version;
const ws1300Latest = ws1300Manifest.releases.find((r) => r.version === ws1300Manifest.latest) ?? ws1300Manifest.releases[0];
---

<SiteLayout
  title="WeatherXM Firmware Flasher — WG1200 & WS1300"
  description="Update or switch the firmware on your WeatherXM WG1200 gateway over USB, or your WS1300 weather station over Bluetooth, right from the browser."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-8">
    <div class="max-w-2xl space-y-3 mb-8 lg:mb-10">
      <span class="text-[11px] font-bold text-wxm-zenith uppercase tracking-wider">WeatherXM firmware flasher</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight text-balance">Which device are you updating?</h1>
      <p class="text-sm sm:text-base text-wxm-mist leading-relaxed">
        Everything runs in your browser. Pick the device and we'll walk you through connecting it. The model name is on the label on the back.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href="/wg1200"
        data-device="wg1200"
        class="device-card group rounded-card border-2 border-wxm-cloud/15 bg-wxm-storm/30 backdrop-blur-md shadow-card p-6 flex flex-col gap-5 transition-all hover:border-wxm-beacon hover:bg-wxm-storm/50 focus-visible:outline-none focus-visible:border-wxm-zenith focus-visible:ring-2 focus-visible:ring-wxm-zenith/60"
      >
        <div class="h-40 rounded-control bg-wxm-abyss/60 border border-wxm-cloud/10 flex items-center justify-center overflow-hidden">
          <img
            src="/wg1200-front.webp"
            alt="WeatherXM WG1200 gateway"
            class="h-32 w-auto drop-shadow-[0_12px_24px_rgba(0,0,0,0.6)] transition-transform group-hover:scale-105"
          />
        </div>
        <div class="space-y-2 flex-1">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <h2 class="text-xl font-bold">WG1200 Gateway</h2>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold px-2.5 py-1 rounded-full bg-wxm-midnight/80 border border-wxm-cloud/20 text-wxm-cloud">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v4m6-4v4M7 7h10v5a5 5 0 01-10 0V7zm5 10v4" /></svg>
              USB-C cable
            </span>
          </div>
          <p class="text-sm text-wxm-mist leading-relaxed">
            The gateway with the display that links your station to the internet. Switch between WeatherXM tri-protocol (v{wg1200Version}) and full Meshtastic firmware.
          </p>
        </div>
        <div class="flex items-center justify-between gap-3 pt-4 border-t border-wxm-cloud/10">
          <span class="support text-xs text-wxm-mist" data-needs="serial">Needs Chrome or Edge on a computer</span>
          <span class="text-sm font-bold text-wxm-zenith group-hover:text-white inline-flex items-center gap-1 whitespace-nowrap">
            Continue
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </span>
        </div>
      </a>

      <a
        href="/ws1300"
        data-device="ws1300"
        class="device-card group rounded-card border-2 border-wxm-cloud/15 bg-wxm-storm/30 backdrop-blur-md shadow-card p-6 flex flex-col gap-5 transition-all hover:border-wxm-beacon hover:bg-wxm-storm/50 focus-visible:outline-none focus-visible:border-wxm-zenith focus-visible:ring-2 focus-visible:ring-wxm-zenith/60"
      >
        <div class="h-40 rounded-control bg-wxm-abyss/60 border border-wxm-cloud/10 flex items-center justify-center overflow-hidden">
          <img
            src="/ws1300-angle.webp"
            alt="WeatherXM WS1300 weather station"
            width="400"
            height="184"
            class="w-[85%] max-w-[300px] h-auto drop-shadow-[0_12px_24px_rgba(0,0,0,0.6)] transition-transform group-hover:scale-105"
          />
        </div>
        <div class="space-y-2 flex-1">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <h2 class="text-xl font-bold">WS1300 Weather Station</h2>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold px-2.5 py-1 rounded-full bg-wxm-beacon/15 border border-wxm-beacon/40 text-wxm-wash">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7l10 10-5 5V2l5 5L7 17" /></svg>
              Bluetooth
            </span>
          </div>
          <p class="text-sm text-wxm-mist leading-relaxed">
            The outdoor station with the weather sensors. Update it to the latest firmware ({ws1300Latest.label}) wirelessly, from a laptop or an Android phone next to it.
          </p>
        </div>
        <div class="flex items-center justify-between gap-3 pt-4 border-t border-wxm-cloud/10">
          <span class="support text-xs text-wxm-mist" data-needs="bluetooth">Needs Chrome or Edge (Android works too)</span>
          <span class="text-sm font-bold text-wxm-zenith group-hover:text-white inline-flex items-center gap-1 whitespace-nowrap">
            Continue
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </span>
        </div>
      </a>
    </div>

    <p class="mt-8 text-xs text-wxm-mist max-w-2xl leading-relaxed">
      Neither flow touches device identity or WeatherXM credentials. The WG1200 keeps its factory recovery image, and the WS1300 falls back to its previous firmware if a new one fails to start.
    </p>
  </section>
</SiteLayout>

<script>
  // Tell the visitor up front whether this browser can do each flow
  const support: Record<string, boolean> = {
    serial: 'serial' in navigator,
    bluetooth: 'bluetooth' in navigator,
  };
  document.querySelectorAll<HTMLElement>('.support').forEach((el) => {
    const ok = support[el.dataset.needs ?? ''];
    const icon = ok
      ? '<svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1 text-wxm-live" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>'
      : '<svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v4m0 4h.01"/></svg>';
    el.innerHTML = icon + (ok ? 'Works in this browser' : el.textContent ?? '');
    el.classList.toggle('text-wxm-cloud', ok);
  });
</script>
