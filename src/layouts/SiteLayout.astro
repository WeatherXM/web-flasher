---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  device?: 'wg1200' | 'ws1300' | 'ws2001' | 'h1-h2';
  noindex?: boolean;
}

const { title, description, device, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://flasher.weatherxm.com').href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description,
  url: canonicalUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  publisher: {
    '@type': 'Organization',
    name: 'WeatherXM',
    url: 'https://weatherxm.com'
  }
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/logomark-color.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WeatherXM Firmware Flasher" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MYSF8H1VYT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MYSF8H1VYT');
    </script>
  </head>

  <body class="min-h-screen bg-dark-atmospheric bg-dot-grid text-white font-sans antialiased flex flex-col justify-between selection:bg-wxm-beacon selection:text-white">
    <div class="relative z-10 flex-1 flex flex-col">
      <Header device={device} />
      <main class="flex-1 py-6 lg:py-10">
        <slot />
      </main>
      <Footer />
    </div>
    <slot name="after" />
  </body>
</html>
