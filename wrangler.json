{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weatherxm-web-flasher",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "flash.weatherxm.com",
      "custom_domain": true
    },
    {
      "pattern": "flasher.weatherxm.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
